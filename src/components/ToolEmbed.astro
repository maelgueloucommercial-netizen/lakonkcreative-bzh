---
/**
 * ToolEmbed — met l'outil central d'un site tool_utility en avant sur la home.
 * v1 « link » : grand bloc hero CTA vers /outils/<slug>/ (l'embed iframe est une
 * itération ultérieure). Masqué si pas d'outil. Réutilise les classes de skin.
 */
interface Tool { slug: string; label: string; emoji?: string; description?: string; href?: string; }
interface Props { tool?: Tool; }
const { tool } = Astro.props as Props;
const href = tool ? (tool.href ?? `/outils/${tool.slug}/`) : null;
---
{tool && href && (
  <section style="padding:96px 0;background:var(--color-bg-card);border-bottom:1px solid var(--color-border)">
    <div class="site-container">
      <div class="te-card">
        <div class="te-ico" aria-hidden="true">{tool.emoji ?? '🛠'}</div>
        <span class="hp-pill">L'outil</span>
        <h2 class="serif" style="font-size:clamp(36px,5vw,64px);line-height:1.04;font-weight:400;letter-spacing:-.5px;margin:14px 0 16px">
          {tool.label.split(' ')[0]} <em style="font-style:italic">{tool.label.split(' ').slice(1).join(' ')}</em>
        </h2>
        {tool.description && <p class="te-desc">{tool.description}</p>}
        <a href={href} class="te-cta">Ouvrir l'outil →</a>
      </div>
    </div>
  </section>
)}

<style>
  .te-card { max-width: 760px; margin: 0 auto; text-align: center; }
  .te-ico { font-size: 56px; line-height: 1; margin-bottom: 18px; }
  .te-desc { font-size: 17px; color: var(--color-text-muted); line-height: 1.65; max-width: 540px; margin: 0 auto 28px; }
  .te-cta { display: inline-block; background: var(--color-ink); color: var(--color-bg-base); padding: 15px 30px; font-size: 14px; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; text-decoration: none; border-radius: 999px; transition: filter .15s; }
  .te-cta:hover { filter: brightness(1.1); }
</style>
