---
/**
 * Formulaire d'inscription newsletter (item #55 roadmap).
 *
 * Affichage minimaliste, intégrable en footer ou en CTA in-article. Honeypot
 * anti-bot via champ `website` caché. POST sur /api/newsletter (worker
 * handler).
 */

interface Props {
  /** Variante : compact (footer) ou large (in-article CTA) */
  variant?: 'compact' | 'large';
  title?: string;
  hint?: string;
}

const {
  variant = 'compact',
  title = 'Recevoir l\'encyclopédie par email',
  hint = 'Une newsletter mensuelle, jamais de spam, désabonnement en un clic.',
} = Astro.props;
---
{variant === 'compact' ? (
  <form action="/api/newsletter" method="POST" class="not-prose flex flex-wrap items-end gap-2" data-pagefind-ignore>
    <label class="flex-1 min-w-[220px]">
      <span class="block text-xs text-cream-200/70 mb-1">{title}</span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="vous@email.com"
        class="w-full rounded-md border border-cream-200/30 bg-ink-700/50 px-3 py-2 text-sm text-cream-50 placeholder:text-cream-200/40 focus:outline-none focus:border-terra-300"
      />
    </label>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute left-[-9999px]" aria-hidden="true" />
    <button type="submit" class="rounded-md bg-terra-600 hover:bg-terra-700 text-cream-50 text-sm px-4 py-2">S'abonner</button>
  </form>
) : (
  <aside class="not-prose mt-12 rounded-lg border border-terra-300 bg-terra-50 p-6 sm:p-8" data-pagefind-ignore>
    <p class="text-xs uppercase tracking-widest text-terra-700 mb-2">Newsletter</p>
    <h2 class="font-serif text-2xl text-ink-900 mb-2">{title}</h2>
    <p class="text-sm text-ink-700 mb-4">{hint}</p>
    <form action="/api/newsletter" method="POST" class="flex flex-wrap items-stretch gap-2">
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="vous@email.com"
        class="flex-1 min-w-[200px] rounded-md border border-cream-200 bg-white px-3 py-2 text-sm focus:outline-none focus:border-terra-500"
      />
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute left-[-9999px]" aria-hidden="true" />
      <button type="submit" class="rounded-md bg-terra-600 hover:bg-terra-700 text-cream-50 text-sm px-5 py-2 whitespace-nowrap">S'abonner</button>
    </form>
    <p class="text-xs text-ink-700/60 mt-3">Vos données ne seront jamais cédées à un tiers. Désabonnement en un clic.</p>
  </aside>
)}
