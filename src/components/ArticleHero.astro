---
/**
 * ArticleHero — placeholder visuel pour articles sans heroImage.
 * Utilise des motifs SVG décoratifs selon archetype + couleur primaire site.
 *
 * - village → motif organique (arbres / collines stylisés)
 * - bricolage → motif géométrique (engrenage / outils)
 * - tech → motif circuits / pixels
 * - adulte → motif sensuel (ondulations / pétales)
 */
import { SITE_CONFIG } from '../lib/site-config';

interface Props {
  title: string;
  emoji?: string;
  variant?: 'card' | 'hero';
}

const { title, emoji, variant = 'card' } = Astro.props as Props;
const archetype = SITE_CONFIG.theme.archetype;

// Génère une teinte en hash du titre pour variation
function hashCode(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}
const hue = hashCode(title) % 360;
---
<div class={`relative w-full ${variant === 'card' ? 'aspect-video' : 'aspect-[2/1]'} overflow-hidden flex items-center justify-center text-white`}
     style={`background: linear-gradient(135deg, var(--color-primary) 0%, hsl(${hue}, 30%, 30%) 100%);`}>

  {/* Motif SVG décoratif selon archetype */}
  {archetype === 'village' && (
    <svg class="absolute inset-0 w-full h-full opacity-20" viewBox="0 0 200 100" preserveAspectRatio="xMidYMid slice">
      <path d="M0,80 Q30,60 60,75 T120,70 Q150,68 200,75 L200,100 L0,100 Z" fill="currentColor"/>
      <circle cx="40" cy="30" r="4" fill="currentColor" opacity="0.3"/>
      <circle cx="160" cy="20" r="3" fill="currentColor" opacity="0.3"/>
      <circle cx="100" cy="35" r="2" fill="currentColor" opacity="0.4"/>
      <path d="M30,80 L35,55 L40,80 Z M50,80 L55,50 L60,80 Z M150,80 L155,53 L160,80 Z" fill="currentColor" opacity="0.4"/>
    </svg>
  )}

  {archetype === 'bricolage' && (
    <svg class="absolute inset-0 w-full h-full opacity-15" viewBox="0 0 200 100" preserveAspectRatio="xMidYMid slice">
      <pattern id={`grid-${hue}`} width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5"/>
      </pattern>
      <rect width="100%" height="100%" fill={`url(#grid-${hue})`}/>
      <circle cx="160" cy="30" r="20" fill="none" stroke="currentColor" stroke-width="2" opacity="0.4"/>
      <circle cx="160" cy="30" r="10" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
      <circle cx="160" cy="30" r="3" fill="currentColor" opacity="0.5"/>
    </svg>
  )}

  {archetype === 'tech' && (
    <svg class="absolute inset-0 w-full h-full opacity-15" viewBox="0 0 200 100" preserveAspectRatio="xMidYMid slice">
      <path d="M0,50 L30,50 L40,40 L60,40 L70,50 L100,50 L110,60 L130,60 L140,50 L200,50" fill="none" stroke="currentColor" stroke-width="1"/>
      <path d="M0,30 L20,30 L25,20 L40,20 L45,30 L80,30 L85,40 L120,40 L125,30 L200,30" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.6"/>
      <circle cx="40" cy="40" r="2" fill="currentColor"/>
      <circle cx="100" cy="50" r="2" fill="currentColor"/>
      <circle cx="140" cy="50" r="2" fill="currentColor"/>
      <circle cx="20" cy="30" r="1.5" fill="currentColor"/>
      <circle cx="80" cy="30" r="1.5" fill="currentColor"/>
    </svg>
  )}

  {archetype === 'adulte' && (
    <svg class="absolute inset-0 w-full h-full opacity-25" viewBox="0 0 200 100" preserveAspectRatio="xMidYMid slice">
      <path d="M0,50 Q30,30 60,50 T120,50 T180,50 L200,50 L200,100 L0,100 Z" fill="currentColor" opacity="0.3"/>
      <path d="M0,70 Q40,60 80,70 T160,70 L200,70 L200,100 L0,100 Z" fill="currentColor" opacity="0.4"/>
      <ellipse cx="160" cy="30" rx="25" ry="18" fill="currentColor" opacity="0.25" transform="rotate(15 160 30)"/>
      <ellipse cx="40" cy="25" rx="15" ry="10" fill="currentColor" opacity="0.2" transform="rotate(-20 40 25)"/>
    </svg>
  )}

  {/* Title overlay */}
  <div class="relative z-10 text-center px-4 py-2">
    {emoji && <div class="text-5xl md:text-6xl mb-2 opacity-90">{emoji}</div>}
    <div class="font-bold text-sm md:text-base leading-tight line-clamp-3 max-w-xs mx-auto" style="font-family: var(--font-heading, ui-serif); text-shadow: 0 2px 8px rgba(0,0,0,0.3);">
      {title}
    </div>
  </div>
</div>
