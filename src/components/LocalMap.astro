---
/**
 * Carte Leaflet OpenStreetMap pour pages avec intent local.
 * Lazy load Leaflet via CDN au scroll (IntersectionObserver).
 * Émis automatiquement par Article.astro si SITE_CONFIG.profile.geo existe ET
 * l'article a une orientation local (frontmatter `local: true` ou détecté via title).
 *
 * Props :
 *   - lat, lng : coordonnées WGS84
 *   - placename : nom du lieu affiché dans le popup
 *   - region : code région (FR-XX) — optionnel, affiché dans le popup
 *   - height : hauteur CSS (défaut 320px)
 */
const { lat, lng, placename, region, height } = Astro.props as {
  lat: number; lng: number; placename: string; region?: string; height?: string;
};
const h = height ?? '320px';
const mapId = `localmap-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="local-map-section" style={`margin:32px 0;padding:0`}>
  <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(20px,2.4vw,28px);margin-bottom:12px;font-weight:500;color:var(--color-ink)">
    📍 Localisation — {placename}
  </h2>
  <div id={mapId}
       data-lat={lat} data-lng={lng} data-name={placename}
       style={`width:100%;height:${h};border:1px solid var(--color-border);border-radius:4px;background:#f0f4f8;font-size:13px;color:#666`}
       aria-label={`Carte de ${placename}`}>
    <noscript>
      <a href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}&zoom=14`} target="_blank" rel="noopener" style="display:block;padding:16px;text-decoration:underline">
        Voir {placename} sur OpenStreetMap →
      </a>
    </noscript>
  </div>
  <p style="font-size:13px;color:var(--color-text-muted);margin-top:8px">
    {placename}{region ? ` — ${region}` : ''} (lat {lat.toFixed(4)}, lng {lng.toFixed(4)})
  </p>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline define:vars={{ mapId, lat, lng, placename }}>
  (function () {
    const el = document.getElementById(mapId);
    if (!el) return;
    let loaded = false;
    function loadMap() {
      if (loaded) return; loaded = true;
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      s.crossOrigin = '';
      s.onload = () => {
        const map = window.L.map(mapId).setView([lat, lng], 13);
        window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19, attribution: '© OpenStreetMap',
        }).addTo(map);
        window.L.marker([lat, lng]).addTo(map).bindPopup(placename).openPopup();
      };
      document.head.appendChild(s);
    }
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { loadMap(); obs.disconnect(); }
      }, { rootMargin: '200px' });
      obs.observe(el);
    } else { loadMap(); }
  })();
</script>
