---
/**
 * FAQBlock — accordion de questions/réponses + JSON-LD FAQPage.
 * Auto-extrait les FAQ depuis le HTML rendu OU prend une prop explicite.
 */
interface FaqPair {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FaqPair[];
  html?: string;        // HTML rendu pour parser les FAQ auto
  injectSchema?: boolean;
}

const { faqs: passedFaqs, html, injectSchema = true } = Astro.props;

let faqs: FaqPair[] = passedFaqs ?? [];

// Extract FAQs from HTML : pattern <h3>Question?</h3><p>Reponse</p>
if (!passedFaqs && html) {
  const faqSectionM = html.match(/(?:FAQ|Questions[\s-]+(?:fr[ée]quentes|courantes))[\s\S]+/i);
  if (faqSectionM) {
    const section = faqSectionM[0];
    const re = /<h3[^>]*>([\s\S]*?)<\/h3>\s*<p[^>]*>([\s\S]*?)<\/p>/gi;
    let m;
    while ((m = re.exec(section))) {
      const q = m[1].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
      const a = m[2].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
      if (q && a && q.length < 200 && a.length > 10) {
        faqs.push({ question: q, answer: a });
      }
    }
  }
}

const schema = injectSchema && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;
---
{faqs.length > 0 && (
  <section class="faq-block not-prose" style="margin:64px 0" aria-labelledby="faq-heading">
    <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-accent);margin-bottom:18px;font-weight:600">FAQ</div>
    <h2 id="faq-heading" class="serif" style="font-size:clamp(28px, 3.2vw, 40px);line-height:1.1;font-weight:400;letter-spacing:-.5px;margin:0 0 36px;color:var(--color-ink)">
      Questions <em style="font-style:italic">fréquentes</em>.
    </h2>
    <div style="border-top:1px solid var(--color-border)">
      {faqs.map((f) => (
        <details style="border-bottom:1px solid var(--color-border)">
          <summary style="cursor:pointer;padding:22px 0;font-family:'Cormorant Garamond',serif;font-size:22px;line-height:1.25;font-weight:400;letter-spacing:-.3px;color:var(--color-ink);list-style:none;display:flex;align-items:flex-start;justify-content:space-between;gap:18px">
            <span style="flex:1">{f.question}</span>
            <svg style="width:20px;height:20px;flex-shrink:0;color:var(--color-accent);margin-top:6px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div style="padding:0 0 22px;font-size:16px;line-height:1.7;color:var(--color-text-muted)">
            {f.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
