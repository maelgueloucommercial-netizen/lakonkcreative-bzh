---
/**
 * Bloc FAQ + schema FAQPage (item #38 roadmap).
 *
 * Crée un schema `FAQPage` JSON-LD éligible aux **rich snippets** Google
 * (boîtes "People also ask" / "Questions fréquentes" en SERP). Pour que
 * Google retienne le snippet, il faut que les questions/réponses figurent
 * **aussi** visiblement dans le HTML — d'où le rendu visible du bloc.
 *
 * Bonnes pratiques Google :
 *   - 3-10 questions
 *   - Chaque réponse < 300 caractères, en texte brut (pas de listes
 *     imbriquées dans le rich snippet)
 *   - Questions vraiment posées par les utilisateurs (pas inventées)
 *   - Pas de promotion ni de liens d'affiliation dans les réponses
 */

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = 'Questions fréquentes' } = Astro.props;

const faqSchema = items.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: it.answer,
    },
  })),
} : null;
---
{items.length > 0 && (
  <>
    <section class="not-prose mt-12 border-t border-cream-200 pt-8" aria-labelledby="faq-title">
      <h2 id="faq-title" class="font-serif text-2xl text-ink-900 mb-6">{title}</h2>
      <div class="space-y-4">
        {items.map((it) => (
          <details class="group rounded-lg border border-cream-200 bg-white p-5 open:border-terra-300">
            <summary class="cursor-pointer list-none font-serif text-lg text-ink-900 flex items-start justify-between gap-4">
              <span>{it.question}</span>
              <span class="flex-shrink-0 mt-1 text-terra-600 text-sm transition-transform group-open:rotate-45 select-none">+</span>
            </summary>
            <p class="mt-3 text-ink-700 leading-relaxed">{it.answer}</p>
          </details>
        ))}
      </div>
    </section>
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </>
)}
