---
/**
 * Reading progress bar — barre fine en haut de l'écran (item #51 roadmap).
 *
 * Calcule la progression scroll dans l'élément cible (par défaut <article>)
 * et met à jour la largeur d'une barre fixe top:0. Pas de framework, pure
 * vanilla, ~30 lignes.
 *
 * Pourquoi : signal d'engagement UX subtil mais efficace, surtout sur les
 * articles longs (>10 min). Sert aussi à signaler à l'utilisateur la
 * longueur restante du contenu.
 */
---
<div
  id="reading-progress"
  class="fixed top-0 left-0 h-0.5 bg-terra-600 z-50 transition-[width] duration-150 ease-out"
  style="width: 0%"
  aria-hidden="true"
></div>
<script is:inline>
  (function () {
    const bar = document.getElementById('reading-progress');
    const article = document.querySelector('article');
    if (!bar || !article) return;

    function update() {
      const rect = article.getBoundingClientRect();
      const articleHeight = rect.height;
      const viewportHeight = window.innerHeight;
      // Distance scrollée à l'intérieur de l'article (clamp 0..articleHeight)
      const scrolled = Math.max(0, -rect.top);
      const total = Math.max(1, articleHeight - viewportHeight);
      const pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    }

    let scheduled = false;
    function onScroll() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        update();
      });
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>
