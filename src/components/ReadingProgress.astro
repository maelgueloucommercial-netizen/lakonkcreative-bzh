---
/**
 * ReadingProgress — barre de progression de lecture en haut de page.
 * Visible uniquement sur les pages article (data-article).
 */
---
<div id="reading-progress" style="position:fixed;top:0;left:0;right:0;height:2px;background:transparent;z-index:60;pointer-events:none">
  <div id="reading-progress-bar" style="height:100%;width:0%;background:var(--color-accent);transition:width .15s ease-out"></div>
</div>
<script is:inline>
  (function() {
    const article = document.querySelector('article.prose-article, [data-article]');
    if (!article) {
      document.getElementById('reading-progress')?.remove();
      return;
    }
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;
    function update() {
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight;
      const winH = window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const visible = Math.max(0, Math.min(total, winH));
      const progress = Math.min(100, (scrolled / Math.max(1, total - winH)) * 100);
      bar.style.width = Math.max(0, Math.min(100, progress)) + '%';
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
</script>
