---
import { SITE, PILLARS } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="border-b border-cream-200 bg-cream-50 sticky top-0 z-30 backdrop-blur supports-[backdrop-filter]:bg-cream-50/85">
  <div class="mx-auto max-w-7xl px-6 py-4 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3">
      <span class="font-serif text-2xl font-semibold tracking-tight text-ink-900">{SITE.name}</span>
      <span class="hidden sm:block text-xs text-olive-700 italic uppercase tracking-widest">authentique</span>
    </a>

    <nav class="hidden lg:flex items-center gap-8 text-sm">
      {PILLARS.map((p) => (
        <a
          href={p.href}
          class:list={[
            'hover:text-terra-700 transition',
            isActive(p.href) ? 'text-terra-700 font-medium' : 'text-ink-700',
          ]}
        >{p.label}</a>
      ))}
      <a href="/blog" class:list={['hover:text-terra-700 transition', isActive('/blog') ? 'text-terra-700 font-medium' : 'text-ink-700']}>Articles</a>
      <a href="/a-propos" class:list={['hover:text-terra-700 transition', isActive('/a-propos') ? 'text-terra-700 font-medium' : 'text-ink-700']}>À propos</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/recherche" aria-label="Rechercher" class="text-ink-700 hover:text-terra-700 transition" title="Rechercher dans l'encyclopédie">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </a>
      <a href="/devis" class="btn-primary text-xs sm:text-sm whitespace-nowrap">Demander un devis</a>
    </div>
  </div>
</header>
