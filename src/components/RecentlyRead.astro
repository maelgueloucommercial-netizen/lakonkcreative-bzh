---
/**
 * RecentlyRead — derniers articles publiés (5 par défaut).
 * Utilisé dans Footer + sidebar éventuellement.
 * Note : "récemment lus" client-side via localStorage en plus.
 */
import { getCollection } from 'astro:content';
import { articleUrl } from '../lib/article-url';

interface Props {
  count?: number;
  excludeSlug?: string;
  variant?: 'list' | 'cards';
}

const { count = 5, excludeSlug, variant = 'list' } = Astro.props;
const all = await getCollection('articles');
const recent = all
  .filter((a) => a.data.slug !== excludeSlug)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, count);

function getUrl(d: typeof recent[0]['data']): string {
    return articleUrl(d);
}
---
{variant === 'list' ? (
  <ul style="list-style:none;padding:0;margin:0;border-top:1px solid var(--color-border)">
    {recent.map((entry) => (
      <li style="border-bottom:1px solid var(--color-border)">
        <a href={getUrl(entry.data)} style="display:grid;grid-template-columns:1fr auto;gap:14px;align-items:baseline;padding:14px 0;text-decoration:none;color:inherit">
          <span class="serif" style="font-size:16px;line-height:1.35;font-weight:400;letter-spacing:-.2px;color:var(--color-ink)">{entry.data.title.length > 70 ? entry.data.title.slice(0, 70) + '…' : entry.data.title}</span>
          <time style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--color-text-muted);font-weight:600;white-space:nowrap">
            {entry.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
          </time>
        </a>
      </li>
    ))}
  </ul>
) : (
  <div style="display:grid;grid-template-columns:repeat(5, 1fr);gap:0;border-top:1px solid var(--color-border);border-left:1px solid var(--color-border)" class="recent-grid">
    {recent.map((entry) => (
      <a href={getUrl(entry.data)} style="display:flex;flex-direction:column;padding:24px;border-right:1px solid var(--color-border);border-bottom:1px solid var(--color-border);background:var(--color-bg-card);text-decoration:none;color:inherit">
        <div style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:14px;font-weight:600">
          {entry.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
        </div>
        <div class="serif" style="font-family:'Cormorant Garamond',serif;font-size:18px;line-height:1.25;font-weight:400;letter-spacing:-.2px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;color:var(--color-ink)">{entry.data.title}</div>
      </a>
    ))}
  </div>
)}
<style>
@media (max-width: 900px) { .recent-grid { grid-template-columns: 1fr 1fr !important; } }
@media (max-width: 600px) { .recent-grid { grid-template-columns: 1fr !important; } }
</style>
