---
/**
 * Sprint 10 — Adaptive CTA selon intent + archetype.
 *
 *   - info / general / definition / news → Newsletter capture
 *   - commercial (comparator / buying_guide) → Lien vers comparateur + Annoncer chez nous
 *   - transactionnel (product_review) → "Voir le test" + lien externe affilié
 *   - local_info / local_listing → Annuaire + Carte
 *   - how_to / recipe → Outils interactifs (Calculator / Quiz)
 */
import type { SearchIntent } from '../lib/intent-classifier';
import { SITE_CONFIG } from '../lib/site-config';

interface Props {
  intent: SearchIntent;
}
const { intent } = Astro.props as Props;
const archetype = SITE_CONFIG.theme.archetype;

interface Cta { title: string; desc: string; primaryHref: string; primaryLabel: string; secondaryHref?: string; secondaryLabel?: string; emoji: string; }

function buildCta(): Cta {
  switch (intent) {
    case 'comparator':
    case 'buying_guide':
      return {
        emoji: '⚖️',
        title: 'Comparez plusieurs produits côte à côte',
        desc: 'Notre comparateur interactif vous permet de sélectionner jusqu\'à 4 produits et d\'identifier en un clin d\'œil le meilleur sur chaque critère.',
        primaryHref: '/outils/comparateur/',
        primaryLabel: 'Ouvrir le comparateur',
        secondaryHref: '/comparatifs/',
        secondaryLabel: 'Tous les comparatifs',
      };

    case 'product_review':
      return {
        emoji: '⭐',
        title: 'Vous voulez voir d\'autres avis ?',
        desc: 'Consultez nos autres tests indépendants pour faire le tri entre les produits et choisir en connaissance de cause.',
        primaryHref: '/avis/',
        primaryLabel: 'Tous les avis',
        secondaryHref: '/outils/comparateur/',
        secondaryLabel: 'Comparer plusieurs produits',
      };

    case 'how_to':
    case 'recipe':
      return {
        emoji: '🛠️',
        title: 'Calculez ce qu\'il vous faut',
        desc: 'Utilisez notre calculateur interactif pour estimer rapidement les quantités, dimensions ou volumes nécessaires à votre projet.',
        primaryHref: '/outils/calculateur/',
        primaryLabel: 'Ouvrir le calculateur',
        secondaryHref: '/articles/',
        secondaryLabel: 'Voir d\'autres guides',
      };

    case 'local_info':
    case 'local_listing':
      return {
        emoji: '🗺️',
        title: 'Explorez la région autrement',
        desc: archetype === 'village'
          ? 'Consultez la météo locale en direct, retrouvez tous les commerces sur la carte et l\'annuaire complet de la commune.'
          : 'Notre annuaire et notre carte recensent les principaux points d\'intérêt à explorer.',
        primaryHref: '/annuaire/',
        primaryLabel: 'Voir l\'annuaire',
        secondaryHref: '/outils/carte/',
        secondaryLabel: 'Ouvrir la carte',
      };

    case 'definition':
      return {
        emoji: '📖',
        title: 'Approfondir le sujet',
        desc: 'Consultez notre glossaire pour les définitions des termes liés, ou parcourez tous nos articles sur cette thématique.',
        primaryHref: '/glossaire/',
        primaryLabel: 'Ouvrir le glossaire',
        secondaryHref: '/articles/',
        secondaryLabel: 'Tous les articles',
      };

    case 'news':
      return {
        emoji: '📰',
        title: 'Restez informé',
        desc: 'Inscrivez-vous à notre newsletter pour recevoir nos derniers articles directement par email.',
        primaryHref: '#newsletter',
        primaryLabel: 'M\'inscrire à la newsletter',
        secondaryHref: '/articles/',
        secondaryLabel: 'Tous les articles',
      };

    default:
      return {
        emoji: '✉️',
        title: 'Recevez nos prochains articles',
        desc: 'Inscrivez-vous à notre newsletter pour recevoir une sélection de nos contenus, sans spam, désinscription en 1 clic.',
        primaryHref: '#newsletter',
        primaryLabel: 'M\'inscrire',
        secondaryHref: '/articles/',
        secondaryLabel: 'Voir tous les articles',
      };
  }
}

const cta = buildCta();
---
<aside class="adaptive-cta not-prose" style="margin:48px 0;padding:40px;background:var(--color-bg-card);border-left:3px solid var(--color-accent)">
  <div style="display:flex;align-items:flex-start;gap:24px">
    <div style="font-size:36px;line-height:1;flex-shrink:0">{cta.emoji}</div>
    <div style="flex:1">
      <h3 class="serif" style="font-size:clamp(22px, 2.4vw, 28px);line-height:1.2;font-weight:400;letter-spacing:-.3px;margin:0 0 12px;color:var(--color-ink)">
        {cta.title}
      </h3>
      <p style="font-size:15px;line-height:1.7;color:var(--color-text-muted);margin:0 0 24px">
        {cta.desc}
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:14px">
        <a href={cta.primaryHref} class="btn-fill">
          {cta.primaryLabel} →
        </a>
        {cta.secondaryHref && (
          <a href={cta.secondaryHref} style="padding:14px 28px;background:transparent;border:1px solid var(--color-ink);color:var(--color-ink);font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:600;text-decoration:none">
            {cta.secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</aside>
