---
/**
 * Sprint 3.3 — CTA adapté à l'intent de recherche (item #intent-classifier).
 *
 * Lit `intent` + `cta` du frontmatter (auto-injectés par auto-publish.ts) et
 * affiche le bon CTA :
 *   - informational → newsletter (gain audience)
 *   - commercial → comparateur / demande devis
 *   - transactional → bouton achat / réservation
 *   - local → contact / itinéraire
 *   - navigational → lien vers site officiel
 *
 * Si pas d'intent fourni (pages legacy), fallback sur newsletter.
 */
import NewsletterCapture from './NewsletterCapture.astro';

interface Props {
  intent?: 'informational' | 'commercial' | 'transactional' | 'navigational' | 'local';
  cta?: { component?: string; props?: Record<string, string> };
  /** Lien transac/commerce/local optionnel (si fourni, on l'utilise) */
  href?: string;
  /** Label override */
  label?: string;
}

const { intent = 'informational', cta, href, label } = Astro.props;
const ctaLabel = label || cta?.props?.label;
---
{intent === 'informational' && (
  <NewsletterCapture variant="large" />
)}

{intent === 'commercial' && (
  <aside class="not-prose mt-12 rounded-lg border border-olive-300 bg-olive-50 p-6 sm:p-8" data-pagefind-ignore>
    <p class="text-xs uppercase tracking-widest text-olive-700 mb-2">Besoin d'aide pour choisir ?</p>
    <h2 class="font-serif text-2xl text-ink-900 mb-2">{ctaLabel || 'Comparer les options'}</h2>
    <p class="text-sm text-ink-700 mb-4">Demandez un devis sur-mesure ou consultez notre guide comparatif.</p>
    <a
      href={href || '/contact'}
      class="inline-block rounded-md bg-olive-700 hover:bg-olive-800 text-cream-50 text-sm px-5 py-2"
    >
      {ctaLabel || 'Demander un devis'}
    </a>
  </aside>
)}

{intent === 'transactional' && (
  <aside class="not-prose mt-12 rounded-lg border border-terra-400 bg-terra-50 p-6 sm:p-8" data-pagefind-ignore>
    <p class="text-xs uppercase tracking-widest text-terra-700 mb-2">Passer à l'action</p>
    <h2 class="font-serif text-2xl text-ink-900 mb-2">{ctaLabel || 'Acheter / Réserver'}</h2>
    <p class="text-sm text-ink-700 mb-4">Tarifs transparents, paiement sécurisé.</p>
    <a
      href={href || '/boutique'}
      class="inline-block rounded-md bg-terra-700 hover:bg-terra-800 text-cream-50 text-sm px-5 py-2"
    >
      {ctaLabel || 'Voir les offres'}
    </a>
  </aside>
)}

{intent === 'local' && (
  <aside class="not-prose mt-12 rounded-lg border border-cream-300 bg-cream-100 p-6 sm:p-8" data-pagefind-ignore>
    <p class="text-xs uppercase tracking-widest text-ink-700/70 mb-2">À proximité</p>
    <h2 class="font-serif text-2xl text-ink-900 mb-2">{ctaLabel || 'Trouver près de chez vous'}</h2>
    <p class="text-sm text-ink-700 mb-4">Annuaire local, horaires, itinéraire.</p>
    <a
      href={href || '/epiciers'}
      class="inline-block rounded-md bg-ink-700 hover:bg-ink-800 text-cream-50 text-sm px-5 py-2"
    >
      {ctaLabel || 'Voir l\'annuaire'}
    </a>
  </aside>
)}

{intent === 'navigational' && href && (
  <p class="not-prose mt-12 text-center">
    <a href={href} class="inline-block rounded-md border border-ink-700 px-5 py-2 text-sm text-ink-700 hover:bg-ink-700 hover:text-cream-50">
      {ctaLabel || 'Voir le site officiel'} →
    </a>
  </p>
)}
