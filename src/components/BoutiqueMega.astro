---
/**
 * Méga-menu Boutique — item de nav déroulant (vignettes catégories + rail intentions).
 * v2 (benchmark objetrama 2026-06-10) : en plus des catégories, le panneau pousse les
 * entrées par INTENTION d'achat (Bons plans / Meilleures notes) + 1 produit vedette
 * (clic direct vers la fiche money). Auto-suffisant : lit la collection `produits`
 * (le prop `cats` du Header reste accepté en fallback). Caché < 900px (menu mobile).
 */
import { getCollection } from 'astro:content';

interface Cat { slug: string; label: string; image?: string | null; count: number; }
const { cats: catsProp = [] } = Astro.props as { cats: Cat[] };

const produits = await getCollection('produits').catch(() => []);
const byCat = new Map<string, { label: string; image: string | null; count: number }>();
for (const p of produits as any[]) {
  const c = p.data.category;
  if (!byCat.has(c)) byCat.set(c, { label: p.data.categoryLabel ?? c, image: p.data.images?.[0] ?? null, count: 0 });
  const e = byCat.get(c)!;
  e.count++;
  if (!e.image && p.data.images?.[0]) e.image = p.data.images[0];
}
const cats: Cat[] = byCat.size > 0
  ? [...byCat.entries()].map(([slug, v]) => ({ slug, ...v })).sort((a, b) => b.count - a.count)
  : catsProp;

const score = (p: any) => (p.data.scoreGlobal ?? p.data.rating ?? 0) as number;
const deals = (produits as any[]).filter((p) => typeof p.data.oldPrice === 'number' && typeof p.data.price === 'number' && p.data.oldPrice > p.data.price);
const star = (produits as any[]).slice().sort((a, b) => score(b) - score(a))[0];
const starImg = star?.data.images?.[0] ?? null;
const starPrice = star ? (typeof star.data.price === 'number' ? `${star.data.price} €` : (star.data.priceText ?? '')) : '';
---
{cats.length > 0 && (
  <div class="bmega">
    <a href="/boutique/" class="bmega-trigger" aria-haspopup="true">
      Boutique
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </a>
    <div class="bmega-panel" role="menu">
      <div class="bmega-head"><strong>La boutique</strong><span>{cats.reduce((n, c) => n + c.count, 0)} produits testés &amp; comparés</span></div>
      <div class="bmega-cols">
        <div class="bmega-grid">
          {cats.map((c) => (
            <a href={`/categorie-produit/${c.slug}/`} class="bmega-item" role="menuitem">
              {c.image ? <img src={c.image} alt="" loading="lazy" width="48" height="48" /> : <span class="bmega-ph"></span>}
              <span class="bmega-txt"><strong>{c.label}</strong><small>{c.count} produit{c.count > 1 ? 's' : ''}</small></span>
            </a>
          ))}
          {deals.length > 0 && (
            <a href="/bons-plans/" class="bmega-item bmega-item--deal" role="menuitem">
              <span class="bmega-ph bmega-ph--deal">🔥</span>
              <span class="bmega-txt"><strong>Bons plans</strong><small>{deals.length} promo{deals.length > 1 ? 's' : ''} en cours</small></span>
            </a>
          )}
        </div>
        {star && (
          <a href={`/produit/${star.data.slug}/`} class="bmega-star" role="menuitem">
            <span class="bmega-star-tag">⭐ Coup de cœur</span>
            {starImg && <img src={starImg} alt={star.data.title} loading="lazy" width="120" height="90" />}
            <strong>{star.data.title}</strong>
            <span class="bmega-star-meta">{score(star) > 0 ? `${score(star)}/5` : ''}{starPrice ? ` · ${starPrice}` : ''}</span>
            <span class="bmega-star-cta">Voir la fiche →</span>
          </a>
        )}
      </div>
      <a href="/boutique/" class="bmega-all">Voir toute la boutique →</a>
    </div>
  </div>
)}

<style>
  .bmega { position: relative; display: inline-flex; }
  .bmega-trigger { display: inline-flex; align-items: center; gap: 5px; color: inherit; text-decoration: none; cursor: pointer; font: inherit; letter-spacing: inherit; }
  .bmega-trigger svg { opacity: .6; transition: transform .15s; }
  .bmega:hover .bmega-trigger svg, .bmega:focus-within .bmega-trigger svg { transform: rotate(180deg); }
  .bmega-panel {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(10px);
    min-width: 640px; max-width: 94vw; background: var(--color-bg-base, #fff);
    border: 1px solid var(--color-border, #e7e1d8); border-radius: 14px;
    box-shadow: 0 22px 60px rgba(0,0,0,.17); padding: 14px; z-index: 90;
    opacity: 0; visibility: hidden; transition: opacity .16s, transform .16s, visibility .16s;
    text-transform: none; letter-spacing: normal;
  }
  .bmega:hover .bmega-panel, .bmega:focus-within .bmega-panel { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(5px); }
  .bmega-head { display: flex; flex-direction: column; padding: 4px 8px 12px; border-bottom: 1px solid var(--color-border, #eee); margin-bottom: 8px; }
  .bmega-head strong { font-size: 15px; color: var(--color-ink, #1b120e); }
  .bmega-head span { font-size: 12px; color: var(--color-text-muted, #8a7d70); margin-top: 2px; }
  .bmega-cols { display: grid; grid-template-columns: 1fr 168px; gap: 10px; align-items: start; }
  .bmega-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .bmega-item { display: flex; align-items: center; gap: 11px; padding: 9px 10px; border-radius: 10px; text-decoration: none; color: var(--color-ink, #1b120e); transition: background .12s; }
  .bmega-item:hover { background: var(--color-bg-2, #f6f3ee); }
  .bmega-item img, .bmega-ph { width: 46px; height: 46px; object-fit: contain; background: #fff; border: 1px solid var(--color-border, #eee); border-radius: 9px; flex-shrink: 0; padding: 3px; }
  .bmega-ph { background: linear-gradient(135deg, var(--color-bg-2, #f0ece5), var(--color-border, #ddd)); }
  .bmega-ph--deal { display: inline-flex; align-items: center; justify-content: center; font-size: 21px; background: #fdf0d8; border-color: #f3ddae; }
  .bmega-item--deal strong { color: var(--color-accent, #b0654f); }
  .bmega-txt { display: flex; flex-direction: column; line-height: 1.25; }
  .bmega-txt strong { font-size: 14px; font-weight: 600; }
  .bmega-txt small { font-size: 11.5px; color: var(--color-text-muted, #8a7d70); }
  .bmega-star { display: flex; flex-direction: column; gap: 4px; padding: 12px; border: 1px solid var(--color-border, #eee); border-radius: 12px; text-decoration: none; color: var(--color-ink, #1b120e); background: var(--color-bg-2, #faf7f2); transition: box-shadow .15s; }
  .bmega-star:hover { box-shadow: 0 10px 26px rgba(0,0,0,.12); }
  .bmega-star-tag { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--color-accent, #b0654f); }
  .bmega-star img { width: 100%; height: 88px; object-fit: contain; background: #fff; border-radius: 8px; }
  .bmega-star strong { font-size: 12.5px; line-height: 1.3; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .bmega-star-meta { font-size: 11.5px; color: var(--color-text-muted, #8a7d70); }
  .bmega-star-cta { font-size: 11.5px; font-weight: 700; color: var(--color-accent, #b0654f); }
  .bmega-all { display: block; text-align: center; margin-top: 8px; padding-top: 11px; border-top: 1px solid var(--color-border, #eee); font-weight: 700; font-size: 13px; color: var(--color-accent, var(--color-ink)); text-decoration: none; }
  .bmega-all:hover { opacity: .8; }
  @media (max-width: 900px) { .bmega { display: none !important; } }
</style>
