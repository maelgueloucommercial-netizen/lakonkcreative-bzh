---
/**
 * HeroVariant — 4 layouts de hero différents pour anti-footprint Google.
 * Sélectionné via SITE_CONFIG.profile.layoutVariant.
 *
 *  - luxe : full-bleed image + texte minimal sur l'image (Lelo style)
 *  - magazine : split 2-col image gauche + texte droit (NYTimes style)
 *  - tech : pas d'image dominante, typo huge dominante + bandeau metrics (Wirecutter)
 *  - lifestyle : image avec overlay + bandeau bas (Manufactum / outils en action)
 */
import { SITE_CONFIG } from '../lib/site-config';
import { WIKI_IMAGES } from '../lib/site-wiki-images';

interface Props {
  title: string;
  subtitle: string;
  intro: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  badges?: string[];
  heroImage?: string | null; // fallback fourni par la page (produit/article) si pas d'image Wiki
}

const { title, subtitle, intro, primaryCta, secondaryCta, badges = [], heroImage = null } = Astro.props;
const profile = SITE_CONFIG.profile;
const variant = profile?.layoutVariant ?? 'magazine';

const primarySubject = profile?.wikiImageSubjects?.[0];
const heroImg = (primarySubject ? WIKI_IMAGES[primarySubject] : null) ?? heroImage;
const secondarySubject = profile?.wikiImageSubjects?.[1] ?? primarySubject;
const heroImg2 = (secondarySubject ? WIKI_IMAGES[secondarySubject] : null) ?? heroImage;
---

{/* === LUXE — full-bleed image, texte sur image, élégant minimal === */}
{variant === 'luxe' && (
  <section style="position:relative;height:88vh;min-height:580px;max-height:880px;overflow:hidden">
    {heroImg ? (
      <>
        <img src={heroImg} alt={title} loading="eager" decoding="async" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.55) saturate(1.05)" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg, transparent 0%, rgba(20,15,12,.55) 100%)"></div>
      </>
    ) : (
      <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary) 0%, var(--color-ink) 100%)"></div>
    )}
    <div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:0 0 96px 0;color:#fff">
      <div class="site-container">
        <div class="eyebrow-light" style="margin-bottom:24px">{subtitle}</div>
        <h1 class="serif" style="font-size:clamp(48px, 7vw, 96px);line-height:1.02;letter-spacing:-1px;font-weight:400;margin-bottom:32px;max-width:880px;color:#fff">{title}</h1>
        <p style="font-size:17px;color:rgba(255,255,255,.92);max-width:560px;margin-bottom:40px;line-height:1.6">{intro}</p>
        <div style="display:flex;gap:20px;flex-wrap:wrap">
          <a href={primaryCta.href} class="btn-fill" style="background:#fff;color:var(--color-ink);border-color:#fff">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="btn-line" style="color:#fff;border-color:rgba(255,255,255,.6)">{secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>
)}

{/* === MAGAZINE — split 5/4 image gauche + texte droite === */}
{variant === 'magazine' && (
  <section style="background:var(--color-bg-card)">
    <div style="display:grid;grid-template-columns:5fr 6fr;align-items:stretch;min-height:560px" class="hero-mag-grid">
      <div style="position:relative;min-height:520px;overflow:hidden">
        {heroImg ? (
          <img src={heroImg} alt={title} loading="eager" decoding="async" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        ) : (
          <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
        )}
      </div>
      <div style="padding:96px 80px;display:flex;flex-direction:column;justify-content:center">
        <div class="eyebrow" style="margin-bottom:24px">{subtitle}</div>
        <h1 class="serif" style="font-size:clamp(40px, 5.5vw, 80px);line-height:1.05;font-weight:400;letter-spacing:-1px;margin-bottom:32px">{title}</h1>
        <p style="font-size:17px;color:var(--color-text-muted);line-height:1.65;margin-bottom:40px;max-width:560px">{intro}</p>
        <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:center">
          <a href={primaryCta.href} class="btn-fill">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="link-underline">{secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>
)}

{/* === TECH — typo huge sans image, bandeau metrics dessous === */}
{variant === 'tech' && (
  <section style="background:var(--color-bg-base);padding:140px 0 0;border-bottom:1px solid var(--color-border)">
    <div class="site-container">
      <div style="max-width:1100px;margin-bottom:80px">
        <div class="eyebrow" style="margin-bottom:32px">{subtitle}</div>
        <h1 class="serif" style="font-size:clamp(56px, 9vw, 140px);line-height:.95;font-weight:400;letter-spacing:-3px;margin-bottom:40px">
          {title.split(' ').slice(0, -1).join(' ')} <em style="font-style:italic;color:var(--color-accent)">{title.split(' ').slice(-1)}</em>
        </h1>
        <p style="font-size:20px;color:var(--color-text-muted);line-height:1.55;max-width:680px;margin-bottom:48px">{intro}</p>
        <div style="display:flex;gap:20px;flex-wrap:wrap">
          <a href={primaryCta.href} class="btn-fill">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="btn-line">{secondaryCta.label}</a>
        </div>
      </div>
    </div>
    {/* Bandeau metrics */}
    <div style="border-top:1px solid var(--color-border);background:var(--color-bg-card);padding:32px 0">
      <div class="site-container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:48px;text-align:left">
        {badges.slice(0, 4).map((b) => {
          const [num, ...rest] = b.split(' ');
          return (
            <div>
              <div class="serif" style="font-size:42px;line-height:1;font-weight:400;letter-spacing:-1.5px;margin-bottom:6px;color:var(--color-accent)">{num}</div>
              <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted)">{rest.join(' ')}</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

{/* === LIFESTYLE — image full-width 60vh avec overlay + bandeau bas avec stats === */}
{variant === 'lifestyle' && (
  <section style="position:relative">
    <div style="position:relative;height:60vh;min-height:480px;overflow:hidden">
      {heroImg ? (
        <img src={heroImg} alt={title} loading="eager" decoding="async" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;filter:saturate(1.05)" />
      ) : (
        <div style="width:100%;height:100%;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
      )}
      <div style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(20,15,12,.3) 0%, rgba(20,15,12,.7) 100%)"></div>
      <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;text-align:center;padding:0 32px">
        <div style="max-width:880px">
          <div class="eyebrow-light" style="margin-bottom:18px">{subtitle}</div>
          <h1 class="serif" style="font-size:clamp(40px, 6.5vw, 84px);line-height:1.05;font-weight:400;letter-spacing:-1.5px;color:#fff">{title}</h1>
        </div>
      </div>
    </div>
    {/* Bandeau bas avec intro + CTAs */}
    <div style="background:var(--color-bg-card);padding:64px 0;border-bottom:1px solid var(--color-border)">
      <div class="site-container" style="display:grid;grid-template-columns:1.5fr 1fr;gap:80px;align-items:center" class="lifestyle-bandeau">
        <p style="font-size:18px;color:var(--color-text);line-height:1.6;font-family:'Cormorant Garamond',serif;font-style:italic">{intro}</p>
        <div style="display:flex;flex-direction:column;gap:14px;align-items:flex-end">
          <a href={primaryCta.href} class="btn-fill" style="width:100%;justify-content:center">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="btn-line" style="width:100%;justify-content:center">{secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
@media (max-width: 900px) {
  .hero-mag-grid { grid-template-columns: 1fr !important; }
  .hero-mag-grid > div:nth-child(2) { padding: 48px 32px !important; }
  .lifestyle-bandeau { grid-template-columns: 1fr !important; gap: 32px !important; }
  h1 { font-size: 40px !important; }
}
</style>
