---
/**
 * Unité AdSense manuelle in-content. Ne rend RIEN si AdSense désactivé pour le
 * site (ADSENSE.enabled=false) ou si le slot est vide (sécurité : pas de bloc
 * pub cassé, et aucune pub sur les sites non conformes).
 *
 * format : 'auto' (display responsive) | 'autorelaxed' (multiplex/grille) |
 *          'fluid' (in-article).
 *
 * Passe AdSense du 28/10/2026 : le push est DIFFÉRÉ jusqu'à ce que le <ins>
 * ait une largeur. Poussé au parsing, Google levait « No slot size for
 * availableWidth=0 » et « Invalid responsive width from Matched Content
 * slot … : 0 » sur tout le réseau : les deux unités restaient vides.
 */
import { ADSENSE, type AdSlotKey } from '../lib/adsense';

interface Props { slotKey: AdSlotKey; }
const { slotKey } = Astro.props as Props;
const cfg = ADSENSE.slots[slotKey];
const show = ADSENSE.enabled && cfg && cfg.slot;

let insAttrs: Record<string, string> = {
  class: 'adsbygoogle',
  style: 'display:block',
  'data-ad-client': ADSENSE.client,
  'data-ad-slot': cfg?.slot ?? '',
};
if (cfg?.format === 'fluid') {
  insAttrs = { ...insAttrs, 'data-ad-layout': 'in-article', 'data-ad-format': 'fluid' };
} else if (cfg?.format === 'autorelaxed') {
  insAttrs = { ...insAttrs, 'data-ad-format': 'autorelaxed' };
} else {
  insAttrs = { ...insAttrs, 'data-ad-format': 'auto', 'data-full-width-responsive': 'true' };
}
---
{show && (
  <div class="ad-unit not-prose" style="margin:36px 0;text-align:center;min-height:90px;width:100%" data-ad-unit={slotKey} aria-label="Publicité">
    <ins {...insAttrs}></ins>
    <script is:inline>(function(){var s=document.currentScript,i=s&&s.previousElementSibling,n=0;function go(){if(!i||i.getAttribute('data-adsbygoogle-status'))return;if(i.offsetWidth>0||n>24){(window.adsbygoogle=window.adsbygoogle||[]).push({});}else{n++;setTimeout(go,250);}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){setTimeout(go,0);});}else{setTimeout(go,0);}})();</script>
  </div>
)}
