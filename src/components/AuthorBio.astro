---
/**
 * AuthorBio — bloc auteur en fin d'article.
 * Persona configurable par site dans site-config.ts.
 */
import { SITE_CONFIG } from '../lib/site-config';

interface Props {
  authorName?: string;
  authorRole?: string;
  authorBio?: string;
  authorAvatar?: string;
}

// Personas par archetype (fallback si pas configuré au niveau du site)
const PERSONA_BY_ARCHETYPE: Record<string, { name: string; role: string; bio: string }> = {
  village: {
    name: 'Léa Charpentier',
    role: 'Rédactrice locale',
    bio: `Passionnée par la vie de nos villages, Léa parcourt la région depuis 8 ans pour dénicher les meilleurs spots, événements et initiatives locales. Habitante engagée, elle connaît chaque commerçant et association de la commune.`,
  },
  bricolage: {
    name: 'Thomas Reno',
    role: 'Expert outillage et bricolage',
    bio: `Ancien chef de chantier reconverti en testeur d'outils, Thomas a manipulé plus de 500 machines en 15 ans. Il décortique chaque produit pour vous éviter les achats regrettables et privilégie toujours la sécurité et la durabilité.`,
  },
  tech: {
    name: 'Marc Devauclair',
    role: 'Journaliste tech indépendant',
    bio: `Passionné par les technologies de l'image et du son depuis 1998, Marc teste les produits chez lui pendant des semaines avant d'écrire. Aucune marque ne sponsorise ses tests : il achète tout pour rester libre.`,
  },
  adulte: {
    name: 'Camille Vermeer',
    role: 'Rédactrice et conseillère',
    bio: `Sexologue diplômée DIU Sexologie clinique (Bordeaux 2020), Camille démystifie le plaisir avec un ton sans tabou ni vulgarité. Elle teste, compare et recommande dans le respect du consentement.`,
  },
};

const persona = PERSONA_BY_ARCHETYPE[SITE_CONFIG.theme.archetype] ?? PERSONA_BY_ARCHETYPE.village;

const {
  authorName = persona.name,
  authorRole = persona.role,
  authorBio = persona.bio,
  authorAvatar,
} = Astro.props;

// Avatar fallback : initiales en SVG
const initials = authorName.split(/\s+/).map((n) => n[0]).join('').toUpperCase().slice(0, 2);
---
<aside class="author-bio not-prose" style="margin:64px 0 32px;padding:48px 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)">
  <div style="display:flex;gap:32px;align-items:flex-start" class="author-row">
    {authorAvatar ? (
      <img src={authorAvatar} alt={authorName}
           style="width:96px;height:96px;border-radius:50%;object-fit:cover;flex-shrink:0;filter:grayscale(.2)" />
    ) : (
      <div style="width:96px;height:96px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--color-bg-card);border:1px solid var(--color-border);font-family:'Cormorant Garamond',serif;font-size:36px;font-style:italic;color:var(--color-accent);letter-spacing:-1px;font-weight:400">
        {initials}
      </div>
    )}
    <div style="flex:1;min-width:0">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-accent);margin-bottom:10px;font-weight:600">Signé par</div>
      <h3 class="serif" style="font-size:28px;line-height:1.15;font-weight:400;letter-spacing:-.3px;color:var(--color-ink);margin:0 0 6px">{authorName}</h3>
      <div style="font-family:'Cormorant Garamond',serif;font-size:16px;font-style:italic;color:var(--color-text-muted);margin-bottom:18px">— {authorRole}</div>
      <p style="font-size:15px;line-height:1.7;color:var(--color-text-muted);margin:0 0 24px;max-width:620px">
        {authorBio}
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:24px">
        <a href="/equipe-editoriale/" style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-accent);text-decoration:none;font-weight:600">
          Toute l'équipe →
        </a>
        <a href="/charte-editoriale/" style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);text-decoration:none;font-weight:600">
          Notre charte →
        </a>
      </div>
    </div>
  </div>
</aside>
<style>
@media (max-width: 600px) {
  .author-row { flex-direction: column !important; gap: 16px !important; }
  .author-row > img, .author-row > div:first-child { width: 64px !important; height: 64px !important; }
}
</style>
