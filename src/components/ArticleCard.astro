---
/**
 * ArticleCard — 4 styles différents selon SITE_CONFIG.profile.layoutVariant.
 *  - luxe : photo full + titre serif italic minimal sous (Lelo magazine)
 *  - magazine : photo + meta + headline + dek (Vogue style)
 *  - tech : compact card avec ratings/specs (Wirecutter)
 *  - lifestyle : photo carrée + label catégorie + titre (Manufactum)
 */
import { SITE_CONFIG } from '../lib/site-config';
import { getArticleImage } from '../lib/article-wiki-images';

interface Props {
  entry: any;
  href: string;
  size?: 'small' | 'medium' | 'large';
}
const { entry, href, size = 'medium' } = Astro.props;
const profile = SITE_CONFIG.profile;
const variant = profile?.layoutVariant ?? 'magazine';

const wikiImg = getArticleImage(entry.data.slug);
const img = entry.data.heroImage ?? wikiImg;
const dateStr = entry.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

{variant === 'luxe' && (
  <a href={href} style="display:block;text-decoration:none;color:inherit;group:relative">
    {img ? (
      <img src={img} alt={entry.data.title} style={`width:100%;${size === 'large' ? 'aspect-ratio:4/3' : 'aspect-ratio:5/4'};object-fit:cover;margin-bottom:24px`} loading="lazy" />
    ) : (
      <div style={`width:100%;${size === 'large' ? 'aspect-ratio:4/3' : 'aspect-ratio:5/4'};background:linear-gradient(135deg, var(--color-primary), var(--color-ink));margin-bottom:24px`}></div>
    )}
    <div style="font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:12px">{dateStr}</div>
    <h3 class="serif" style={`font-size:${size === 'large' ? '34px' : '24px'};line-height:1.15;font-weight:400;margin-bottom:10px;letter-spacing:-.5px`}>{entry.data.title}</h3>
    {entry.data.description && size !== 'small' && (
      <p style="font-size:14px;color:var(--color-text-muted);line-height:1.65;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{entry.data.description}</p>
    )}
  </a>
)}

{variant === 'magazine' && (
  <a href={href} style="display:block;text-decoration:none;color:inherit">
    {img ? (
      <img src={img} alt={entry.data.title} style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:18px" loading="lazy" />
    ) : (
      <div style="width:100%;aspect-ratio:3/2;background:linear-gradient(135deg, var(--color-bg-2), var(--color-border));margin-bottom:18px"></div>
    )}
    <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--color-accent);margin-bottom:8px;font-weight:600">{dateStr}</div>
    <h3 class="serif" style={`font-size:${size === 'large' ? '32px' : '22px'};line-height:1.2;font-weight:500;margin-bottom:8px;letter-spacing:-.3px`}>{entry.data.title}</h3>
    {entry.data.description && (
      <p style="font-size:14px;color:var(--color-text-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:16px">{entry.data.description.slice(0, 140)}</p>
    )}
  </a>
)}

{variant === 'tech' && (
  <a href={href} style="display:block;text-decoration:none;color:inherit;background:var(--color-bg-card);border:1px solid var(--color-border);transition:border-color .25s">
    {img ? (
      <img src={img} alt={entry.data.title} style="width:100%;aspect-ratio:16/9;object-fit:cover" loading="lazy" />
    ) : (
      <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg, var(--color-bg-2), var(--color-border))"></div>
    )}
    <div style="padding:18px 20px 22px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
        <span style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);font-weight:600">{dateStr}</span>
        <span style="font-size:11px;color:var(--color-accent);font-weight:600">★ ★ ★ ★ ★</span>
      </div>
      <h3 class="serif" style={`font-size:${size === 'large' ? '24px' : '19px'};line-height:1.3;font-weight:500;margin-bottom:8px;letter-spacing:-.3px;color:var(--color-ink)`}>{entry.data.title}</h3>
      {entry.data.description && (
        <p style="font-size:13px;color:var(--color-text-muted);line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{entry.data.description}</p>
      )}
    </div>
  </a>
)}

{variant === 'lifestyle' && (
  <a href={href} style="display:block;text-decoration:none;color:inherit">
    {img ? (
      <img src={img} alt={entry.data.title} style="width:100%;aspect-ratio:1;object-fit:cover;margin-bottom:18px" loading="lazy" />
    ) : (
      <div style="width:100%;aspect-ratio:1;background:linear-gradient(135deg, var(--color-primary), var(--color-ink));margin-bottom:18px"></div>
    )}
    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px">
      <span style="font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--color-accent);font-weight:600">— Article</span>
      <span style="font-size:11px;color:var(--color-text-muted)">{dateStr}</span>
    </div>
    <h3 class="serif" style={`font-size:${size === 'large' ? '28px' : '22px'};line-height:1.2;font-weight:400;margin-bottom:10px;letter-spacing:-.3px`}>{entry.data.title}</h3>
    {entry.data.description && size !== 'small' && (
      <p style="font-size:14px;color:var(--color-text-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{entry.data.description}</p>
    )}
  </a>
)}

<style>
a:hover h3 { color: var(--color-accent); transition: color .2s; }
a:hover img { opacity: .92; transition: opacity .2s; }
</style>
