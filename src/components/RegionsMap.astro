---
import { getCollection } from 'astro:content';

const regions = await getCollection('regions');
const bySlug = new Map(regions.map((r) => [r.id, r]));

/**
 * Carte cliquable de l'Italie — SVG Wikipedia Commons (CC) en background
 * + 20 boutons cliquables positionnés en pourcentages relatifs sur les
 * régions. Plus géographique que la précédente grid CSS.
 *
 * Coordonnées (left%, top%) : centroïdes approximatifs des 20 régions
 * dans le cadre de référence de italy-regions.svg (734×867 ≈ 0.85 ratio).
 */
interface RegionMarker {
  slug: string;
  /** Position du marker en % de la largeur de l'image */
  left: number;
  /** Position du marker en % de la hauteur de l'image */
  top: number;
  /** Macro-area pour le coloris du marker */
  macro: 'Nord' | 'Centre' | 'Sud' | 'Îles';
}

const MARKERS: RegionMarker[] = [
  { slug: 'val-d-aoste',         left: 26, top: 14, macro: 'Nord' },
  { slug: 'piemont',             left: 28, top: 22, macro: 'Nord' },
  { slug: 'lombardie',           left: 41, top: 19, macro: 'Nord' },
  { slug: 'trentin-haut-adige',  left: 49, top: 11, macro: 'Nord' },
  { slug: 'venetie',             left: 56, top: 18, macro: 'Nord' },
  { slug: 'frioul',              left: 64, top: 14, macro: 'Nord' },
  { slug: 'ligurie',             left: 33, top: 31, macro: 'Nord' },
  { slug: 'emilie-romagne',      left: 47, top: 27, macro: 'Nord' },
  { slug: 'toscane',             left: 45, top: 38, macro: 'Centre' },
  { slug: 'marches',             left: 56, top: 38, macro: 'Centre' },
  { slug: 'ombrie',              left: 51, top: 43, macro: 'Centre' },
  { slug: 'latium',              left: 50, top: 50, macro: 'Centre' },
  { slug: 'abruzzes',            left: 57, top: 47, macro: 'Centre' },
  { slug: 'molise',              left: 60, top: 53, macro: 'Sud' },
  { slug: 'campanie',            left: 58, top: 59, macro: 'Sud' },
  { slug: 'pouilles',            left: 70, top: 59, macro: 'Sud' },
  { slug: 'basilicate',          left: 64, top: 63, macro: 'Sud' },
  { slug: 'calabre',             left: 64, top: 73, macro: 'Sud' },
  { slug: 'sicile',              left: 48, top: 86, macro: 'Îles' },
  { slug: 'sardaigne',           left: 22, top: 65, macro: 'Îles' },
];

const tone = (macro: string) => {
  if (macro === 'Nord') return 'bg-olive-600 hover:bg-olive-700 ring-olive-300';
  if (macro === 'Centre') return 'bg-cream-200 hover:bg-cream-100 ring-cream-200 text-ink-900';
  if (macro === 'Sud') return 'bg-terra-600 hover:bg-terra-700 ring-terra-300';
  return 'bg-ink-700 hover:bg-ink-900 ring-ink-700';
};
---
<div class="relative w-full max-w-xl mx-auto">
  <!-- Aspect ratio container (734/867 ≈ 0.847) -->
  <div class="relative pb-[118%]">
    <!-- Italy SVG as static background -->
    <img
      src="/images/home/italy-regions.svg"
      alt="Carte des régions d'Italie"
      class="absolute inset-0 w-full h-full object-contain"
      loading="lazy"
    />

    <!-- 20 clickable markers -->
    {MARKERS.map((m) => {
      const r = bySlug.get(m.slug);
      if (!r) return null;
      return (
        <a
          href={`/regions/${r.id}`}
          class:list={[
            'absolute group flex items-center justify-center',
            'transition-transform hover:scale-110 hover:z-20',
          ]}
          style={`left: ${m.left}%; top: ${m.top}%; transform: translate(-50%, -50%);`}
          aria-label={r.data.name}
        >
          <span class:list={[
            'block w-4 h-4 sm:w-5 sm:h-5 rounded-full border-2 border-cream-50 shadow-md ring-2 transition',
            tone(m.macro),
          ]}></span>
          <span class="absolute left-1/2 -translate-x-1/2 -bottom-7 whitespace-nowrap text-[11px] sm:text-xs font-medium px-2 py-0.5 rounded bg-ink-900 text-cream-50 opacity-0 group-hover:opacity-100 transition pointer-events-none shadow-md">
            {r.data.name}
          </span>
        </a>
      );
    })}
  </div>

  <!-- Légende -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-6 text-xs text-ink-700/70 justify-center">
    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-olive-600"></span>Nord</span>
    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-cream-200 border border-cream-200"></span>Centre</span>
    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-terra-600"></span>Sud</span>
    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-ink-700"></span>Îles</span>
    <span class="ml-auto italic text-ink-700/50">Cliquez sur un point pour explorer</span>
  </div>
</div>
