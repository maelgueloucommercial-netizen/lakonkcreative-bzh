---
/**
 * SeeAlso — articles liés en bas de page (silo SEO).
 * Sélection : 4 articles random parmi le reste de la collection,
 * priorise ceux qui partagent des tokens du slug courant.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { articleUrl } from '../lib/article-url';

interface Props {
  current: CollectionEntry<'articles'>;
  count?: number;
}

const { current, count = 4 } = Astro.props;
const all = await getCollection('articles');

// Score par overlap de tokens entre slugs
const currentTokens = new Set(
  current.data.slug.split(/[-_]+/).filter((t) => t.length >= 4),
);
function scoreOverlap(other: typeof current): number {
  const otherTokens = other.data.slug.split(/[-_]+/).filter((t) => t.length >= 4);
  let n = 0;
  for (const t of otherTokens) if (currentTokens.has(t)) n++;
  return n;
}

const candidates = all
  .filter((a) => a.id !== current.id)
  .map((a) => ({ entry: a, score: scoreOverlap(a) }))
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.entry.data.pubDate.getTime() - a.entry.data.pubDate.getTime();
  })
  .slice(0, count);

function getUrl(d: typeof current.data): string {
    return articleUrl(d);
}
---
{candidates.length > 0 && (
  <section class="see-also not-prose" style="margin:64px 0" aria-labelledby="see-also-heading">
    <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-accent);margin-bottom:18px;font-weight:600">À lire aussi</div>
    <h2 id="see-also-heading" class="serif" style="font-size:clamp(28px, 3.2vw, 40px);line-height:1.1;font-weight:400;letter-spacing:-.5px;margin:0 0 36px;color:var(--color-ink)">
      Continuer la <em style="font-style:italic">lecture</em>.
    </h2>
    <ul style="list-style:none;padding:0;margin:0;border-top:1px solid var(--color-border)">
      {candidates.map(({ entry }) => (
        <li style="border-bottom:1px solid var(--color-border)">
          <a href={getUrl(entry.data)} style="display:grid;grid-template-columns:1fr auto;gap:24px;align-items:baseline;padding:24px 0;text-decoration:none;color:inherit">
            <div>
              <h3 class="serif" style="font-size:22px;line-height:1.25;font-weight:400;letter-spacing:-.2px;margin:0 0 6px;color:var(--color-ink)">
                {entry.data.title.length > 90 ? entry.data.title.slice(0, 90) + '…' : entry.data.title}
              </h3>
              {entry.data.description && (
                <p style="font-size:14px;line-height:1.6;color:var(--color-text-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:0">
                  {entry.data.description}
                </p>
              )}
            </div>
            <time style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);font-weight:600;white-space:nowrap">
              {entry.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
