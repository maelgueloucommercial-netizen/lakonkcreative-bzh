---
/**
 * DevisCta — bandeau de conversion « devis gratuit » pour la home
 * local_service_leadgen. Form condensé (nom/tél/CP) → même endpoint worker /lead
 * que la page /devis/. Soumission AJAX + fallback POST classique.
 */
import { SITE_CONFIG } from '../lib/site-config';
interface Props { service?: string; usps?: string[]; phone?: string; }
const profile: any = SITE_CONFIG.profile ?? {};
const { service = SITE_CONFIG.siteName, usps, phone = profile.phone } = Astro.props as Props;
const tel = phone ? String(phone).replace(/\s/g, '') : '';
const uspList = (usps && usps.length ? usps : (Array.isArray(profile.usps) && profile.usps.length ? profile.usps : ['Sans engagement', 'Réponse 24-48h', 'Professionnels vérifiés', '100% gratuit']));
const LEAD_ENDPOINT = 'https://felleries-cron.mael-guelou-commercial.workers.dev/lead';
const source = SITE_CONFIG.siteUrl;
---
<section style="background:var(--color-ink);color:var(--color-bg-base);padding:96px 0">
  <div class="site-container">
    <div class="dvc">
      <div class="dvc-text">
        <span class="hp-pill" style="background:transparent;border-color:rgba(255,255,255,.25);color:var(--color-secondary)">Devis gratuit</span>
        <h2 class="serif" style="font-size:clamp(34px,4.5vw,56px);line-height:1.05;font-weight:400;letter-spacing:-.5px;margin:16px 0 18px;color:var(--color-bg-base)">
          Votre devis <em style="font-style:italic;color:var(--color-secondary)">en 1 minute</em>.
        </h2>
        <ul class="dvc-usps">{uspList.slice(0, 4).map((u: string) => <li>✓ {u}</li>)}</ul>
        {phone && <p class="dvc-phone">Ou appelez le <a href={`tel:${tel}`}>☎ {phone}</a></p>}
      </div>
      <div class="dvc-card">
        <form method="POST" action={LEAD_ENDPOINT} class="dvc-form">
          <input type="hidden" name="service" value={service} />
          <input type="hidden" name="source" value={source} />
          <input name="nom" required placeholder="Votre nom *" />
          <input name="tel" required type="tel" placeholder="Téléphone *" />
          <input name="cp" placeholder="Code postal" />
          <button type="submit" class="dvc-btn">Recevoir mon devis gratuit</button>
        </form>
        <p class="dvc-note">Vos données ne servent qu'à traiter votre demande.</p>
        <div id="dvc-msg" class="dvc-msg" role="status" hidden></div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ leadUrl: LEAD_ENDPOINT, phone: phone || '' }}>
  (function () {
    var form = document.querySelector('.dvc-form'); var msg = document.getElementById('dvc-msg');
    function show(ok, t) { if (!msg) return; msg.hidden = false; msg.className = 'dvc-msg ' + (ok ? 'ok' : 'err'); msg.textContent = t; }
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault(); var btn = form.querySelector('button[type=submit]'); var l = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Envoi…'; }
      var body = new URLSearchParams(new FormData(form)); body.set('ajax', '1');
      fetch(leadUrl, { method: 'POST', body: body })
        .then(function (r) { if (!r.ok) throw 0; return r.json().catch(function () { return {}; }); })
        .then(function () { form.reset(); show(true, 'Merci ! Demande envoyée, vous serez recontacté au plus vite' + (phone ? ' — ou appelez le ' + phone + '.' : '.')); })
        .catch(function () { show(false, 'Envoi indisponible.' + (phone ? ' Appelez-nous au ' + phone + '.' : ' Réessayez dans un instant.')); })
        .finally(function () { if (btn) { btn.disabled = false; btn.textContent = l; } });
    });
  })();
</script>

<style>
  .dvc { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .dvc-usps { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 6px; font-weight: 600; color: rgba(255,255,255,.9); font-size: 14px; }
  .dvc-phone { color: rgba(255,255,255,.8); font-size: 14px; margin: 0; }
  .dvc-phone a { color: var(--color-secondary); font-weight: 700; text-decoration: none; }
  .dvc-card { background: var(--color-bg-card, #fff); border-radius: 18px; padding: 26px; box-shadow: 0 22px 50px rgba(0,0,0,.3); }
  .dvc-form { display: grid; gap: 10px; }
  .dvc-form input { padding: 13px 14px; border: 1px solid var(--color-border); border-radius: 11px; font-size: 15px; width: 100%; box-sizing: border-box; font-family: inherit; color: var(--color-ink); }
  .dvc-btn { padding: 14px; border: 0; border-radius: 11px; background: var(--color-accent); color: #fff; font-weight: 700; font-size: 15px; cursor: pointer; transition: filter .15s; }
  .dvc-btn:hover { filter: brightness(1.06); }
  .dvc-note { font-size: 12px; color: var(--color-text-muted); margin: 10px 0 0; }
  .dvc-msg { margin: 10px 0 0; padding: 10px 12px; border-radius: 10px; font-size: 14px; font-weight: 600; }
  .dvc-msg.ok { background: #e7f3ec; color: #1b6b3e; } .dvc-msg.err { background: #fdecea; color: #9a3528; }
  @media (max-width: 820px) { .dvc { grid-template-columns: 1fr; gap: 32px; } }
</style>
