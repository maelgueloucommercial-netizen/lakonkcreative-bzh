---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  bodyClass?: string;
  /** Préchargement de l'image LCP (item #49) — passe le src de l'image hero. */
  preloadImage?: string;
}

const props = Astro.props;
---
<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Fonts auto-hébergées (item LCP) — preload pour libérer le critical path.
        Le @font-face est dans global.css, qui est inliné via inlineStylesheets:'always'. */}
    <link rel="preload" href="/fonts/cormorant-garamond-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <SEOHead
      title={props.title}
      description={props.description}
      image={props.image}
      type={props.type}
      publishedAt={props.publishedAt}
      updatedAt={props.updatedAt}
      schema={props.schema}
      noindex={props.noindex}
      preloadImage={props.preloadImage}
    />
  </head>
  <body class:list={['min-h-screen flex flex-col', props.bodyClass]}>
    <Header />
    <main class="flex-1" data-pagefind-body><slot /></main>
    <Footer />
    {/* Cloudflare Web Analytics — tag chargé uniquement si PUBLIC_CF_BEACON est
        défini (free, RGPD-clean, sans cookie). Item #76 roadmap. */}
    {import.meta.env.PUBLIC_CF_BEACON && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON}"}`}
      ></script>
    )}
  </body>
</html>
