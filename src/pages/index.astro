---
import Base from '../layouts/Base.astro';
import { articleUrl } from '../lib/article-url';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../lib/site-config';
import { classifyIntent } from '../lib/intent-classifier';

import Newsletter from '../components/Newsletter.astro';
import HeroVariant from '../components/HeroVariant.astro';
import '../styles/home-skins.css';
import { WIKI_IMAGES } from '../lib/site-wiki-images';
import { getArticleImage } from '../lib/article-wiki-images';
import { buildBlogCategories } from '../lib/blog-categories';
import { inferArchetype, HOME_SECTIONS } from '../lib/page-archetypes';
import LocalMap from '../components/LocalMap.astro';
import WeatherWidget from '../components/niche/WeatherWidget.astro';
import AgendaHome from '../components/AgendaHome.astro';
import DevisCta from '../components/DevisCta.astro';
import ToolEmbed from '../components/ToolEmbed.astro';

const archetype = SITE_CONFIG.theme.archetype;
const profile = SITE_CONFIG.profile;
const articles = await getCollection('articles');
articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function getArticleUrl(entry: typeof articles[number]): string {
  const d = entry.data;
    return articleUrl(d);
}

const featured = articles.slice(0, 6);
const recent = articles.slice(6, 18);

// Classify articles into profile categories
function classifyArticleByCategory(title: string): string | null {
  if (!profile) return null;
  const t = title.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
  for (const cat of profile.categories) {
    for (const kw of cat.keywords) {
      if (t.includes(kw.toLowerCase().normalize('NFD').replace(/\p{M}/gu, ''))) {
        return cat.slug;
      }
    }
  }
  return null;
}
const articlesByCategory = new Map<string, typeof articles>();
if (profile) {
  for (const a of articles) {
    const cat = classifyArticleByCategory(a.data.title);
    if (cat) {
      if (!articlesByCategory.has(cat)) articlesByCategory.set(cat, [] as typeof articles);
      articlesByCategory.get(cat)!.push(a);
    }
  }
}

const hero = profile?.hero ?? {
  title: SITE_CONFIG.siteName,
  subtitle: SITE_CONFIG.tagline,
  intro: SITE_CONFIG.tagline,
  primaryCta: { label: 'Articles', href: '/articles/' },
  secondaryCta: { label: 'Outils', href: '/outils/' },
  badges: [],
  imageHint: '',
};

// Hero image principale (Wikipedia)
const primarySubject = profile?.wikiImageSubjects?.[0];
const heroImageUrl = primarySubject ? WIKI_IMAGES[primarySubject] : null;
const wikiImageEntries = Object.entries(WIKI_IMAGES);

// Editorial feature : 1er article featuré OR le 1er matchup
const editorialArticle = featured[0];
const editorialImg = editorialArticle ? (editorialArticle.data.heroImage ?? getArticleImage(editorialArticle.data.slug)) : null;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_CONFIG.siteName,
  url: SITE_CONFIG.siteUrl,
  description: profile?.mission ?? SITE_CONFIG.tagline,
  ...(profile?.author ? {
    employee: [{
      '@type': 'Person',
      name: profile.author.name,
      jobTitle: profile.author.role,
      description: profile.author.bio,
    }],
  } : {}),
};
const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_CONFIG.siteName,
  url: SITE_CONFIG.siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE_CONFIG.siteUrl.replace(/\/$/, '')}/recherche/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

// Stats
const totalArticles = articles.length;
const totalCats = profile?.categories.length ?? 0;
const totalTools = profile?.tools.length ?? 0;
const totalMatchups = profile?.matchups?.length ?? 0;

// ===== DIFFÉRENCIATION HOMEPAGE (demande Mael 2026-06-10 : « 40 fois la même home ») =====
// 3 axes indépendants, déterministes par domaine → plus aucune paire de sites identique,
// AUCUN élément retiré (toutes les sections SEO restent, seuls ordre + habillage changent).
//   1. ORDRE des sections (8 séquences, réellement appliquées au rendu — avant, calculé mais ignoré)
//   2. SKIN visuel (6 systèmes : geometry/bordures/ombres/fonds/typo) — home-skins.css
//   3. HeroVariant (4 layouts existants) + fallback image réelle (produits/article si pas de Wiki)
const variant = profile?.layoutVariant ?? 'magazine';
const HOME_ORDERS: Record<string, string[]> = {
  luxe:      ['editorial', 'shop', 'blog', 'discover', 'author', 'duel', 'newsletter'],
  magazine:  ['blog', 'shop', 'editorial', 'discover', 'duel', 'author', 'newsletter'],
  tech:      ['shop', 'discover', 'blog', 'duel', 'editorial', 'newsletter', 'author'],
  lifestyle: ['shop', 'editorial', 'blog', 'author', 'discover', 'duel', 'newsletter'],
  atelier:   ['shop', 'blog', 'duel', 'discover', 'editorial', 'author', 'newsletter'],
  vitrine:   ['shop', 'editorial', 'discover', 'blog', 'duel', 'newsletter', 'author'],
  journal:   ['editorial', 'blog', 'shop', 'duel', 'author', 'discover', 'newsletter'],
  catalogue: ['shop', 'blog', 'editorial', 'duel', 'discover', 'author', 'newsletter'],
};
const ORDER_NAMES = Object.keys(HOME_ORDERS);
const _hh = [...SITE_CONFIG.siteUrl].reduce((a, c) => ((a * 31 + c.charCodeAt(0)) >>> 0), 7);
// ordre ET skin pilotés par le hash du domaine (indépendants du variant) → 8 ordres × 6 skins,
// décorrélés (multiplicateurs distincts) = répartition large sur les ~36 sites.
const orderKey = ORDER_NAMES[_hh % ORDER_NAMES.length];
// SÉLECTION + ORDRE DES SECTIONS = archétype STRUCTUREL (6), plus le hash. Le hash
// ne pilote désormais que le skin visuel (anti-footprint). `inferArchetype` = filet
// pour les sites sans champ `archetype` (geo→local_place, matchups→comparator, défaut éditorial).
const structuralArchetype = profile?.archetype ?? inferArchetype((profile as any) ?? { domain: SITE_CONFIG.domain });
const sectionOrder: string[] = [...HOME_SECTIONS[structuralArchetype]];
const SKINS = ['paper', 'sharp', 'soft', 'noir', 'outline', 'glossy'];
const homeSkin = SKINS[((_hh * 7 + 3) >>> 0) % SKINS.length];

// Blog par rubrique (homepage) — chaque rubrique + ses derniers articles.
// Classification canonique partagée → mêmes compteurs que /categorie/, sidebar et méga-menu.
const blogCats = buildBlogCategories(articles, profile?.categories as any)
  .sort((a, b) => b.articles.length - a.articles.length)
  .slice(0, 8);

// Boutique par rayon (homepage) — chaque catégorie produit + ses meilleurs produits.
const bProduits = await getCollection('produits').catch(() => []);
const bScore = (p: any) => (p.data.scoreGlobal ?? p.data.rating ?? 0) as number;
const bImg = (p: any) => (p.data.images?.[0] ?? p.data.image ?? null) as string | null;
const bStars = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
const bPrice = (p: any) => (typeof p.data.price === 'number' ? `${p.data.price} €` : (p.data.priceText ?? ''));
const _bByCat = new Map<string, any[]>();
for (const p of bProduits as any[]) {
  if (!_bByCat.has(p.data.category)) _bByCat.set(p.data.category, []);
  _bByCat.get(p.data.category)!.push(p);
}
const bCats = [...(_bByCat.entries())].map(([slug, items]) => ({
  slug,
  label: items[0].data.categoryLabel ?? slug,
  count: items.length,
  top: [...items].sort((a, b) => bScore(b) - bScore(a)).slice(0, 4),
})).sort((a, b) => b.count - a.count);

// Bons plans (benchmark objetrama 2026-06-10) : remises réelles mises en avant sur la home.
const bDisc = (p: any) => (typeof p.data.oldPrice === 'number' && typeof p.data.price === 'number' && p.data.oldPrice > p.data.price)
  ? Math.round((1 - p.data.price / p.data.oldPrice) * 100) : null;
const bDeals = (bProduits as any[]).filter((p) => bDisc(p) !== null).sort((a, b) => (bDisc(b) ?? 0) - (bDisc(a) ?? 0)).slice(0, 4);

// Home commerce-first sur les sites boutique : le CTA principal du hero mène à la boutique
// (objetrama : la home est un magasin, l'éditorial vient après). Copie locale : ne pas
// muter profile.hero (objet partagé entre pages au build).
const commerceFirst = structuralArchetype === 'product_catalogue' && bCats.length > 0;
// Hero CTA adapté à l'archétype (lead-block propre au type de site). L'ORDRE des
// sections vient déjà de HOME_SECTIONS[archetype] — plus de splice « commerce-first ».
function heroCtaForArchetype(): { label: string; href: string } | null {
  switch (structuralArchetype) {
    case 'product_catalogue': return bCats.length > 0 ? { label: '🛒 Découvrir la boutique', href: '/boutique/' } : null;
    case 'local_service_leadgen': return { label: '📝 Devis gratuit', href: '/devis/' };
    case 'comparator_affiliate': return { label: 'Voir les comparatifs', href: '/comparateur/' };
    case 'tool_utility': { const t = profile?.tools?.[0]; return t ? { label: `Ouvrir ${t.label}`, href: t.href ?? `/outils/${t.slug}/` } : null; }
    case 'local_place': return { label: `🧭 Que faire${profile?.geo?.placename ? ` à ${profile.geo.placename}` : ''}`, href: '/agenda/' };
    default: return null;
  }
}
const _archCta = heroCtaForArchetype();
const heroEff = _archCta
  ? { ...hero, primaryCta: _archCta, secondaryCta: hero.primaryCta?.href === _archCta.href ? hero.secondaryCta : (hero.primaryCta ?? hero.secondaryCta) }
  : hero;
// Image hero garantie : Wiki sinon meilleur produit sinon image d'article (sites « sans image »).
const heroImageEff = heroImageUrl ?? (bProduits as any[]).map((p) => p.data.images?.[0]).find(Boolean) ?? editorialImg ?? null;

// ===== DONNÉES DES SECTIONS SUR-MESURE (archétype-aware) — vides ⇒ section masquée =====
const geo = profile?.geo;
// local_place — agenda : articles avec eventDate (à venir, triés)
const now = new Date();
const agendaEvents = articles
  .filter((a) => a.data.eventDate instanceof Date && !Number.isNaN(a.data.eventDate.getTime()))
  .filter((a) => ((a.data.eventEndDate as Date | undefined) ?? a.data.eventDate as Date) >= now)
  .map((a) => ({
    title: a.data.title, href: getArticleUrl(a),
    eventDate: a.data.eventDate as Date, eventEndDate: a.data.eventEndDate as Date | undefined,
    eventType: a.data.eventType, eventLocation: a.data.eventLocation,
    image: a.data.heroImage ?? getArticleImage(a.data.slug),
  }));
// leadgen — services × villes (collection locales) + avis clients agrégés
const _locales = await getCollection('locales').catch(() => []);
const _svcMap = new Map<string, { service: string; serviceSlug: string; villes: { ville: string; href: string }[] }>();
for (const l of _locales as any[]) {
  const s = l.data.service;
  if (!_svcMap.has(s)) _svcMap.set(s, { service: s, serviceSlug: l.data.serviceSlug, villes: [] });
  _svcMap.get(s)!.villes.push({ ville: l.data.ville, href: `/${l.data.serviceSlug}/${l.data.villeSlug}/` });
}
const servicesVilles = [...(_svcMap.values())].slice(0, 6);
const clientAvis = (_locales as any[])
  .flatMap((l) => (l.data.avis ?? []).map((a: any) => ({ ...a, ville: l.data.ville })))
  .slice(0, 6);
// commerce / comparateur / leadgen — guides, avis marques, comparateurs, études de prix
const homeGuides = (await getCollection('guides').catch(() => [])).slice(0, 6);
const homeAvisMarques = (await getCollection('avis').catch(() => [])).slice(0, 6);
const homeComparateurs = (await getCollection('comparateurs').catch(() => [])).slice(0, 6);
const homePrix = (await getCollection('etudesPrix').catch(() => [])).slice(0, 4);
// tool_utility — outil central
const mainTool = profile?.tools?.[0];
---
<Base title={SITE_CONFIG.tagline} description={hero.subtitle} jsonLd={[orgJsonLd, webSiteJsonLd]}>
<div class={`hs hs--${homeSkin}`} data-skin={homeSkin} data-order={orderKey}>

  {/* TOP NOTICE */}
  <div style="background:var(--color-ink);color:var(--color-bg-base);text-align:center;font-size:11px;letter-spacing:2px;text-transform:uppercase;padding:11px 20px;font-weight:500">
    {profile?.trustBadges?.slice(0, 3).map((b, i) => (
      <span style={`margin:0 14px;display:inline-block;${i === 0 ? '' : ''}`}>
        {b.label}
      </span>
    ))}
  </div>

  {/* HERO — variant adapté au profile (luxe/magazine/tech/lifestyle) */}
  <HeroVariant
    title={heroEff.title}
    subtitle={profile?.author?.credentials ?? 'Magazine indépendant'}
    intro={heroEff.intro}
    primaryCta={heroEff.primaryCta}
    secondaryCta={heroEff.secondaryCta}
    badges={[`${totalArticles} Articles publiés`, `${totalTools} Outils gratuits`, `${totalCats} Rubriques`, `${totalMatchups} Duels`]}
    heroImage={heroImageEff}
  />

  {/* BENEFITS — cartes « pourquoi nous » (signature ionomat : 4 cartes + chip icône) */}
  {profile?.trustBadges && profile.trustBadges.length >= 3 && (
    <section class="hp-benefits-wrap">
      <div class="site-container">
        <div class="hp-benefits">
          {profile.trustBadges.slice(0, 4).map((b) => (
            <div class="hp-benefit">
              <span class="hp-benefit-ico">{b.emoji}</span>
              <strong class="hp-benefit-title">{b.label}</strong>
              <p class="hp-benefit-desc">{b.tooltip}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ===== SECTIONS ORDONNÉES — l'ordre varie par site (sectionOrder), aucun élément retiré ===== */}
  {sectionOrder.map((sec) => (
  <Fragment>

  {/* BOUTIQUE PAR RAYON — commerce-first (benchmark objetrama) : réassurance + bons plans + rayons. */}
  {sec === 'shop' && commerceFirst && (
    <section style="padding:88px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px;flex-wrap:wrap">
          <div>
            <span class="hp-pill">La boutique</span>
            <h2 class="serif" style="font-size:clamp(34px,4.5vw,56px);line-height:1.05;font-weight:400;letter-spacing:-.5px;margin-top:14px">
              Nos <em style="font-style:italic">rayons</em>, les meilleurs choix.
            </h2>
          </div>
          <a href="/boutique/" class="link-underline">Toute la boutique</a>
        </div>

        {/* Réassurance commerce (pattern objetrama, version affiliation honnête) */}
        <ul class="hp-shop-reassure">
          <li>🔍 Sélection testée &amp; comparée</li>
          <li>💶 Prix suivis régulièrement</li>
          <li>📦 Livraison via Amazon</li>
          <li>⭐ Notes &amp; avis vérifiés</li>
        </ul>

        {/* Bandeau BONS PLANS — remises réelles, tri par % */}
        {bDeals.length >= 2 && (
          <div class="hp-deals">
            <div class="hp-deals-head">
              <strong>🔥 Bons plans du moment</strong>
              <a href="/bons-plans/" class="link-underline">Toutes les promos</a>
            </div>
            <div class="hp-rub-row">
              {bDeals.map((e) => (
                <a href={`/produit/${e.data.slug}/`} class="hp-prod hp-prod--deal">
                  <div class="hp-prod-img">
                    {bImg(e) ? <img src={bImg(e)} alt={e.data.title} loading="lazy" /> : <span class="hp-prod-ph"></span>}
                    <span class="hp-deal-pct">-{bDisc(e)}%</span>
                  </div>
                  {e.data.brand && <span class="hp-prod-brand">{e.data.brand}</span>}
                  <strong class="hp-prod-title">{e.data.title}</strong>
                  <span class="hp-prod-price"><s class="hp-old">{e.data.oldPrice} €</s> {bPrice(e)}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="hp-rayons">
          {bCats.map((c) => (
            <div class="hp-ray">
              <div class="hp-rub-head">
                <h3 class="serif">{c.label}</h3>
                <a href={`/categorie-produit/${c.slug}/`} class="link-underline">Voir les {c.count} produits</a>
              </div>
              <div class="hp-rub-row">
                {c.top.map((e) => (
                  <a href={`/produit/${e.data.slug}/`} class="hp-prod">
                    <div class="hp-prod-img">{bImg(e) ? <img src={bImg(e)} alt={e.data.title} loading="lazy" /> : <span class="hp-prod-ph"></span>}</div>
                    {e.data.brand && <span class="hp-prod-brand">{e.data.brand}</span>}
                    <strong class="hp-prod-title">{e.data.title}</strong>
                    {bScore(e) > 0 && <span class="hp-prod-rating"><span class="hp-stars">{bStars(bScore(e))}</span> {bScore(e)}</span>}
                    {bPrice(e) && <span class="hp-prod-price">{bPrice(e)}</span>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
        <p style="text-align:center;margin-top:44px;font-size:12px;color:var(--color-text-muted)">Liens partenaires : une commission peut nous être versée, sans surcoût pour vous. Sélection 100&nbsp;% indépendante.</p>
      </div>
    </section>
  )}

  {/* LE BLOG PAR RUBRIQUE — chaque rubrique mise en avant avec ses derniers articles */}
  {sec === 'blog' && blogCats.length > 0 && (
    <section style="padding:88px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div style="text-align:center;margin-bottom:56px;max-width:680px;margin-left:auto;margin-right:auto">
          <span class="hp-pill">Le blog</span>
          <h2 class="serif" style="font-size:clamp(34px,4.5vw,56px);line-height:1.05;font-weight:400;letter-spacing:-.5px;margin-top:16px">
            Nos rubriques, <em style="font-style:italic">article par article</em>.
          </h2>
        </div>
        <div class="hp-rubriques">
          {blogCats.map((c) => (
            <div class="hp-rub">
              <div class="hp-rub-head">
                <h3 class="serif">{c.emoji && <span class="hp-rub-emoji">{c.emoji}</span>}{c.name}</h3>
                <a href={`/categorie/${c.slug}/`} class="link-underline">Voir les {c.articles.length} articles</a>
              </div>
              <div class="hp-rub-row">
                {c.articles.slice(0, 4).map((entry) => {
                  const img = entry.data.heroImage ?? getArticleImage(entry.data.slug);
                  return (
                    <a href={getArticleUrl(entry)} class="hp-art">
                      {img ? (
                        <img src={img} alt={entry.data.title} loading="lazy" />
                      ) : (
                        <div class="hp-art-ph"></div>
                      )}
                      <div class="hp-art-date">{entry.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
                      <h4 class="serif">{entry.data.title}</h4>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
        <div style="text-align:center;margin-top:52px"><a href="/articles/" class="btn-fill">Tous les articles</a></div>
      </div>
    </section>
  )}

  {/* DISCOVER 3 large tiles avec numérotation italique */}
  {sec === 'discover' && profile && profile.tools.length >= 3 && (
    <section style="padding:0">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--color-border)">
        {profile.tools.slice(0, 3).map((tool, idx) => {
          const subject = profile.wikiImageSubjects?.[idx + 1] ?? profile.wikiImageSubjects?.[0];
          const bgImg = subject ? WIKI_IMAGES[subject] : null;
          return (
            <a href={tool.href ?? `/outils/${tool.slug}/`} class="lelo-card" style="position:relative;padding:64px 48px 56px;min-height:480px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden">
              <div>
                <div class="serif italic" style={`font-size:18px;color:var(--color-accent);letter-spacing:1px;margin-bottom:8px`}>
                  N°{idx + 1} — {idx === 0 ? 'Outil principal' : idx === 1 ? 'Aide à l\'achat' : 'Configurateur'}
                </div>
                <h3 class="serif" style="font-size:34px;line-height:1.1;margin:24px 0 16px;font-weight:400;letter-spacing:-.5px">
                  {tool.label.split(' ')[0]} <em style="font-style:italic">{tool.label.split(' ').slice(1).join(' ')}</em>
                </h3>
                <p style="font-size:14px;color:var(--color-text-muted);max-width:300px;line-height:1.65;margin-bottom:28px;position:relative;z-index:2">
                  {tool.description}
                </p>
              </div>
              <span class="link-underline">Découvrir l'outil</span>
              {bgImg && (
                <div style={`position:absolute;right:-30%;bottom:-15%;width:380px;height:380px;border-radius:50%;background-image:url('${bgImg}');background-size:cover;background-position:center;opacity:.18;pointer-events:none`}></div>
              )}
            </a>
          );
        })}
      </div>
    </section>
  )}

  {/* EDITORIAL FEATURE — 5/4 split image + content */}
  {sec === 'editorial' && editorialArticle && (
    <section style="padding:0;background:var(--color-bg-card)">
      <div style="display:grid;grid-template-columns:5fr 4fr;align-items:stretch">
        <div style="position:relative;min-height:560px;overflow:hidden">
          {editorialImg ? (
            <img src={editorialImg} alt={editorialArticle.data.title} loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
          ) : (
            <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
          )}
        </div>
        <div style="padding:96px 64px;display:flex;flex-direction:column;justify-content:center">
          <div class="eyebrow" style="margin-bottom:18px">À la une</div>
          <h2 class="serif" style="font-size:clamp(36px, 4vw, 52px);line-height:1.1;font-weight:400;margin-bottom:24px;letter-spacing:-.5px">
            {editorialArticle.data.title}
          </h2>
          {editorialArticle.data.description && (
            <p style="font-size:16px;color:var(--color-text-muted);line-height:1.7;margin-bottom:32px">
              {editorialArticle.data.description.slice(0, 280)}{editorialArticle.data.description.length > 280 ? '…' : ''}
            </p>
          )}
          <div style="display:flex;gap:32px;margin-bottom:32px;font-size:13px;color:var(--color-text-muted)">
            <div><strong style="display:block;font-weight:600;color:var(--color-ink);font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:4px">Publié</strong>{editorialArticle.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
            <div><strong style="display:block;font-weight:600;color:var(--color-ink);font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:4px">Lecture</strong>~ {Math.max(3, Math.round((editorialArticle.data.description?.length ?? 1000) / 200))} min</div>
          </div>
          <a href={getArticleUrl(editorialArticle)} class="link-underline">Lire l'article</a>
        </div>
      </div>
    </section>
  )}

  {/* DUEL editorial centré */}
  {sec === 'duel' && profile?.matchups && profile.matchups.length > 0 && (
    <section style="background:var(--color-bg-card);padding:140px 0">
