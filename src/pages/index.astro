              <div>
                <div style="position:relative;width:100%;aspect-ratio:1;margin-bottom:24px;overflow:hidden">
                  {bgImg ? (
                    <img src={bgImg} alt={p.name} loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
