                </div>
                <h3 class="serif" style="font-size:30px;line-height:1.1;margin-bottom:8px;letter-spacing:-.3px;font-weight:400">{p.name}</h3>
                <p class="serif italic" style="font-size:15px;color:var(--color-text-muted);margin-bottom:14px">{p.positioning}</p>
                <div class="serif" style="font-size:24px;color:var(--color-ink);font-weight:500">{p.price}</div>
              </div>
            );
          })}
        </div>
        <p class="serif italic" style="font-size:22px;line-height:1.5;color:var(--color-ink);max-width:760px;margin:0 auto 40px;padding:32px 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)">« {profile.matchups[0].conclusion} »</p>
        <a href={`/comparatif/${profile.matchups[0].slug}/`} class="btn-dark">Lire le duel détaillé</a>
      </div>
    </section>
  )}

  {/* AUTHOR section 1.2/1 split */}
  {sec === 'author' && profile?.author && (
    <section style="background:var(--color-bg-card);padding:140px 0">
      <div style="display:grid;grid-template-columns:1fr 1.2fr;gap:96px;align-items:center;max-width:1280px;margin:0 auto;padding:0 32px" class="author-grid">
        <div style="aspect-ratio:3/4;background:var(--color-primary);position:relative">
          {heroImageUrl && (
            <img src={heroImageUrl} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;mix-blend-mode:luminosity;opacity:.6" />
          )}
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-weight:400;font-size:140px;color:rgba(255,255,255,.3);letter-spacing:-4px;font-style:italic">
            {profile.author.name.split(/\s+/).map(n => n[0]).join('').slice(0, 2)}
          </div>
        </div>
        <div>
          <div class="eyebrow" style="margin-bottom:16px">La signature</div>
          <h3 class="serif" style="font-size:64px;line-height:1.05;letter-spacing:-1.5px;margin-bottom:12px;font-weight:400">
            {profile.author.name.split(' ')[0]} <em style="font-style:italic">{profile.author.name.split(' ').slice(1).join(' ')}</em>
          </h3>
          <p class="serif italic" style="font-size:18px;color:var(--color-text-muted);margin-bottom:32px">{profile.author.role} · {profile.author.credentials}</p>
          <p style="font-size:16px;color:var(--color-text);line-height:1.7;margin-bottom:32px;max-width:480px">{profile.author.bio}</p>
          <a href="/equipe-editoriale/" class="link-underline">Voir toute l'équipe</a>
        </div>
      </div>
    </section>
  )}

  {/* NEWSLETTER on dark ink — contraste */}
  {sec === 'newsletter' && (
  <section style="background:var(--color-ink);color:var(--color-bg-base);padding:160px 0">
    <div style="max-width:680px;margin:0 auto;text-align:center;padding:0 32px">
      <div class="eyebrow" style="color:var(--color-secondary);margin-bottom:18px">Newsletter — Édition mensuelle</div>
      <h2 class="serif" style="font-size:clamp(40px, 5vw, 64px);line-height:1.05;letter-spacing:-1px;margin-bottom:24px;color:var(--color-bg-base);font-weight:400">
        Recevez notre <em style="font-style:italic;color:var(--color-secondary)">guide complet</em> en 32 pages.
      </h2>
      <p style="font-size:16px;color:rgba(255,255,255,.8);line-height:1.6;margin-bottom:48px">
        PDF gratuit en échange de votre inscription. Plus une newsletter mensuelle : nouveautés, comparatifs, tests à paraître.
      </p>
      <Newsletter />
    </div>
  </section>
  )}

  {/* ===== SECTIONS SUR-MESURE PAR ARCHÉTYPE (auto-gardées par leurs données) ===== */}

  {/* local_place — CARTE */}
  {sec === 'localMap' && geo && (
    <section style="padding:88px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div style="text-align:center;max-width:680px;margin:0 auto 36px">
          <span class="hp-pill">Sur la carte</span>
          <h2 class="serif" style="font-size:clamp(34px,4.5vw,56px);line-height:1.05;font-weight:400;letter-spacing:-.5px;margin-top:14px">{geo.placename} <em style="font-style:italic">en un coup d'œil</em>.</h2>
        </div>
        <LocalMap lat={geo.lat} lng={geo.lng} placename={geo.placename} region={geo.region} height="420px" />
      </div>
    </section>
  )}

  {/* local_place — MÉTÉO */}
  {sec === 'weather' && geo && (
    <section style="padding:64px 0;background:var(--color-bg-card);border-bottom:1px solid var(--color-border)">
      <div class="site-container" style="max-width:720px"><WeatherWidget /></div>
    </section>
  )}

  {/* local_place — AGENDA */}
  {sec === 'agenda' && agendaEvents.length > 0 && (
    <AgendaHome events={agendaEvents} placename={geo?.placename} siteUrl={SITE_CONFIG.siteUrl} />
  )}

  {/* local_place — ANNUAIRE / VIE PRATIQUE (teaser) — vrai annuaire OSM (nécessite la géo) */}
  {sec === 'annuaireTeaser' && geo && (
    <section style="padding:88px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container" style="text-align:center;max-width:720px">
        <span class="hp-pill">Vie pratique</span>
        <h2 class="serif" style="font-size:clamp(32px,4vw,48px);line-height:1.06;font-weight:400;letter-spacing:-.5px;margin:14px 0 16px">Les bonnes adresses et l'info utile.</h2>
        <p style="color:var(--color-text-muted);line-height:1.7;margin-bottom:28px">Commerces, services, horaires et démarches{geo?.placename ? ` à ${geo.placename}` : ''} : l'essentiel pour le quotidien et pour préparer votre venue.</p>
        <a href="/annuaire/" class="btn-fill">Voir l'annuaire</a>
      </div>
    </section>
  )}

  {/* leadgen — DEVIS */}
  {sec === 'devisCta' && <DevisCta />}

  {/* leadgen — SERVICES × VILLES */}
  {sec === 'servicesVilles' && servicesVilles.length > 0 && (
    <section style="padding:88px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div class="hp-rub-head" style="margin-bottom:30px"><div><span class="hp-pill">Nos prestations</span><h2 class="serif" style="font-size:clamp(32px,4vw,52px);line-height:1.05;font-weight:400;margin-top:14px">Un service, <em style="font-style:italic">près de chez vous</em>.</h2></div></div>
        <div class="hp-rayons">
          {servicesVilles.map((s) => (
            <div class="hp-ray">
              <div class="hp-rub-head"><h3 class="serif">{s.service}</h3></div>
              <div style="display:flex;flex-wrap:wrap;gap:10px">
                {s.villes.slice(0, 12).map((v) => <a href={v.href} class="hp-pill" style="text-transform:none;letter-spacing:0">{v.ville}</a>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* comparateur / leadgen — TOP COMPARATEURS */}
  {sec === 'comparateurTop' && homeComparateurs.length > 0 && (
    <section style="padding:88px 0;background:var(--color-bg-card);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div class="hp-rub-head" style="margin-bottom:30px"><div><span class="hp-pill">Comparateurs</span><h2 class="serif" style="font-size:clamp(32px,4vw,52px);line-height:1.05;font-weight:400;margin-top:14px">On a <em style="font-style:italic">comparé</em> pour vous.</h2></div><a href="/comparateur/" class="link-underline">Tous les comparateurs</a></div>
        <div class="hp-rub-row">
          {homeComparateurs.map((c) => (
            <a href={`/comparateur/${c.data.category}/`} class="hp-art">
              {c.data.heroImage ? <img src={c.data.heroImage} alt={c.data.title} loading="lazy" /> : <div class="hp-art-ph"></div>}
              <h4 class="serif">{c.data.title}</h4>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* leadgen — ÉTUDE DE PRIX */}
  {sec === 'etudePrix' && homePrix.length > 0 && (
    <section style="padding:80px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div class="hp-rub-head" style="margin-bottom:26px"><div><span class="hp-pill">Combien ça coûte ?</span><h2 class="serif" style="font-size:clamp(30px,3.6vw,46px);line-height:1.05;font-weight:400;margin-top:14px">Les prix, sans surprise.</h2></div></div>
        <div class="hp-rub-row">
          {homePrix.map((p) => (
            <a href={`/prix/${p.data.slug}/`} class="hp-art">
              <h4 class="serif">{p.data.title}</h4>
              {p.data.priceRange && <span style="font-size:13px;color:var(--color-accent);font-weight:600">{p.data.priceRange}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* leadgen — ZONES D'INTERVENTION (carte) */}
  {sec === 'zonesIntervention' && geo && (
    <section style="padding:80px 0;background:var(--color-bg-card);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div style="text-align:center;max-width:640px;margin:0 auto 30px"><span class="hp-pill">Zones d'intervention</span><h2 class="serif" style="font-size:clamp(30px,3.6vw,46px);line-height:1.05;font-weight:400;margin-top:14px">On intervient autour de {geo.placename}.</h2></div>
        <LocalMap lat={geo.lat} lng={geo.lng} placename={geo.placename} region={geo.region} height="380px" />
      </div>
    </section>
  )}

  {/* leadgen — AVIS CLIENTS */}
  {sec === 'avisClients' && clientAvis.length > 0 && (
    <section style="padding:88px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div style="text-align:center;max-width:640px;margin:0 auto 36px"><span class="hp-pill">Ils nous ont fait confiance</span><h2 class="serif" style="font-size:clamp(32px,4vw,52px);line-height:1.05;font-weight:400;margin-top:14px">Avis clients.</h2></div>
        <div class="hp-rub-row">
          {clientAvis.map((a) => (
            <blockquote style="background:var(--color-bg-card);border:1px solid var(--color-border);border-radius:16px;padding:24px;margin:0">
              <div style="color:#e0a800;letter-spacing:-1px;margin-bottom:10px">{'★'.repeat(Math.round(a.note))}<span style="color:var(--color-border)">{'★'.repeat(5 - Math.round(a.note))}</span></div>
              <p style="font-size:14px;line-height:1.6;color:var(--color-text);margin:0 0 12px">« {a.texte} »</p>
              <footer style="font-size:12px;color:var(--color-text-muted);font-weight:600">{a.auteur}{a.ville ? ` · ${a.ville}` : ''}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* commerce / comparateur — GUIDES D'ACHAT */}
  {sec === 'guidesAchat' && homeGuides.length > 0 && (
    <section style="padding:88px 0;background:var(--color-bg-card);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div class="hp-rub-head" style="margin-bottom:30px"><div><span class="hp-pill">Guides d'achat</span><h2 class="serif" style="font-size:clamp(32px,4vw,52px);line-height:1.05;font-weight:400;margin-top:14px">Bien <em style="font-style:italic">choisir</em>.</h2></div><a href="/guide/" class="link-underline">Tous les guides</a></div>
        <div class="hp-rub-row">
          {homeGuides.map((g) => (
            <a href={`/guide/${g.data.slug}/`} class="hp-art">
              {g.data.heroImage ? <img src={g.data.heroImage} alt={g.data.title} loading="lazy" /> : <div class="hp-art-ph"></div>}
              <h4 class="serif">{g.data.title}</h4>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* commerce / comparateur — AVIS MARQUES */}
  {sec === 'avisMarques' && homeAvisMarques.length > 0 && (
    <section style="padding:88px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container">
        <div class="hp-rub-head" style="margin-bottom:30px"><div><span class="hp-pill">Avis &amp; tests</span><h2 class="serif" style="font-size:clamp(32px,4vw,52px);line-height:1.05;font-weight:400;margin-top:14px">Marques au <em style="font-style:italic">banc d'essai</em>.</h2></div><a href="/avis/" class="link-underline">Tous les avis</a></div>
        <div class="hp-rub-row">
          {homeAvisMarques.map((a) => (
            <a href={`/avis/${a.data.slug}/`} class="hp-art">
              {a.data.heroImage ? <img src={a.data.heroImage} alt={a.data.title} loading="lazy" /> : <div class="hp-art-ph"></div>}
              <h4 class="serif">{a.data.title}</h4>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* tool_utility — OUTIL CENTRAL */}
  {sec === 'toolEmbed' && <ToolEmbed tool={mainTool} />}

  {/* tool_utility — FAQ teaser */}
  {sec === 'faqHome' && (
    <section style="padding:80px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
      <div class="site-container" style="text-align:center;max-width:680px">
        <span class="hp-pill">Questions fréquentes</span>
        <h2 class="serif" style="font-size:clamp(30px,3.6vw,46px);line-height:1.05;font-weight:400;margin:14px 0 16px">Vous vous demandez…</h2>
        <p style="color:var(--color-text-muted);line-height:1.7;margin-bottom:24px">Tout ce qu'il faut savoir pour bien utiliser {SITE_CONFIG.siteName}.</p>
        <a href="/faq/" class="btn-fill">Voir la FAQ</a>
      </div>
    </section>
  )}

  </Fragment>
  ))}
</div>
</Base>

<style>
/* Blog par rubrique + Boutique par rayon (homepage) */
.hp-rubriques, .hp-rayons { display: flex; flex-direction: column; gap: 56px; }
.hp-rub-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding-bottom: 16px; margin-bottom: 26px; border-bottom: 1px solid var(--color-border); flex-wrap: wrap; }
.hp-rub-head h3 { font-size: clamp(22px, 2.4vw, 30px); font-weight: 400; letter-spacing: -.3px; margin: 0; display: flex; align-items: center; gap: 12px; line-height: 1.1; }
.hp-rub-emoji { font-size: .9em; }
.hp-rub-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }

/* Carte article */
.hp-art { text-decoration: none; color: inherit; display: block; }
.hp-art img, .hp-art-ph { width: 100%; aspect-ratio: 5/4; object-fit: cover; margin-bottom: 14px; display: block; border-radius: 16px; transition: box-shadow .2s, transform .2s; }
.hp-art:hover img { box-shadow: 0 16px 36px rgba(0,0,0,.10); transform: translateY(-2px); }
.hp-art-ph { background: linear-gradient(135deg, var(--color-bg-2), var(--color-border)); }
.hp-art-date { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 6px; }
.hp-art h4 { font-size: 17px; line-height: 1.25; font-weight: 400; letter-spacing: -.2px; margin: 0; transition: color .2s; }
.hp-art:hover h4 { color: var(--color-accent); }

/* Carte produit */
.hp-prod { display: flex; flex-direction: column; gap: 5px; text-decoration: none; color: inherit; background: var(--color-bg-card, #fff); border: 1px solid var(--color-border); border-radius: 16px; padding: 14px; transition: transform .15s, box-shadow .15s; }
.hp-prod:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(0,0,0,.08); }
.hp-prod-img { aspect-ratio: 4/3; background: #fff; border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 8px; }
.hp-prod-img img { width: 100%; height: 100%; object-fit: contain; padding: 12px; transition: transform .3s; }
.hp-prod:hover .hp-prod-img img { transform: scale(1.05); }
.hp-prod-ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-bg-2), var(--color-border)); }
.hp-prod-brand { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--color-text-muted); font-weight: 600; }
.hp-prod-title { font-size: 15px; font-weight: 500; line-height: 1.25; }
.hp-prod-rating { font-size: 12px; color: var(--color-text-muted); }
.hp-stars { color: #e0a800; letter-spacing: -1px; }
.hp-prod-price { font-size: 16px; font-weight: 700; color: var(--color-ink); margin-top: 2px; }

/* Commerce-first : réassurance + bons plans (benchmark objetrama) */
.hp-shop-reassure { list-style: none; margin: 0 0 36px; padding: 14px 18px; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 13px; color: var(--color-text-muted); background: var(--color-bg-2, #f6f3ee); border: 1px solid var(--color-border); border-radius: 14px; }
.hp-deals { margin-bottom: 52px; padding: 22px; border: 1px solid var(--color-border); border-radius: 18px; background: var(--color-bg-card, #fff); }
.hp-deals-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
.hp-deals-head strong { font-size: 18px; letter-spacing: -.2px; }
.hp-prod--deal .hp-prod-img { position: relative; }
.hp-deal-pct { position: absolute; top: 6px; right: 6px; background: #b0654f; color: #fff; font-weight: 800; border-radius: 7px; padding: 2px 8px; font-size: 13px; }
.hp-old { font-weight: 500; color: var(--color-text-muted); font-size: 12.5px; margin-right: 6px; }

/* Pill badge (signature ionomat) — remplace les eyebrows */
.hp-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--color-bg-2, #f1ece4); color: var(--color-accent); border: 1px solid var(--color-border); border-radius: 999px; padding: 6px 16px; font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; }

/* Benefit cards sous le hero (signature ionomat) */
.hp-benefits-wrap { padding: 56px 0; background: var(--color-bg-base); border-bottom: 1px solid var(--color-border); }
.hp-benefits { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.hp-benefit { background: var(--color-bg-card, #fff); border: 1px solid var(--color-border); border-radius: 18px; padding: 30px 24px; text-align: center; transition: transform .15s, box-shadow .15s; }
.hp-benefit:hover { transform: translateY(-3px); box-shadow: 0 16px 38px rgba(0,0,0,.07); }
.hp-benefit-ico { display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 15px; background: var(--color-bg-2, #f1ece4); font-size: 25px; margin-bottom: 16px; }
.hp-benefit-title { display: block; font-size: 16px; font-weight: 600; color: var(--color-ink); margin-bottom: 8px; letter-spacing: -.2px; }
.hp-benefit-desc { font-size: 13px; color: var(--color-text-muted); line-height: 1.55; margin: 0; }
@media (max-width: 900px) { .hp-benefits { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .hp-benefits { grid-template-columns: 1fr; } }

@media (max-width: 1000px) { .hp-rub-row { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
@media (max-width: 540px) { .hp-rub-row { grid-template-columns: 1fr 1fr; gap: 14px; } .hp-art h4 { font-size: 14px; } .hp-prod-title { font-size: 13.5px; } }

@media(max-width:900px) {
  section[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr !important; }
  section[style*="grid-template-columns:repeat(2,1fr)"] { grid-template-columns: 1fr !important; }
  section[style*="grid-template-columns:5fr 4fr"] { grid-template-columns: 1fr !important; }
  section[style*="grid-template-columns:1fr 1.2fr"] { grid-template-columns: 1fr !important; gap: 48px !important; }
  .duel-products-grid { grid-template-columns: 1fr !important; gap: 40px !important; }
  .author-grid { grid-template-columns: 1fr !important; gap: 48px !important; }
  h1 { font-size: 44px !important; }
  h2 { font-size: 32px !important; }
}
</style>
