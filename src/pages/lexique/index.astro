---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const termes = (await getCollection('lexique')).sort((a, b) => a.data.term.localeCompare(b.data.term, 'fr'));
const byCategory = termes.reduce<Record<string, typeof termes>>((acc, t) => {
  (acc[t.data.category] ||= []).push(t);
  return acc;
}, {});
const categoryLabels: Record<string, string> = {
  cuisson: 'Cuisson',
  technique: 'Techniques',
  ingrédient: 'Ingrédients',
  ustensile: 'Ustensiles',
  service: 'Service',
  autre: 'Autres',
};
---
<Base
  title="Lexique culinaire italien — Tous les termes expliqués"
  description="Lexique illustré de la cuisine italienne : al dente, soffritto, mantecatura, antipasto, 'nduja... 300+ termes techniques expliqués en français, avec prononciation et exemples d'usage."
>
  <section class="mx-auto max-w-7xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Lexique' }]} />

    <header class="mb-12 max-w-3xl">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Encyclopédie</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Lexique culinaire italien
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Les mots italiens de la cuisine, expliqués en français. Avec prononciation, exemples d'usage, et liens vers les techniques associées.
      </p>
    </header>

    {Object.entries(byCategory).map(([cat, items]) => (
      <div class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-4 border-b border-cream-200 pb-2">
          {categoryLabels[cat] ?? cat}
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((terme) => (
            <a href={`/lexique/${terme.id}`} class="group rounded-lg border border-cream-200 bg-white p-5 hover:border-terra-300 hover:shadow-sm transition flex flex-col">
              <h3 class="font-serif text-2xl text-ink-900 mb-1 group-hover:text-terra-700 transition">{terme.data.term}</h3>
              {terme.data.pronunciation && (
                <p class="text-xs text-olive-700 italic font-mono mb-3">/ {terme.data.pronunciation} /</p>
              )}
              <p class="text-sm text-ink-700/80 line-clamp-3">{terme.data.definition}</p>
            </a>
          ))}
        </div>
      </div>
    ))}

    <p class="text-sm text-ink-700/60 mt-12">
      Au total : {termes.length} termes publiés. Le lexique est enrichi régulièrement.
    </p>
  </section>
</Base>
