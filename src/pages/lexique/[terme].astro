---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const termes = await getCollection('lexique');
  return termes.map((t) => ({ params: { terme: t.id }, props: { terme: t } }));
}

const { terme } = Astro.props;
const { Content } = await render(terme);
---
<Base
  title={`${terme.data.term} — ${terme.data.definition.slice(0, 60)}...`}
  description={terme.data.definition}
  type="article"
  publishedAt={terme.data.publishedAt}
  updatedAt={terme.data.updatedAt}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'DefinedTerm',
      '@id': `https://darocco.fr/lexique/${terme.id}#term`,
      name: terme.data.term,
      description: terme.data.definition,
      termCode: terme.id,
      inDefinedTermSet: {
        '@type': 'DefinedTermSet',
        '@id': 'https://darocco.fr/lexique#set',
        name: 'Lexique culinaire italien',
        url: 'https://darocco.fr/lexique',
      },
      ...(terme.data.category ? { additionalType: terme.data.category } : {}),
    },
  ]}
>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Lexique', href: '/lexique' }, { label: terme.data.term }]} />

    <header class="mb-10">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">{terme.data.category}</p>
      <div class="flex items-baseline gap-4 flex-wrap">
        <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight">{terme.data.term}</h1>
        <button
          type="button"
          id="pronounce-btn"
          data-term={terme.data.term}
          class="rounded-full border border-terra-300 bg-white text-terra-700 hover:bg-terra-50 transition px-4 py-1.5 text-sm font-medium flex items-center gap-2"
          aria-label={`Écouter la prononciation de ${terme.data.term}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/></svg>
          Écouter
        </button>
      </div>
      {terme.data.pronunciation && (
        <p class="text-lg text-olive-700 italic font-mono mt-2">/ {terme.data.pronunciation} /</p>
      )}
    </header>

    <script is:inline>
      // Web Speech API native — gratuit, pas d'appel serveur. La voix italienne
      // se charge depuis le système (toutes les OS modernes en ont une).
      (function () {
        const btn = document.getElementById('pronounce-btn');
        if (!btn || !('speechSynthesis' in window)) {
          if (btn) btn.style.display = 'none';
          return;
        }
        let voiceIt = null;
        function pickItalianVoice() {
          const voices = speechSynthesis.getVoices();
          voiceIt = voices.find((v) => v.lang === 'it-IT') ||
                    voices.find((v) => v.lang.startsWith('it')) ||
                    voices[0] || null;
        }
        pickItalianVoice();
        // Sur certains navigateurs, getVoices() est async — on hooke le change
        speechSynthesis.addEventListener('voiceschanged', pickItalianVoice);

        btn.addEventListener('click', () => {
          const term = btn.dataset.term;
          if (!term) return;
          speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(term);
          u.lang = 'it-IT';
          if (voiceIt) u.voice = voiceIt;
          u.rate = 0.85;
          speechSynthesis.speak(u);
        });
      })();
    </script>

    <p class="text-lg text-ink-700 leading-relaxed mb-8 border-l-4 border-terra-500 pl-5">
      {terme.data.definition}
    </p>

    {terme.data.example && (
      <p class="rounded-lg bg-cream-100 border border-cream-200 p-5 italic text-ink-700 mb-8">
        <span class="block text-xs uppercase tracking-widest text-olive-700 not-italic mb-1">Exemple d'usage</span>
        {terme.data.example}
      </p>
    )}

    <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-ink-900 prose-a:text-terra-700">
      <Content />
    </div>
  </article>
</Base>
