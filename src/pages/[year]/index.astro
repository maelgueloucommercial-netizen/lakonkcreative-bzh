---
import Base from '../../layouts/Base.astro';
import { SITE_CONFIG } from '../../lib/site-config';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const byYear = new Map<string, typeof articles>();
  for (const a of articles) {
    if (!a.data.urlYear) continue;
    const y = String(a.data.urlYear);
    if (!byYear.has(y)) byYear.set(y, [] as typeof articles);
    byYear.get(y)!.push(a);
  }
  return [...byYear.entries()].map(([year, arts]) => ({
    params: { year },
    props: { year, articles: arts },
  }));
}

const { year, articles } = Astro.props as { year: string; articles: any[] };
articles.sort((a: any, b: any) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function getArticleUrl(entry: any): string {
  const d = entry.data;
  if (d.dateUrlFormat) {
    return `/${d.urlYear}/${String(d.urlMonth).padStart(2, '0')}/${String(d.urlDay).padStart(2, '0')}/${d.slug}/`;
  }
  return d.urlPath ? `/${d.urlPath}/${d.slug}/` : `/${d.slug}/`;
}

const byMonth = new Map<string, any[]>();
for (const a of articles) {
  const m = String(a.data.urlMonth).padStart(2, '0');
  if (!byMonth.has(m)) byMonth.set(m, []);
  byMonth.get(m)!.push(a);
}
const monthLabels: Record<string, string> = {
  '01': 'janvier', '02': 'février', '03': 'mars', '04': 'avril',
  '05': 'mai', '06': 'juin', '07': 'juillet', '08': 'août',
  '09': 'septembre', '10': 'octobre', '11': 'novembre', '12': 'décembre',
};
const sortedMonths = [...byMonth.keys()].sort().reverse();
---
<Base
  title={`Archives ${year}`}
  description={`Tous les articles publiés en ${year} sur ${SITE_CONFIG.siteName} (${articles.length} articles).`}
>

  {/* Hero éditorial */}
  <section style="padding:96px 0 64px;background:var(--color-bg-card);border-bottom:1px solid var(--color-border)">
    <div class="site-container site-container--narrow">
      <nav style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:24px;font-weight:600" aria-label="Fil d'Ariane">
        <a href="/" style="color:var(--color-text-muted);text-decoration:none">Accueil</a>
        <span style="margin:0 12px;color:var(--color-border)">/</span>
        <a href="/articles/" style="color:var(--color-text-muted);text-decoration:none">Articles</a>
        <span style="margin:0 12px;color:var(--color-border)">/</span>
        <span style="color:var(--color-accent)">{year}</span>
      </nav>
      <div class="eyebrow" style="margin-bottom:18px">Archives</div>
      <h1 class="serif" style="font-size:clamp(48px, 7vw, 120px);line-height:.98;font-weight:400;margin-bottom:24px;letter-spacing:-2px;font-style:italic;color:var(--color-accent)">
        {year}
      </h1>
      <p style="font-size:17px;line-height:1.7;color:var(--color-text-muted)">
        <strong style="color:var(--color-ink);font-weight:500">{articles.length}</strong> article{articles.length > 1 ? 's' : ''} publié{articles.length > 1 ? 's' : ''}.
      </p>
    </div>
  </section>

  {/* Mois et articles */}
  <section style="padding:80px 0 96px;background:var(--color-bg-base)">
    <div class="site-container site-container--narrow">
      {sortedMonths.map((m, idx) => (
        <section style={`padding:${idx === 0 ? '0' : '64px'} 0 64px;${idx > 0 ? 'border-top:1px solid var(--color-border)' : ''};display:grid;grid-template-columns:200px 1fr;gap:48px;align-items:start`} class="archive-row">
          <div style="position:sticky;top:120px">
            <a href={`/${year}/${m}/`} style="text-decoration:none;color:inherit">
              <div class="serif" style="font-size:48px;line-height:1.1;font-weight:400;font-style:italic;letter-spacing:-1px;color:var(--color-ink);text-transform:capitalize">{monthLabels[m]}</div>
              <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-accent);margin-top:8px;font-weight:600">{byMonth.get(m)!.length} article{byMonth.get(m)!.length > 1 ? 's' : ''} →</div>
            </a>
          </div>
          <ul style="list-style:none;padding:0;margin:0;border-top:1px solid var(--color-border)">
            {byMonth.get(m)!.slice(0, 8).map((a) => (
              <li style="border-bottom:1px solid var(--color-border)">
                <a href={getArticleUrl(a)} style="display:grid;grid-template-columns:1fr auto;gap:24px;align-items:baseline;padding:20px 0;text-decoration:none;color:inherit">
                  <span class="serif" style="font-size:20px;line-height:1.3;font-weight:400;letter-spacing:-.2px">{a.data.title}</span>
                  <time style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);font-weight:600;white-space:nowrap">{a.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}</time>
                </a>
              </li>
            ))}
            {byMonth.get(m)!.length > 8 && (
              <li style="border-bottom:1px solid var(--color-border);padding:20px 0">
                <a href={`/${year}/${m}/`} class="link-underline">
                  Voir les {byMonth.get(m)!.length - 8} articles supplémentaires →
                </a>
              </li>
            )}
          </ul>
        </section>
      ))}
    </div>
  </section>

</Base>
<style>
@media (max-width: 900px) {
  .archive-row { grid-template-columns: 1fr !important; gap: 16px !important; }
  .archive-row > div:first-child { position: static !important; }
}
</style>
