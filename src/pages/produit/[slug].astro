---
/**
 * Type de page : ficheProduit (archétype product_catalogue) — DESIGN v3 style IONOMAT.
 * Préférence Mael 2026-06-04 : fiche = verdict/note rédaction + recommandation + critères
 * notés + pros/cons (look ionomat) EN PLUS du buy-box + specs + avis clients + FAQ.
 * Patterns concurrents (Boulanger/Darty/ManoMano/RTINGS/Les Numériques) : above-fold galerie +
 * buy-box STICKY (prix+barré+-%, multi-marchand affilié), verdict + score, critères, pros/cons,
 * specs, description longue (≥2000 mots), avis (note + distribution), cross-sell, FAQ.
 * URL : /produit/{slug}/. Schemas Product + Offer/AggregateOffer + AggregateRating + Review + Breadcrumb + FAQPage.
 * Données réelles + affiliation (amazon.fr ... ?tag=guelou-21, rel="sponsored nofollow").
 */
import Base from '../../layouts/Base.astro';
import { SITE_CONFIG } from '../../lib/site-config';
import { render, getCollection, type CollectionEntry } from 'astro:content';
import '../../styles/templates.css';

export async function getStaticPaths() {
  const entries = await getCollection('produits');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, all: entries } }));
}

const { entry, all } = Astro.props as { entry: CollectionEntry<'produits'>; all: CollectionEntry<'produits'>[] };
const d = entry.data;
const { Content } = await render(entry);
const pageUrl = new URL(Astro.url.pathname, SITE_CONFIG.siteUrl).toString();
const related = (d.relatedSlugs.length ? all.filter((e) => d.relatedSlugs.includes(e.data.slug)) : all.filter((e) => e.data.category === d.category && e.data.slug !== d.slug)).slice(0, 4);
// Maillage transversal (pattern objetrama « Vous pouvez également le trouver dans ») :
// autres rayons + bons plans → chaque fiche irrigue le reste du silo boutique.
const _ocSeen = new Set<string>([d.category]);
const otherCats = all.filter((e) => { const c = e.data.category; if (_ocSeen.has(c)) return false; _ocSeen.add(c); return true; })
  .map((e) => ({ slug: e.data.category, label: e.data.categoryLabel ?? e.data.category })).slice(0, 4);
const anyDeals = all.some((e) => typeof e.data.oldPrice === 'number' && typeof e.data.price === 'number' && e.data.oldPrice > e.data.price);
const priceLabel = d.priceText ?? (typeof d.priceLow === 'number' && typeof d.priceHigh === 'number' ? `${d.priceLow} – ${d.priceHigh} €` : (typeof d.price === 'number' ? `${d.price} €` : null));
const discount = (typeof d.oldPrice === 'number' && typeof d.price === 'number' && d.oldPrice > d.price) ? Math.round((1 - d.price / d.oldPrice) * 100) : null;
const stars = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
const bars = d.ratingBars.length === 5 ? d.ratingBars : [];
const recoLabel: Record<string, string> = { recommande: '✓ Recommandé', reserves: '~ Avec réserves', eviter: '✗ À éviter' };
const recoClass: Record<string, string> = { recommande: 'reco-ok', reserves: 'reco-warn', eviter: 'reco-bad' };
const firstCta = d.merchants[0]?.url ?? d.ctaUrl;

const reviews: Record<string, unknown>[] = [];
if (typeof d.scoreGlobal === 'number') reviews.push({ '@type': 'Review', author: { '@type': 'Organization', name: SITE_CONFIG.siteName }, reviewRating: { '@type': 'Rating', ratingValue: d.scoreGlobal, bestRating: 5 }, ...(d.verdict ? { reviewBody: d.verdict } : {}), datePublished: d.pubDate.toISOString().slice(0, 10) });
if (d.avis) for (const a of d.avis) reviews.push({ '@type': 'Review', author: { '@type': 'Person', name: a.auteur }, reviewRating: { '@type': 'Rating', ratingValue: a.note, bestRating: 5 }, reviewBody: a.texte });

const product: Record<string, unknown> = {
  '@type': 'Product', name: d.title, description: d.description,
  ...(d.images.length ? { image: d.images } : {}), ...(d.brand ? { brand: { '@type': 'Brand', name: d.brand } } : {}), ...(d.sku ? { sku: d.sku } : {}),
  ...(typeof d.priceLow === 'number'
    ? { offers: { '@type': 'AggregateOffer', lowPrice: d.priceLow, ...(typeof d.priceHigh === 'number' ? { highPrice: d.priceHigh } : {}), priceCurrency: d.currency, offerCount: Math.max(d.merchants.length, 1), availability: d.availability } }
    : (typeof d.price === 'number' ? { offers: { '@type': 'Offer', price: d.price, priceCurrency: d.currency, availability: d.availability, url: firstCta ?? pageUrl } } : {})),
  ...(typeof d.rating === 'number' && d.reviewCount ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: d.rating, reviewCount: d.reviewCount, bestRating: 5 } } : {}),
  ...(reviews.length ? { review: reviews } : {}),
};
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_CONFIG.siteUrl },
  { '@type': 'ListItem', position: 2, name: d.categoryLabel ?? d.category, item: new URL(`/categorie-produit/${d.category}/`, SITE_CONFIG.siteUrl).toString() },
  { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl } ] };
const jsonLd: Record<string, unknown>[] = [{ '@context': 'https://schema.org', ...product }, breadcrumb];
if (d.faq && d.faq.length) jsonLd.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) });
---
<Base title={d.title} description={d.description} canonical={pageUrl} ogImage={d.images[0]} type="website" jsonLd={jsonLd} noindex={d.noindex} pubDate={d.pubDate} modifiedDate={d.modifiedDate}>
  <div class="pr">
    <div class="tpl-bcband"><nav class="tpl-wrap tpl-bc" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href={`/categorie-produit/${d.category}/`}>{d.categoryLabel ?? d.category}</a> › <span>{d.title}</span></nav></div>

    {/* ABOVE-FOLD : galerie | buy-box sticky (verdict + score + reco + CTA affilié) */}
    <section class="tpl-band"><div class="tpl-wrap pr-top">
      <div class="pr-gallery">
        {d.images[0] && <img class="pr-main-img" src={d.images[0]} alt={d.title} width="560" height="420" />}
        {d.images.length > 1 && <div class="pr-thumbs">{d.images.slice(0, 6).map((im, i) => <img src={im} alt={`${d.title} ${i + 1}`} loading="lazy" width="72" height="54" />)}</div>}
      </div>
      <aside class="pr-buy">
        {d.badge && <span class="tpl-badge pr-badge">{d.badge}</span>}
        <h1>{d.title}</h1>
        {d.brand && <p class="pr-brand">{d.brand}</p>}
        {typeof d.scoreGlobal === 'number' && (
          <div class="pr-edscore"><span class="pr-edscore-num">{d.scoreGlobal.toFixed(1)}<small>/5</small></span><span class="tpl-stars">{stars(d.scoreGlobal)}</span><span class="pr-edscore-lbl">Note de la rédaction</span></div>
        )}
        {d.recommendation && <div class={`pr-reco ${recoClass[d.recommendation]}`}>{recoLabel[d.recommendation]}</div>}
        {typeof d.rating === 'number' && <p class="pr-rating"><span class="tpl-stars">{stars(d.rating)}</span> {d.rating}/5{d.reviewCount ? ` · ${d.reviewCount} avis clients` : ''}</p>}
        {d.verdict && <p class="pr-verdict">{d.verdict}</p>}
        <div class="pr-price">{d.oldPrice && <span class="pr-old">{d.oldPrice} €</span>}{priceLabel && <span class="pr-now">{priceLabel}</span>}{discount && <span class="pr-disc">-{discount}%</span>}</div>
        {d.merchants.length > 1 && <p class="pr-multi">Comparez {d.merchants.length} marchands</p>}
        {d.variants.length > 0 && (<label class="pr-variant">{d.variants[0].label}<select>{d.variants.map((v) => <option>{v.value}</option>)}</select></label>)}
        <div class="pr-cta">
          {d.merchants.length > 0
            ? d.merchants.map((m) => <a href={m.url} rel="sponsored nofollow" class="tpl-btn tpl-btn-amber tpl-btn-full">{m.name}{m.price ? ` · ${m.price}` : ''}</a>)
            : (d.ctaUrl && <a href={d.ctaUrl} rel="sponsored nofollow" class="tpl-btn tpl-btn-amber tpl-btn-full">{d.ctaLabel}</a>)}
        </div>
        <ul class="pr-reassure"><li>✓ Paiement sécurisé</li><li>✓ Livraison rapide</li><li>✓ Retours gratuits</li></ul>
        {d.usps.length > 0 && <ul class="pr-usps">{d.usps.map((u) => <li>✓ {u}</li>)}</ul>}
        <p class="tpl-mini pr-disclo">Lien partenaire : une commission peut nous être versée, sans surcoût pour vous.</p>
      </aside>
    </div></section>

    {/* VERDICT + CRITÈRES + PROS/CONS (style ionomat) */}
    {(d.verdict || d.criteria.length > 0 || d.pros.length > 0 || d.cons.length > 0 || d.bestFor) && (
      <section class="tpl-band tpl-band--tint"><div class="tpl-wrap pr-review">
        <div class="pr-review-main">
          <span class="tpl-eyebrow">Notre test</span><h2 class="tpl-h2">Notre avis sur le {d.title}</h2>
          {d.verdict && <p class="tpl-lead">{d.verdict}</p>}
          {d.bestFor && <p class="pr-bestfor"><strong>Idéal pour :</strong> {d.bestFor}</p>}
          {d.criteria.length > 0 && (
            <div class="pr-crits">{d.criteria.map((c) => (
              <div class="pr-crit"><div class="pr-crit-head"><span>{c.label}</span><span class="tpl-stars">{stars(c.note)}</span><b>{c.note.toFixed(1)}</b></div>{c.comment && <p>{c.comment}</p>}</div>
            ))}</div>
          )}
        </div>
        {(d.pros.length > 0 || d.cons.length > 0) && (
          <div class="pr-procons">
            {d.pros.length > 0 && <div class="pr-pros tpl-card"><h3>✓ On aime</h3><ul>{d.pros.map((p) => <li>{p}</li>)}</ul></div>}
            {d.cons.length > 0 && <div class="pr-cons tpl-card"><h3>✗ On aime moins</h3><ul>{d.cons.map((c) => <li>{c}</li>)}</ul></div>}
            {firstCta && <a href={firstCta} rel="sponsored nofollow" class="tpl-btn tpl-btn-amber tpl-btn-full pr-procons-cta">Voir le meilleur prix</a>}
          </div>
        )}
      </div></section>
    )}

    {/* SPECS */}
    {d.specs.length > 0 && (
      <section class="tpl-band"><div class="tpl-wrap tpl-wrap--narrow">
        <span class="tpl-eyebrow">Caractéristiques</span><h2 class="tpl-h2">Fiche technique</h2>
        <table class="tpl-table pr-specs"><tbody>{d.specs.map((s) => (<tr><th>{s.label}</th><td>{s.value}</td></tr>))}</tbody></table>
      </div></section>
    )}

    {/* DESCRIPTION (markdown, ≥2000 mots) */}
    <section class="tpl-band tpl-band--tint"><div class="tpl-wrap tpl-wrap--narrow tpl-prose"><span class="tpl-eyebrow">Test détaillé</span><Content /></div></section>

    {/* AVIS clients + distribution */}
    {(d.avis && d.avis.length > 0) && (
      <section class="tpl-band"><div class="tpl-wrap">
        <span class="tpl-eyebrow">Avis clients</span><h2 class="tpl-h2">Ce qu'en disent les acheteurs{typeof d.rating === 'number' ? ` — ${d.rating}/5` : ''}</h2>
        <div class="pr-reviews-wrap">
          {bars.length === 5 && (
            <div class="pr-dist">{[5, 4, 3, 2, 1].map((star, i) => (<div class="pr-distrow"><span>{star}★</span><div class="pr-bar"><div style={`width:${bars[i]}%`}></div></div><span>{bars[i]}%</span></div>))}</div>
          )}
          <div class="pr-reviews">{d.avis.map((a) => (<blockquote class="tpl-card pr-rev"><div class="tpl-stars">{stars(a.note)}</div><p>« {a.texte} »</p><cite>— {a.auteur}{a.date ? `, ${a.date}` : ''}{' · '}<span class="pr-verified">Achat vérifié</span></cite></blockquote>))}</div>
        </div>
      </div></section>
    )}

    {/* CROSS-SELL */}
    {related.length > 0 && (
      <section class="tpl-band tpl-band--tint"><div class="tpl-wrap">
        <span class="tpl-eyebrow">À comparer</span><h2 class="tpl-h2">Autres modèles de la catégorie</h2>
        <div class="tpl-grid">{related.map((e) => (
          <a class="tpl-card pr-rcard" href={`/produit/${e.data.slug}/`}>{e.data.images[0] && <img src={e.data.images[0]} alt={e.data.title} loading="lazy" width="160" height="120" />}<strong>{e.data.title}</strong>{(e.data.priceText ?? (typeof e.data.price === 'number' ? `${e.data.price} €` : '')) && <span class="pr-rprice">{e.data.priceText ?? `${e.data.price} €`}</span>}</a>
        ))}</div>
      </div></section>
    )}

    {/* FAQ */}
    {d.faq && d.faq.length > 0 && (
      <section class="tpl-band"><div class="tpl-wrap tpl-wrap--narrow">
        <span class="tpl-eyebrow">FAQ</span><h2 class="tpl-h2">Questions fréquentes</h2>
        <div class="tpl-faq">{d.faq.map((f) => (<details><summary>{f.question}</summary><p>{f.answer}</p></details>))}</div>
      </div></section>
    )}

    {/* MAILLAGE TRANSVERSAL — « Se trouve aussi dans » (pattern objetrama) */}
    <section class="tpl-band tpl-band--tint" style="padding-top:1.6rem;padding-bottom:1.8rem"><div class="tpl-wrap">
      <strong class="pr-also-title">Se trouve aussi dans</strong>
      <ul class="pr-also">
        <li><a href={`/categorie-produit/${d.category}/`}>{d.categoryLabel ?? d.category}</a></li>
        {discount && anyDeals && <li><a href="/bons-plans/" class="pr-also-deal">🔥 Bons plans</a></li>}
        {otherCats.map((c) => <li><a href={`/categorie-produit/${c.slug}/`}>{c.label}</a></li>)}
        <li><a href="/boutique/"><strong>Toute la boutique →</strong></a></li>
      </ul>
    </div></section>
  </div>

  {/* STICKY BUY-BAR mobile — prix + CTA affilié toujours visibles (levier clics sortants) */}
  {firstCta && (
    <div class="pr-stickybar" aria-hidden="false">
      {d.images[0] && <img src={d.images[0]} alt="" width="44" height="44" loading="lazy" />}
      <div class="pr-stickybar-txt">
        {priceLabel && <strong>{priceLabel}</strong>}
        {typeof d.scoreGlobal === 'number' && <small>★ {d.scoreGlobal}/5 rédaction</small>}
      </div>
      <a href={firstCta} rel="sponsored nofollow" class="pr-stickybar-cta">{d.merchants[0]?.name ?? d.ctaLabel ?? 'Voir le prix'}</a>
    </div>
  )}
</Base>

<style>
  .pr-top { display: grid; grid-template-columns: 1.1fr .9fr; gap: 2rem; align-items: start; }
  .pr-main-img { width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--site-border); object-fit: contain; background: #fff; }
  .pr-thumbs { display: flex; gap: .4rem; margin-top: .5rem; flex-wrap: wrap; }
  .pr-thumbs img { border-radius: 8px; border: 1px solid var(--site-border); object-fit: contain; background: #fff; cursor: pointer; }
  .pr-buy { position: sticky; top: 1rem; background: var(--site-bg-card); border: 1px solid var(--site-border); border-radius: 16px; padding: 1.4rem; box-shadow: 0 4px 14px rgba(20,50,90,.06); }
  .pr-badge { margin-bottom: .5rem; }
  .pr-buy h1 { font-size: clamp(1.4rem, 3.5vw, 1.9rem); margin: 0 0 .3rem; }
  .pr-brand { color: var(--site-text-muted); margin: 0 0 .4rem; }
  .pr-edscore { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin: .4rem 0; }
  .pr-edscore-num { font-size: 1.7rem; font-weight: 800; color: var(--site-primary); line-height: 1; }
  .pr-edscore-num small { font-size: .8rem; color: var(--site-text-muted); }
  .pr-edscore-lbl { font-size: .78rem; color: var(--site-text-muted); }
  .pr-reco { display: inline-block; font-weight: 800; border-radius: 999px; padding: .25rem .8rem; font-size: .85rem; margin: .2rem 0 .4rem; }
  .reco-ok { background: #e4f3e8; color: #1b6b3e; } .reco-warn { background: #fdf0d8; color: #8a5a00; } .reco-bad { background: #fbe4e4; color: #a12020; }
  .pr-rating { margin: .2rem 0; } .tpl-stars { color: var(--site-secondary); }
  .pr-verdict { font-size: .92rem; line-height: 1.55; color: var(--site-text-muted); margin: .5rem 0; }
  .pr-price { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; margin: .6rem 0; }
  .pr-old { text-decoration: line-through; color: var(--site-text-muted); }
  .pr-now { font-size: 1.7rem; font-weight: 800; color: var(--site-primary); }
  .pr-disc { background: #b0654f; color: #fff; font-weight: 800; border-radius: 7px; padding: .1rem .5rem; font-size: .85rem; }
  .pr-multi { font-size: .85rem; color: var(--site-text-muted); margin: .2rem 0; }
  .pr-variant { display: block; font-size: .9rem; margin: .6rem 0; }
  .pr-variant select { display: block; margin-top: .25rem; padding: .55rem; border: 1px solid var(--site-border); border-radius: 8px; width: 100%; }
  .pr-cta { display: grid; gap: .5rem; margin: .8rem 0; }
  .pr-reassure { list-style: none; padding: 0; margin: .6rem 0; display: flex; flex-wrap: wrap; gap: .5rem 1rem; font-size: .82rem; color: var(--site-text-muted); }
  .pr-usps { list-style: none; padding: 0; margin: .6rem 0 0; display: grid; gap: .3rem; font-size: .88rem; }
  .pr-disclo { margin-top: .6rem; }
  .pr-review { display: grid; grid-template-columns: 1.4fr .9fr; gap: 1.6rem; align-items: start; }
  .pr-bestfor { font-size: .95rem; margin: .4rem 0 1rem; } .pr-bestfor strong { color: var(--site-primary); }
  .pr-crits { display: grid; gap: .6rem; margin-top: 1rem; }
  .pr-crit { background: var(--site-bg-card); border: 1px solid var(--site-border); border-radius: 12px; padding: .7rem 1rem; }
  .pr-crit-head { display: grid; grid-template-columns: 1fr auto auto; gap: .6rem; align-items: center; font-weight: 600; }
  .pr-crit-head b { color: var(--site-primary); } .pr-crit p { margin: .3rem 0 0; font-size: .88rem; color: var(--site-text-muted); }
  .pr-procons { display: grid; gap: .8rem; align-content: start; }
  .pr-pros h3, .pr-cons h3 { margin: 0 0 .5rem; } .pr-pros h3 { color: #1b6b3e; } .pr-cons h3 { color: #a12020; }
  .pr-procons ul { margin: 0; padding-left: 1.1rem; } .pr-procons li { margin: .35rem 0; }
  .pr-procons-cta { margin-top: .3rem; }
  .pr-specs th { text-align: left; width: 42%; background: var(--site-bg-base); font-weight: 600; }
  .pr-specs th, .pr-specs td { padding: .55rem .8rem; }
  .pr-reviews-wrap { display: grid; grid-template-columns: 280px 1fr; gap: 1.4rem; align-items: start; }
  .pr-dist { background: var(--site-bg-card); border: 1px solid var(--site-border); border-radius: 12px; padding: 1rem; display: grid; gap: .4rem; }
  .pr-distrow { display: grid; grid-template-columns: 28px 1fr 36px; align-items: center; gap: .5rem; font-size: .82rem; }
  .pr-bar { background: var(--site-bg-2); border-radius: 6px; height: 8px; overflow: hidden; }
  .pr-bar div { background: var(--site-secondary); height: 100%; }
  .pr-reviews { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  .pr-rev { margin: 0; } .pr-rev p { margin: .3rem 0; font-size: .92rem; } .pr-rev cite { font-size: .82rem; color: var(--site-text-muted); font-style: normal; }
  .pr-verified { color: #1b6b3e; font-weight: 600; }
  .pr-rcard { text-decoration: none; color: var(--site-text); text-align: center; }
  .pr-rcard img { width: 100%; height: auto; border-radius: 10px; object-fit: contain; background: #fff; }
  .pr-rcard strong { display: block; font-size: .9rem; margin: .4rem 0 .2rem; } .pr-rprice { color: var(--site-primary); font-weight: 700; }
  /* Maillage transversal */
  .pr-also-title { display: block; font-size: .8rem; text-transform: uppercase; letter-spacing: .12em; color: var(--site-text-muted); margin-bottom: .7rem; }
  .pr-also { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .pr-also a { background: var(--site-bg-card, #fff); border: 1px solid var(--site-border); color: var(--site-primary); border-radius: 999px; padding: .4rem 1rem; font-size: .85rem; font-weight: 600; text-decoration: none; }
  .pr-also a:hover { background: var(--site-primary); color: #fff; }
  .pr-also-deal { color: #b0654f !important; font-weight: 800 !important; }

  /* Sticky buy-bar mobile */
  .pr-stickybar { display: none; }
  @media (max-width: 820px) {
    .pr-top { grid-template-columns: 1fr; } .pr-buy { position: static; } .pr-review { grid-template-columns: 1fr; } .pr-reviews-wrap { grid-template-columns: 1fr; } .pr-reviews { grid-template-columns: 1fr; }
    .pr-stickybar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 95; display: flex; align-items: center; gap: .7rem; padding: .55rem .9rem calc(.55rem + env(safe-area-inset-bottom)); background: var(--site-bg-card, #fff); border-top: 1px solid var(--site-border); box-shadow: 0 -8px 26px rgba(0,0,0,.12); }
    .pr-stickybar img { width: 44px; height: 44px; object-fit: contain; background: #fff; border: 1px solid var(--site-border); border-radius: 8px; flex-shrink: 0; }
    .pr-stickybar-txt { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
    .pr-stickybar-txt strong { font-size: 1rem; color: var(--site-primary); white-space: nowrap; }
    .pr-stickybar-txt small { font-size: .7rem; color: var(--site-text-muted); }
    .pr-stickybar-cta { margin-left: auto; background: var(--site-secondary, #e0a800); color: #2a1a00; font-weight: 800; font-size: .88rem; padding: .65rem 1.1rem; border-radius: 999px; text-decoration: none; white-space: nowrap; box-shadow: 0 4px 14px rgba(0,0,0,.18); }
    body { padding-bottom: 64px; }
  }
</style>
