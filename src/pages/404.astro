---
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../lib/site-config';
import { WIKI_IMAGES } from '../lib/site-wiki-images';
import { getCollection } from 'astro:content';

const profile = SITE_CONFIG.profile;
const heroSubject = profile?.wikiImageSubjects?.[0];
const heroImg = heroSubject ? WIKI_IMAGES[heroSubject] : null;

const articles = await getCollection('articles');
articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recent = articles.slice(0, 6);

function getArticleUrl(entry: typeof articles[number]): string {
  const d = entry.data;
  if (d.dateUrlFormat) {
    return `/${d.urlYear}/${String(d.urlMonth).padStart(2, '0')}/${String(d.urlDay).padStart(2, '0')}/${d.slug}/`;
  }
  return d.urlPath ? `/${d.urlPath}/${d.slug}/` : `/${d.slug}/`;
}
---
<Base title="Page introuvable" description="La page demandée n'existe pas ou plus.">

  {/* Hero éditorial 404 */}
  <section style="position:relative;padding:0;background:var(--color-bg-card)">
    <div style="display:grid;grid-template-columns:5fr 4fr;align-items:stretch" class="hero-grid">
      <div style="padding:96px 64px;display:flex;flex-direction:column;justify-content:center">
        <div class="serif" style="font-size:clamp(96px, 12vw, 200px);line-height:.9;font-weight:400;letter-spacing:-6px;color:var(--color-accent);font-style:italic;margin-bottom:24px">404</div>
        <div class="eyebrow" style="margin-bottom:14px">Page introuvable</div>
        <h1 class="serif" style="font-size:clamp(32px, 4vw, 48px);line-height:1.1;font-weight:400;margin-bottom:18px;letter-spacing:-.5px">
          Cette page n'<em style="font-style:italic">existe</em> pas.
        </h1>
        <p style="font-size:17px;color:var(--color-text-muted);line-height:1.65;max-width:520px">
          L'URL que vous avez suivie n'existe pas, ou a été modifiée. Voici quelques pistes pour retrouver ce que vous cherchiez.
        </p>
      </div>
      <div style="position:relative;min-height:520px;overflow:hidden">
        {heroImg ? (
          <img src={heroImg} alt={SITE_CONFIG.siteName} loading="eager" decoding="async" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.7)" />
        ) : (
          <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
        )}
      </div>
    </div>
  </section>

  {/* Recherche + raccourcis */}
  <section style="padding:80px 0;background:var(--color-bg-base);border-bottom:1px solid var(--color-border)">
    <div class="site-container site-container--narrow">
      <div class="eyebrow" style="margin-bottom:14px">Rechercher</div>
      <h2 class="serif" style="font-size:clamp(28px, 3vw, 40px);line-height:1.05;font-weight:400;letter-spacing:-.4px;margin-bottom:32px">
        Tapez un <em style="font-style:italic">mot-clé</em>.
      </h2>
      <form action="/recherche/" method="GET" style="margin-bottom:48px">
        <div style="display:flex;gap:0;border-bottom:2px solid var(--color-ink)">
          <input
            type="search"
            name="q"
            placeholder="Mot-clé…"
            style="flex:1;padding:14px 0;border:0;background:transparent;font-family:'Cormorant Garamond',serif;font-size:24px;color:var(--color-ink);outline:none"
          />
          <button type="submit" style="padding:14px 24px;border:0;background:transparent;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:600;cursor:pointer;color:var(--color-accent)">
            Rechercher →
          </button>
        </div>
      </form>

      <div style="display:flex;flex-wrap:wrap;gap:0;border-top:1px solid var(--color-border);border-left:1px solid var(--color-border)">
        {[
          { href: '/', label: 'Accueil' },
          { href: '/articles/', label: 'Tous les articles' },
          { href: '/outils/', label: 'Outils' },
          { href: '/index-thematique/', label: 'Index thématique' },
          { href: '/contact/', label: 'Contact' },
        ].map((l) => (
          <a href={l.href} style="padding:18px 28px;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:600;color:var(--color-ink);text-decoration:none;border-right:1px solid var(--color-border);border-bottom:1px solid var(--color-border);background:var(--color-bg-card)">{l.label} →</a>
        ))}
      </div>
    </div>
  </section>

  {/* Articles récents */}
  <section style="padding:80px 0 96px;background:var(--color-bg-base)">
    <div class="site-container site-container--narrow">
      <div class="eyebrow" style="margin-bottom:14px">Lectures récentes</div>
      <h2 class="serif" style="font-size:clamp(28px, 3vw, 40px);line-height:1.05;font-weight:400;letter-spacing:-.4px;margin-bottom:48px">
        Découvrez nos <em style="font-style:italic">derniers</em> articles.
      </h2>
      <ul style="list-style:none;padding:0;margin:0;border-top:1px solid var(--color-border)">
        {recent.map((a) => (
          <li style="border-bottom:1px solid var(--color-border)">
            <a href={getArticleUrl(a)} style="display:grid;grid-template-columns:1fr auto;gap:24px;align-items:baseline;padding:24px 0;text-decoration:none;color:inherit">
              <div>
                <div class="serif" style="font-size:22px;line-height:1.25;font-weight:400;letter-spacing:-.2px">{a.data.title}</div>
                {a.data.description && (
                  <div style="font-size:14px;color:var(--color-text-muted);margin-top:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{a.data.description}</div>
                )}
              </div>
              <time style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);font-weight:600">{a.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
            </a>
          </li>
        ))}
      </ul>

      <p style="font-size:14px;color:var(--color-text-muted);margin-top:48px;text-align:center">
        Vous pensez que cette page devrait exister ? <a href="/contact/" class="link-underline">Signalez-le-nous</a>.
      </p>
    </div>
  </section>

</Base>
<style>
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr !important; }
  .hero-grid > div:first-child { padding: 48px 32px !important; }
  .hero-grid > div:last-child { min-height: 240px !important; }
}
</style>
