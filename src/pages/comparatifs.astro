---
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../lib/site-config';
import { getCollection } from 'astro:content';
import { classifyIntent } from '../lib/intent-classifier';
import { getArticleImage } from '../lib/article-wiki-images';
import { WIKI_IMAGES } from '../lib/site-wiki-images';

const articles = await getCollection('articles');
articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const profile = SITE_CONFIG.profile;
const matchups = profile?.matchups ?? [];

function getArticleUrl(entry: typeof articles[number]): string {
  const d = entry.data;
  if (d.dateUrlFormat) return `/${d.urlYear}/${String(d.urlMonth).padStart(2, '0')}/${String(d.urlDay).padStart(2, '0')}/${d.slug}/`;
  return d.urlPath ? `/${d.urlPath}/${d.slug}/` : `/${d.slug}/`;
}

const archetype = SITE_CONFIG.theme.archetype;
const compArticles = articles.filter((a) => {
  const intent = classifyIntent({ title: a.data.title, slug: a.data.slug, sponsored: a.data.sponsored, archetype });
  return ['comparator', 'buying_guide', 'product_review'].includes(intent.primary);
}).slice(0, 60);

const heroSubject = profile?.wikiImageSubjects?.[0];
const heroImg = heroSubject ? WIKI_IMAGES[heroSubject] : null;

const compPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Comparatifs — ${SITE_CONFIG.siteName}`,
  description: `Comparatifs détaillés et duels produits sur ${SITE_CONFIG.siteName} : ${matchups.length} face-à-face + ${compArticles.length} guides d'achat.`,
  url: `${SITE_CONFIG.siteUrl}/comparatifs/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: matchups.length + compArticles.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: [
      ...matchups.slice(0, 10).map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE_CONFIG.siteUrl}/comparatif/${m.slug}/`,
        name: `${m.productA.name} vs ${m.productB.name}`,
      })),
      ...compArticles.slice(0, 20).map((a, i) => ({
        '@type': 'ListItem',
        position: matchups.length + i + 1,
        url: SITE_CONFIG.siteUrl + getArticleUrl(a),
        name: a.data.title,
      })),
    ],
  },
};
---
<Base
  title="Comparatifs"
  description={`Comparatifs détaillés sur ${SITE_CONFIG.siteName}. ${matchups.length > 0 ? `${matchups.length} duels approfondis.` : 'Comparateur multi-produits + articles.'}`}
  jsonLd={[compPageSchema]}
>

  {/* Hero éditorial */}
  <section style="position:relative;padding:0;background:var(--color-bg-card)">
    <div style="display:grid;grid-template-columns:5fr 4fr;align-items:stretch" class="hero-grid">
      <div style="position:relative;min-height:480px;overflow:hidden">
        {heroImg ? (
          <img src={heroImg} alt={SITE_CONFIG.siteName} loading="eager" decoding="async" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.7)" />
        ) : (
          <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
        )}
      </div>
      <div style="padding:96px 64px;display:flex;flex-direction:column;justify-content:center">
        <div class="eyebrow" style="margin-bottom:18px">Comparatifs détaillés</div>
        <h1 class="serif" style="font-size:clamp(40px, 5vw, 72px);line-height:1.05;font-weight:400;margin-bottom:24px;letter-spacing:-1px">
          {matchups.length > 0 ? matchups.length : 0} <em style="font-style:italic">duels</em>{matchups.length > 1 ? '' : ''} approfondis<br/>+ comparateur interactif.
        </h1>
        <p style="font-size:17px;color:var(--color-text-muted);line-height:1.65;margin-bottom:32px;max-width:520px">
          Tableau de critères, points forts/faibles, verdict argumenté. Et un comparateur multi-produits pour vos propres sélections.
        </p>
        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <a href="/outils/comparateur/" class="btn-fill">Comparateur interactif</a>
          {matchups.length > 0 && <a href={`/comparatif/${matchups[0].slug}/`} class="btn-line">Voir le 1er duel</a>}
        </div>
      </div>
    </div>
  </section>

  {/* Duels approfondis */}
  {matchups.length > 0 && (
    <section style="padding:120px 0;background:var(--color-bg-base)">
      <div class="site-container">
        <div style="margin-bottom:64px">
          <div class="eyebrow" style="margin-bottom:14px">Nos duels</div>
          <h2 class="serif" style="font-size:clamp(40px, 5vw, 64px);line-height:1.05;font-weight:400;letter-spacing:-1px">
            <em style="font-style:italic">Comparatifs</em> face à face.
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:32px">
          {matchups.map((m, i) => {
            const subject = profile?.wikiImageSubjects?.[i % (profile?.wikiImageSubjects?.length ?? 1)];
            const matchImg = subject ? WIKI_IMAGES[subject] : null;
            return (
              <a href={`/comparatif/${m.slug}/`} style="display:block;text-decoration:none;color:inherit">
                {matchImg ? (
                  <img src={matchImg} alt="" style="width:100%;aspect-ratio:5/4;object-fit:cover;margin-bottom:24px" loading="lazy" />
                ) : (
                  <div style="width:100%;aspect-ratio:5/4;background:linear-gradient(135deg, var(--color-primary), var(--color-ink));margin-bottom:24px"></div>
                )}
                <div class="eyebrow" style="margin-bottom:10px">Duel n°{i + 1}</div>
                <h3 class="serif" style="font-size:28px;line-height:1.2;font-weight:400;margin-bottom:14px;letter-spacing:-.3px">
                  {m.productA.name} <em style="font-style:italic;color:var(--color-accent)">vs.</em> {m.productB.name}
                </h3>
                <p style="font-size:14px;color:var(--color-text-muted);line-height:1.65;margin-bottom:18px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
                  {m.conclusion.slice(0, 220)}…
                </p>
                <span class="link-underline">Lire le duel</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* Articles comparatifs */}
  {compArticles.length > 0 && (
    <section style="padding:120px 0;border-top:1px solid var(--color-border)">
      <div class="site-container">
        <div style="margin-bottom:48px">
          <div class="eyebrow" style="margin-bottom:14px">Articles comparatifs</div>
          <h2 class="serif" style="font-size:clamp(36px, 4vw, 56px);line-height:1.05;font-weight:400;letter-spacing:-.5px">
            {compArticles.length} guides d'<em style="font-style:italic">achat</em>.
          </h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:48px">
          {compArticles.map((a) => {
            const wikiImg = getArticleImage(a.data.slug);
            const img = a.data.heroImage ?? wikiImg;
            return (
              <a href={getArticleUrl(a)} style="text-decoration:none;color:inherit;display:block">
                {img ? (
                  <img src={img} alt={a.data.title} style="width:100%;aspect-ratio:5/4;object-fit:cover;margin-bottom:18px" loading="lazy" />
                ) : (
                  <div style="width:100%;aspect-ratio:5/4;background:linear-gradient(135deg, var(--color-bg-2), var(--color-border));margin-bottom:18px"></div>
                )}
                <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:8px">
                  {a.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                </div>
                <h3 class="serif" style="font-size:22px;line-height:1.2;font-weight:400;margin-bottom:8px;letter-spacing:-.3px">{a.data.title}</h3>
                {a.data.description && (
                  <p style="font-size:14px;color:var(--color-text-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{a.data.description}</p>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</Base>

<style>
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr !important; }
  .hero-grid > div:nth-child(2) { padding: 48px 32px !important; }
  h1 { font-size: 36px !important; }
}
</style>
