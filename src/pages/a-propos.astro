---
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../lib/site-config';
import { getCollection } from 'astro:content';
import { WIKI_IMAGES } from '../lib/site-wiki-images';

const articles = await getCollection('articles');
const articleCount = articles.length;
const profile = SITE_CONFIG.profile;
const heroSubject = profile?.wikiImageSubjects?.[0];
const heroImg = heroSubject ? WIKI_IMAGES[heroSubject] : null;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `À propos — ${SITE_CONFIG.siteName}`,
  description: `Découvrez ${SITE_CONFIG.siteName} : notre rédaction, notre méthode, nos engagements.`,
  url: `${SITE_CONFIG.siteUrl}/a-propos/`,
  mainEntity: {
    '@type': 'Organization',
    name: SITE_CONFIG.siteName,
    url: SITE_CONFIG.siteUrl,
    description: SITE_CONFIG.tagline,
  },
};
---
<Base
  title="À propos"
  description={`Découvrez ${SITE_CONFIG.siteName} : notre rédaction, notre méthode, nos engagements.`}
  jsonLd={[aboutPageSchema]}
>

  {/* Hero éditorial */}
  <section style="position:relative;padding:0;background:var(--color-bg-card)">
    <div style="display:grid;grid-template-columns:5fr 4fr;align-items:stretch" class="hero-grid">
      <div style="position:relative;min-height:480px;overflow:hidden">
        {heroImg ? (
          <img src={heroImg} alt={SITE_CONFIG.siteName} loading="eager" decoding="async" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.7)" />
        ) : (
          <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
        )}
      </div>
      <div style="padding:96px 64px;display:flex;flex-direction:column;justify-content:center">
        <div class="eyebrow" style="margin-bottom:18px">À propos</div>
        <h1 class="serif" style="font-size:clamp(40px, 5vw, 72px);line-height:1.05;font-weight:400;margin-bottom:24px;letter-spacing:-1px">
          {profile?.positioning ? profile.positioning.split('—')[0] || profile.positioning.split(':')[0] || profile.positioning : SITE_CONFIG.siteName}
        </h1>
        <p style="font-size:17px;color:var(--color-text-muted);line-height:1.7;max-width:520px">
          {profile?.mission ?? SITE_CONFIG.tagline}
        </p>
      </div>
    </div>
  </section>

  {/* Mission */}
  <section style="padding:120px 0;background:var(--color-bg-base)">
    <div class="site-container site-container--narrow">
      <div class="eyebrow" style="margin-bottom:18px">Notre mission</div>
      <h2 class="serif" style="font-size:clamp(36px, 4vw, 56px);line-height:1.1;font-weight:400;letter-spacing:-.5px;margin-bottom:32px">
        Pourquoi ce <em style="font-style:italic">magazine</em>.
      </h2>
      <div class="prose-article" style="margin:0">
        <p style="font-size:18px;line-height:1.75">{profile?.uniqueValue ?? SITE_CONFIG.tagline}</p>
        {profile?.targetAudience && (
          <>
            <h3 class="serif">À qui s'adresse ce site ?</h3>
            <p>{profile.targetAudience}</p>
          </>
        )}
        <h3 class="serif">Notre méthode éditoriale</h3>
        <ul>
          <li><strong>Indépendance</strong> : nos contenus ne sont pas dictés par des annonceurs. Quand un article est sponsorisé, c'est <a href="/annoncer-chez-nous/">clairement indiqué</a>.</li>
          <li><strong>Mises à jour</strong> : les articles sont relus et actualisés régulièrement. La date de mise à jour est affichée en haut de chaque article.</li>
          <li><strong>Sources</strong> : pour les informations chiffrées ou les normes, nous citons les sources officielles (Wikipedia, INSEE, sites institutionnels).</li>
          <li><strong>Corrections</strong> : si vous repérez une erreur, signalez-la via la <a href="/contact/">page contact</a>, nous corrigeons sous 48 h.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* Stats */}
  <section style="padding:96px 0;background:var(--color-bg-card);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)">
    <div class="site-container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:64px;text-align:center">
        <div>
          <div class="serif" style="font-size:64px;font-weight:400;letter-spacing:-2px;line-height:1;color:var(--color-accent);margin-bottom:8px">{articleCount}</div>
          <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted)">Articles publiés</div>
        </div>
        <div>
          <div class="serif" style="font-size:64px;font-weight:400;letter-spacing:-2px;line-height:1;color:var(--color-accent);margin-bottom:8px">{profile?.tools.length ?? 8}</div>
          <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted)">Outils gratuits</div>
        </div>
        <div>
          <div class="serif" style="font-size:64px;font-weight:400;letter-spacing:-2px;line-height:1;color:var(--color-accent);margin-bottom:8px">100%</div>
          <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted)">Cookie-less</div>
        </div>
        <div>
          <div class="serif" style="font-size:64px;font-weight:400;letter-spacing:-2px;line-height:1;color:var(--color-accent);margin-bottom:8px">0</div>
          <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted)">Tracker tiers</div>
        </div>
      </div>
    </div>
  </section>

  {/* Author / équipe */}
  {profile?.author && (
    <section style="padding:120px 0">
      <div class="site-container site-container--narrow">
        <div class="eyebrow" style="margin-bottom:18px">La rédaction</div>
        <h2 class="serif" style="font-size:clamp(36px, 4vw, 56px);line-height:1.1;font-weight:400;letter-spacing:-.5px;margin-bottom:48px">
          Signé par <em style="font-style:italic">notre équipe</em>.
        </h2>
        <div style="background:var(--color-bg-card);padding:48px;border:1px solid var(--color-border)">
          <div class="serif italic" style="font-size:14px;color:var(--color-accent);margin-bottom:8px">Rédaction principale</div>
          <h3 class="serif" style="font-size:36px;font-weight:400;letter-spacing:-.5px;margin-bottom:6px">{profile.author.name}</h3>
          <p class="serif italic" style="font-size:16px;color:var(--color-text-muted);margin-bottom:18px">{profile.author.role} · {profile.author.credentials}</p>
          <p style="font-size:15px;line-height:1.7;color:var(--color-text);margin-bottom:24px">{profile.author.bio}</p>
          <a href="/equipe-editoriale/" class="link-underline">Voir toute l'équipe</a>
        </div>
      </div>
    </section>
  )}

  {/* Contact */}
  <section style="padding:120px 0;background:var(--color-ink);color:var(--color-bg-base)">
    <div class="site-container site-container--narrow" style="text-align:center">
      <div class="eyebrow" style="color:var(--color-secondary);margin-bottom:18px">Contact</div>
      <h2 class="serif" style="font-size:clamp(36px, 4vw, 56px);line-height:1.05;font-weight:400;letter-spacing:-.5px;color:var(--color-bg-base);margin-bottom:24px">
        Une <em style="font-style:italic;color:var(--color-secondary)">question</em> ? Écrivez-nous.
      </h2>
      <p style="font-size:16px;color:rgba(255,255,255,.8);line-height:1.6;max-width:480px;margin:0 auto 48px">
        Pour toute question, correction, proposition d'article invité ou partenariat, rendez-vous sur la page contact.
      </p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
        <a href="/contact/" class="btn-fill" style="background:#fff;color:var(--color-ink);border-color:#fff">Page contact</a>
        <a href="/annoncer-chez-nous/" class="btn-line" style="color:#fff;border-color:rgba(255,255,255,.6)">Annonceurs</a>
      </div>
    </div>
  </section>

</Base>
<style>
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr !important; }
  .hero-grid > div:nth-child(2) { padding: 48px 32px !important; }
  h1 { font-size: 36px !important; }
  h2 { font-size: 28px !important; }
}
</style>
