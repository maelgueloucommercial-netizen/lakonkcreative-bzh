---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const produitParam = Astro.url.searchParams.get('produit') ?? '';
---
<Base
  title="Demander un devis pro"
  description="Restaurant, traiteur, épicerie : demande de devis pour produits italiens authentiques AOP/DOP/IGP. Réponse sous 48 h ouvrées."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Devis' }]} />

    <header class="mb-10">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Sourcing professionnel</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Demander un devis
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Pour les pros uniquement (restaurants, traiteurs, épiciers, hôtellerie). Réponse sous 48 h ouvrées avec proposition tarifaire selon volume et fréquence.
      </p>
    </header>

    <form
      method="POST"
      action="/api/devis"
      class="space-y-6 bg-white rounded-lg border border-cream-200 p-8"
    >
      <div class="grid sm:grid-cols-2 gap-6">
        <label class="block">
          <span class="block text-sm font-medium text-ink-900 mb-1">Établissement *</span>
          <input
            type="text"
            name="establishment"
            required
            class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-ink-900 mb-1">Type *</span>
          <select name="type" required class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500">
            <option value="">Sélectionner…</option>
            <option value="restaurant">Restaurant</option>
            <option value="traiteur">Traiteur</option>
            <option value="épicerie">Épicerie / cave</option>
            <option value="hôtel">Hôtel</option>
            <option value="autre">Autre</option>
          </select>
        </label>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <label class="block">
          <span class="block text-sm font-medium text-ink-900 mb-1">Nom du contact *</span>
          <input type="text" name="name" required class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-ink-900 mb-1">Email *</span>
          <input type="email" name="email" required class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500" />
        </label>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <label class="block">
          <span class="block text-sm font-medium text-ink-900 mb-1">Téléphone</span>
          <input type="tel" name="phone" class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500" />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-ink-900 mb-1">Code postal *</span>
          <input type="text" name="postalCode" required pattern="[0-9]{5}" class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500" />
        </label>
      </div>

      <label class="block">
        <span class="block text-sm font-medium text-ink-900 mb-1">Produit(s) souhaité(s)</span>
        <input type="text" name="produit" value={produitParam} class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500" />
      </label>

      <label class="block">
        <span class="block text-sm font-medium text-ink-900 mb-1">Volume / fréquence prévus *</span>
        <textarea
          name="volume"
          required
          rows="3"
          placeholder="Ex: 5 kg de Parmigiano par mois, 12 bouteilles d'huile par trimestre"
          class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500"
        ></textarea>
      </label>

      <label class="block">
        <span class="block text-sm font-medium text-ink-900 mb-1">Précisions</span>
        <textarea
          name="message"
          rows="4"
          placeholder="Toute information utile pour calibrer le devis"
          class="w-full rounded-md border border-cream-200 px-4 py-2.5 focus:outline-none focus:border-terra-500"
        ></textarea>
      </label>

      <p class="text-xs text-ink-700/60">
        En envoyant ce formulaire, vous acceptez que vos coordonnées soient utilisées pour vous répondre. Aucune communication commerciale tierce.
      </p>

      <button type="submit" class="btn-primary w-full sm:w-auto">
        Envoyer la demande
      </button>
    </form>
  </section>
</Base>
