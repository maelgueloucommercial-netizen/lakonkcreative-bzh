---
/**
 * Type de page : landingDevis (archétype local_service_leadgen) — DESIGN v2 (templates.css).
 * Landing de conversion : peu de distractions, preuve sociale, formulaire → /lead,
 * réassurance. Tirée de SITE_CONFIG (+ profil si présent). URL : /devis/. Schema WebPage.
 */
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../lib/site-config';
import '../styles/templates.css';

const pageUrl = new URL('/devis/', SITE_CONFIG.siteUrl).toString();
const profile: any = SITE_CONFIG.profile ?? {};
const service = SITE_CONFIG.siteName;
const phone: string | undefined = profile.phone;
const tel = phone ? String(phone).replace(/\s/g, '') : '';
const usps: string[] = Array.isArray(profile.usps) && profile.usps.length
  ? profile.usps
  : ['Sans engagement', 'Réponse rapide', 'Professionnels vérifiés', 'Devis 100% gratuit'];
const LEAD_ENDPOINT = 'https://felleries-cron.mael-guelou-commercial.workers.dev/lead';
const title = `Devis gratuit — ${service}`;
const description = `Demandez votre devis gratuit et sans engagement. Réponse rapide, professionnels vérifiés.`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: pageUrl },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_CONFIG.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Devis gratuit', item: pageUrl } ] },
];
---
<Base title={title} description={description} canonical={pageUrl} type="website" jsonLd={jsonLd}>
  <div class="dv">
    <header class="tpl-band tpl-band--dark"><div class="tpl-wrap dv-hero">
      <div class="dv-hero-text">
        <span class="tpl-eyebrow tpl-eyebrow--light">Devis gratuit</span>
        <h1 class="tpl-h1">Votre devis gratuit en 1 minute</h1>
        <p class="tpl-lead">Décrivez votre besoin, recevez une réponse rapide et sans engagement.</p>
        <ul class="dv-usps">{usps.map((u) => <li>✓ {u}</li>)}</ul>
        {phone && <p class="dv-phone">Ou appelez-nous : <a href={`tel:${tel}`}>☎ {phone}</a></p>}
      </div>
      <div class="dv-card">
        <h2>Demander mon devis</h2>
        <form method="POST" action={LEAD_ENDPOINT} class="dv-form">
          <input type="hidden" name="service" value={service} /><input type="hidden" name="source" value={pageUrl} />
          <input name="nom" required placeholder="Nom *" /><input name="tel" required type="tel" placeholder="Téléphone *" />
          <input name="cp" placeholder="Code postal" /><input name="email" type="email" placeholder="E-mail (facultatif)" />
          <textarea name="message" placeholder="Votre besoin (facultatif)" rows="3"></textarea>
          <button type="submit" class="tpl-btn tpl-btn-amber tpl-btn-full">Recevoir mon devis gratuit</button>
        </form>
        <p class="dv-note">Vos données ne servent qu'à traiter votre demande.</p>
        <div id="dv-msg" class="dv-msg" role="status" hidden></div>
      </div>
    </div></header>

    <section class="tpl-band tpl-band--tint"><div class="tpl-wrap tpl-stats">
      <div><strong>100%</strong><span>Gratuit & sans engagement</span></div>
      <div><strong>24-48h</strong><span>Réponse rapide</span></div>
      <div><strong>✓</strong><span>Professionnels vérifiés</span></div>
    </div></section>

    <section class="tpl-band"><div class="tpl-wrap">
      <span class="tpl-eyebrow">Comment ça marche</span><h2 class="tpl-h2">3 étapes simples</h2>
      <ol class="dv-steps">
        <li><span>1</span><div><strong>Vous décrivez votre besoin</strong><p>Quelques informations suffisent.</p></div></li>
        <li><span>2</span><div><strong>On étudie votre demande</strong><p>Un professionnel adapté vous est proposé.</p></div></li>
        <li><span>3</span><div><strong>Vous recevez votre devis</strong><p>Gratuit, détaillé, sans engagement.</p></div></li>
      </ol>
    </div></section>
  </div>

  <script is:inline define:vars={{ leadUrl: LEAD_ENDPOINT, phone: phone || '' }}>
    (function () {
      var form = document.querySelector('.dv-form'); var msg = document.getElementById('dv-msg');
      function show(ok, t) { if (!msg) return; msg.hidden = false; msg.className = 'dv-msg ' + (ok ? 'ok' : 'err'); msg.textContent = t; }
      var q = new URLSearchParams(location.search).get('devis');
      if (q === 'ok') show(true, 'Merci ! Votre demande a bien été envoyée, vous serez recontacté rapidement.');
      if (q === 'err') show(false, 'Merci de renseigner au moins votre nom et votre téléphone.');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault(); var btn = form.querySelector('button[type=submit]'); var l = btn ? btn.textContent : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Envoi…'; }
        var body = new URLSearchParams(new FormData(form)); body.set('ajax', '1');
        fetch(leadUrl, { method: 'POST', body: body })
          .then(function (r) { if (!r.ok) throw 0; return r.json().catch(function () { return {}; }); })
          .then(function () { form.reset(); show(true, 'Merci ! Demande envoyée, vous serez recontacté au plus vite' + (phone ? ' — ou appelez le ' + phone + '.' : '.')); })
          .catch(function () { show(false, 'Envoi indisponible.' + (phone ? ' Appelez-nous au ' + phone + '.' : ' Réessayez dans un instant.')); })
          .finally(function () { if (btn) { btn.disabled = false; btn.textContent = l; } });
      });
    })();
  </script>
</Base>

<style>
  .dv-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem; align-items: start; }
  .dv-usps { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: .35rem; font-weight: 600; }
  .dv-phone a { color: #ffd9a3; font-weight: 700; text-decoration: none; }
  .dv-card { background: var(--site-bg-card); color: var(--site-text); border-radius: 16px; padding: 1.4rem; box-shadow: 0 19px 45px rgba(0,0,0,.28); }
  .dv-card h2 { margin: 0 0 .8rem; color: var(--site-primary); font-size: 1.2rem; }
  .dv-form { display: grid; gap: .55rem; }
  .dv-form input, .dv-form textarea { padding: .7rem; border: 1px solid var(--site-border); border-radius: 9px; font-size: .95rem; width: 100%; box-sizing: border-box; font-family: inherit; }
  .dv-note { font-size: .76rem; color: var(--site-text-muted); margin: .5rem 0 0; }
  .dv-msg { margin: .6rem 0 0; padding: .6rem .8rem; border-radius: 9px; font-size: .9rem; font-weight: 600; }
  .dv-msg.ok { background: #e7f3ec; color: #1b6b3e; } .dv-msg.err { background: #fdecea; color: #9a3528; }
  .dv-steps { list-style: none; padding: 0; display: grid; gap: .7rem; }
  .dv-steps li { display: flex; gap: .9rem; align-items: flex-start; background: var(--site-bg-card); border: 1px solid var(--site-border); border-radius: 12px; padding: 1rem; }
  .dv-steps li span { flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%; background: var(--site-secondary); color: #2a1a00; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .dv-steps p { margin: .2rem 0 0; color: var(--site-text-muted); font-size: .9rem; }
  @media (max-width: 720px) { .dv-hero { grid-template-columns: 1fr; } }
</style>
