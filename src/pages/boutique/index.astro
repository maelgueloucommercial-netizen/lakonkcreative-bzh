---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedPicture from '../../components/OptimizedPicture.astro';

const produits = (await getCollection('produits')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const byCategory = produits.reduce<Record<string, typeof produits>>((acc, p) => {
  (acc[p.data.category] ||= []).push(p);
  return acc;
}, {});
const categoryLabels: Record<string, string> = {
  huile: 'Huiles d\'olive',
  pâte: 'Pâtes',
  fromage: 'Fromages',
  charcuterie: 'Charcuteries',
  vin: 'Vins',
  antipasti: 'Antipasti',
  dolci: 'Dolci',
  épicerie: 'Épicerie sèche',
};
---
<Base
  title="Sourcing pro — Catalogue B2B produits italiens AOP / DOP / IGP"
  description="Catalogue B2B pour restaurateurs, traiteurs et épiciers : produits italiens authentiques certifiés AOP/DOP/IGP. Demande de devis sur chaque fiche, livraison France métropolitaine."
>
  <section class="bg-ink-900 text-cream-50">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <Breadcrumb items={[{ label: 'Boutique B2B' }]} />
      <p class="text-xs uppercase tracking-widest text-terra-300 mb-3">Sourcing professionnel</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-cream-50 leading-tight mb-4 max-w-3xl">
        Catalogue B2B — produits italiens authentiques
      </h1>
      <p class="text-lg text-cream-200/80 leading-relaxed max-w-3xl">
        Pour restaurants, traiteurs, épiciers fines et hôtellerie : sélection serrée de produits italiens certifiés AOP, DOP ou IGP, avec contrôle d'origine. Demande de devis en ligne, livraison France métropolitaine, échantillons sur demande.
      </p>
      <p class="text-sm text-cream-200/60 mt-4 max-w-3xl">
        Pas de prix affichés : chaque devis est calibré selon le volume, la fréquence et le mode de livraison.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12">
    {Object.entries(byCategory).map(([cat, items]) => (
      <div class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-4 border-b border-cream-200 pb-2">
          {categoryLabels[cat] ?? cat}
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((p) => (
            <a href={`/boutique/${p.id}`} class="group rounded-lg border border-cream-200 bg-white overflow-hidden hover:border-terra-300 hover:shadow-md transition flex flex-col">
              <div class="overflow-hidden aspect-[16/10] bg-cream-100">
                {p.data.image ? (
                  <OptimizedPicture
                    src={p.data.image}
                    alt={`${p.data.name} — ${p.data.region ?? 'produit italien AOP/DOP/IGP'}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center font-serif text-3xl bg-gradient-to-br from-olive-100 to-terra-100 text-olive-700">
                    {p.data.aopDop ?? '🇮🇹'}
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-start justify-between mb-2">
                  <h3 class="font-serif text-xl text-ink-900 group-hover:text-terra-700 transition leading-tight">{p.data.name}</h3>
                  {p.data.aopDop && (
                    <span class="text-xs font-bold uppercase tracking-wider px-2 py-1 bg-olive-100 text-olive-700 rounded shrink-0 ml-2">{p.data.aopDop}</span>
                  )}
                </div>
                {p.data.region && <p class="text-xs text-olive-700 mb-3">{p.data.region}</p>}
                <p class="text-sm text-ink-700/80 line-clamp-3 flex-1 mb-4">{p.data.description}</p>
                <div class="text-xs text-ink-700/70 mb-3">
                  Conditionnement : {p.data.conditioningOptions.join(' · ')}
                </div>
                <span class="text-xs font-medium text-terra-700">Demander un devis →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Base>
