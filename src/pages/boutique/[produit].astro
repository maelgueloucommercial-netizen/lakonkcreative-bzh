---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const produits = await getCollection('produits');
  return produits.map((p) => ({ params: { produit: p.id }, props: { produit: p } }));
}

const { produit } = Astro.props;
const { Content } = await render(produit);
---
<Base
  title={`${produit.data.name} — Sourcing pro`}
  description={produit.data.description}
  type="article"
  publishedAt={produit.data.publishedAt}
  updatedAt={produit.data.updatedAt}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: produit.data.name,
    description: produit.data.description,
    category: produit.data.category,
    brand: { '@type': 'Brand', name: 'DaRocco' },
    offers: {
      '@type': 'Offer',
      url: `https://darocco.fr/boutique/${produit.id}`,
      priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR' },
      availability: 'https://schema.org/InStock',
      businessFunction: 'http://purl.org/goodrelations/v1#Sell',
      eligibleCustomerType: 'http://purl.org/goodrelations/v1#Business',
    },
  }}
>
  <article class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Boutique B2B', href: '/boutique' }, { label: produit.data.name }]} />

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <p class="text-xs uppercase tracking-widest text-olive-700">{produit.data.category}{produit.data.region && ` · ${produit.data.region}`}</p>
        {produit.data.aopDop && (
          <span class="text-xs font-bold uppercase tracking-wider px-2 py-0.5 bg-olive-100 text-olive-700 rounded">{produit.data.aopDop}</span>
        )}
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight">{produit.data.name}</h1>
    </header>

    <p class="text-lg text-ink-700 leading-relaxed mb-8 border-l-4 border-terra-500 pl-5">
      {produit.data.description}
    </p>

    <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-ink-900 prose-a:text-terra-700 mb-10">
      <Content />
    </div>

    <section class="rounded-lg bg-ink-900 text-cream-50 p-8 lg:p-10">
      <h2 class="font-serif text-2xl text-cream-50 mb-3">Demander un devis</h2>
      <p class="text-cream-200/80 leading-relaxed mb-6">
        Aucun prix affiché : chaque devis est calibré selon le volume, la fréquence et le mode de livraison. Réponse sous 48 h ouvrées.
      </p>
      <a href={`/devis?produit=${produit.id}`} class="inline-block rounded-md bg-terra-600 hover:bg-terra-700 transition text-cream-50 px-6 py-3 font-medium text-sm">
        Demander un devis pour ce produit
      </a>
    </section>

    <footer class="mt-10 pt-6 border-t border-cream-200 text-sm text-ink-700/60">
      Référence mise à jour le {produit.data.updatedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}.
    </footer>
  </article>
</Base>
