---
/**
 * Pillar page « AOP DOP IGP italie » (item #44 roadmap).
 *
 * Stratégie SEO : agrège tous les produits sous appellations protégées
 * référencés sur les fiches régions et produits B2B. Cible le mot-clé
 * "AOP DOP IGP italienne" + ses variantes ("produits italiens authentiques",
 * "label qualité italien").
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const allRegions = await getCollection('regions');
const allProduits = await getCollection('produits');

// Récupère toutes les AOP/DOP citées + leur région
interface Appellation {
  name: string;
  region: string;
  regionSlug: string;
}

const allAppellations: Appellation[] = [];
for (const r of allRegions) {
  for (const aop of r.data.aopDop ?? []) {
    allAppellations.push({ name: aop, region: r.data.name, regionSlug: r.id });
  }
}

// Tri alphabétique
allAppellations.sort((a, b) => a.name.localeCompare(b.name, 'fr'));

// Détection du type d'appellation par regex sur le nom
function categorize(name: string): 'huile' | 'fromage' | 'charcuterie' | 'vin' | 'autre' {
  const n = name.toLowerCase();
  if (/\bolio|huile\b/.test(n)) return 'huile';
  if (/\b(parmigiano|pecorino|gorgonzola|fontina|asiago|mozzarella|burrata|caciocavallo|provolone|grana|taleggio|caciotta|montasio)\b/.test(n)) return 'fromage';
  if (/\b(prosciutto|jambon|speck|salame|salami|lard|guanciale|pancetta|capocollo|coppa|bresaola|mortadella|cotechino|nduja|lardo|culatello|finocchiona|soppressata|lucanica|ciauscolo)\b/.test(n)) return 'charcuterie';
  if (/\bdoc(g)?\b|chianti|barolo|brunello|aglianico|montepulciano|sangiovese|nebbiolo|valpolicella|prosecco|franciacorta/.test(n)) return 'vin';
  return 'autre';
}

const byCategory = {
  huile: [] as Appellation[],
  fromage: [] as Appellation[],
  charcuterie: [] as Appellation[],
  vin: [] as Appellation[],
  autre: [] as Appellation[],
};
for (const a of allAppellations) byCategory[categorize(a.name)].push(a);

const aopProduits = allProduits.filter((p) => p.data.aopDop);
---
<Base
  title="AOP, DOP, IGP : guide des appellations italiennes protégées"
  description="Tour complet des AOP, DOP et IGP italiennes : huiles d'olive, fromages, charcuteries, vins. Comment lire un label, distinguer authentique et italian sounding, où acheter en France."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AOP DOP IGP italiennes — guide',
    description: 'Encyclopédie des appellations protégées italiennes par catégorie et par région.',
    isPartOf: { '@id': 'https://darocco.fr#website' },
  }}
>
  <section class="mx-auto max-w-5xl px-6 py-12">
    <Breadcrumb items={[{ label: 'AOP DOP IGP Italie' }]} />

    <header class="mb-12">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Pillar page · Encyclopédie</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        AOP, DOP, IGP : les appellations italiennes protégées
      </h1>
      <p class="text-xl text-ink-700 leading-relaxed max-w-3xl">
        L'Italie compte plus de <strong>880 appellations protégées</strong> au niveau européen — record absolu.
        Elles certifient l'origine, le terroir et un cahier des charges traditionnel codifié.
        Comprendre ces signes de qualité est la première règle pour distinguer la cuisine italienne authentique
        de l'<em>italian sounding</em>.
      </p>
    </header>

    {/* Lexique des sigles */}
    <section class="bg-olive-50 border border-olive-200 rounded-lg p-6 sm:p-8 mb-12">
      <h2 class="font-serif text-2xl text-ink-900 mb-4">Lire un label</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <div>
          <p class="font-serif text-lg text-terra-700">DOP / AOP</p>
          <p class="text-sm text-ink-700 leading-relaxed mt-1">
            <strong>Denominazione di Origine Protetta</strong> (italien) / <strong>Appellation d'Origine Protégée</strong> (français).
            Production, transformation et élaboration <strong>obligatoirement</strong> dans la zone géographique
            définie. Niveau le plus exigeant.
          </p>
        </div>
        <div>
          <p class="font-serif text-lg text-terra-700">IGP</p>
          <p class="text-sm text-ink-700 leading-relaxed mt-1">
            <strong>Indicazione Geografica Protetta</strong>. Au moins l'une des étapes (production,
            transformation, élaboration) se fait dans la zone. Plus souple que DOP, mais lien territorial obligatoire.
          </p>
        </div>
        <div>
          <p class="font-serif text-lg text-terra-700">DOC / DOCG</p>
          <p class="text-sm text-ink-700 leading-relaxed mt-1">
            Spécifique aux <strong>vins</strong>. <em>Denominazione di Origine Controllata</em> (DOC) — équivalent AOC.
            <em>Denominazione di Origine Controllata e Garantita</em> (DOCG) — au-dessus, contrôle plus strict.
          </p>
        </div>
      </div>
    </section>

    {/* Catalogue par catégorie */}
    {byCategory.huile.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-6">Huiles d'olive AOP</h2>
        <p class="text-ink-700 leading-relaxed mb-4">
          L'Italie compte 49 AOP/IGP d'huile d'olive — un par grande zone oléicole. Chacune répond à un cultivar
          dominant (Frantoio, Moraiolo, Coratina, Taggiasca…) et un profil aromatique précis.
        </p>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          {byCategory.huile.map((a) => (
            <li class="rounded border border-cream-200 bg-white px-3 py-2">
              <span class="text-ink-900">{a.name}</span>
              <span class="text-ink-700/60"> — </span>
              <a href={`/regions/${a.regionSlug}`} class="text-terra-700 hover:text-terra-900 hover:underline">{a.region}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {byCategory.fromage.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-6">Fromages AOP/DOP</h2>
        <p class="text-ink-700 leading-relaxed mb-4">
          De la Fontina valdôtaine au Caciocavallo Silano, du Parmigiano Reggiano au Pecorino Romano,
          le patrimoine fromager italien sous AOP est l'un des plus riches au monde.
        </p>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          {byCategory.fromage.map((a) => (
            <li class="rounded border border-cream-200 bg-white px-3 py-2">
              <span class="text-ink-900">{a.name}</span>
              <span class="text-ink-700/60"> — </span>
              <a href={`/regions/${a.regionSlug}`} class="text-terra-700 hover:text-terra-900 hover:underline">{a.region}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {byCategory.charcuterie.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-6">Charcuteries AOP/DOP/IGP</h2>
        <p class="text-ink-700 leading-relaxed mb-4">
          Norcia donne son nom au métier (<em>norcineria</em>), Parme et San Daniele se disputent le titre du
          plus grand jambon. La charcuterie italienne sous appellation est codifiée jusqu'au type de porc
          et au climat d'affinage.
        </p>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          {byCategory.charcuterie.map((a) => (
            <li class="rounded border border-cream-200 bg-white px-3 py-2">
              <span class="text-ink-900">{a.name}</span>
              <span class="text-ink-700/60"> — </span>
              <a href={`/regions/${a.regionSlug}`} class="text-terra-700 hover:text-terra-900 hover:underline">{a.region}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {byCategory.vin.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-6">Vins DOC / DOCG / IGT</h2>
        <p class="text-ink-700 leading-relaxed mb-4">
          332 DOC + 76 DOCG en Italie. Les grands cépages autochtones (Sangiovese, Nebbiolo, Aglianico,
          Verdicchio, Vermentino…) et les terroirs volcaniques (Etna, Vulture, Vésuve) en font l'une des
          patries vitivinicoles majeures.
        </p>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          {byCategory.vin.map((a) => (
            <li class="rounded border border-cream-200 bg-white px-3 py-2">
              <span class="text-ink-900">{a.name}</span>
              <span class="text-ink-700/60"> — </span>
              <a href={`/regions/${a.regionSlug}`} class="text-terra-700 hover:text-terra-900 hover:underline">{a.region}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {byCategory.autre.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-6">Autres appellations</h2>
        <p class="text-ink-700 leading-relaxed mb-4">
          Pains, pâtes sèches, fruits, légumes, agrumes, vinaigres, miels, confiseries — l'Italie protège un
          spectre extrêmement large de produits sous AOP/DOP/IGP.
        </p>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          {byCategory.autre.map((a) => (
            <li class="rounded border border-cream-200 bg-white px-3 py-2">
              <span class="text-ink-900">{a.name}</span>
              <span class="text-ink-700/60"> — </span>
              <a href={`/regions/${a.regionSlug}`} class="text-terra-700 hover:text-terra-900 hover:underline">{a.region}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Bloc B2B */}
    {aopProduits.length > 0 && (
      <section class="bg-cream-100 border border-cream-200 rounded-lg p-6 sm:p-8 mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-4">Sourcing professionnel</h2>
        <p class="text-ink-700 leading-relaxed mb-5">
          Restaurants, traiteurs, épiciers : nous sourçons directement chez les producteurs AOP/DOP/IGP
          italiens. Catalogue B2B avec demande de devis.
        </p>
        <ul class="space-y-2 mb-5">
          {aopProduits.map((p) => (
            <li class="text-sm">
              <a href={`/boutique/${p.id}`} class="text-terra-700 hover:text-terra-900 underline-offset-2 hover:underline">
                {p.data.name}
              </a>
              {p.data.aopDop && <span class="text-ink-700/60"> · {p.data.aopDop}</span>}
              {p.data.region && <span class="text-ink-700/60"> · {p.data.region}</span>}
            </li>
          ))}
        </ul>
        <a href="/devis" class="btn-primary">Demander un devis pro</a>
      </section>
    )}

    {/* Anti-italian sounding */}
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-ink-900 mb-4">Anti italian sounding : 4 réflexes</h2>
      <ol class="space-y-3 text-ink-700 leading-relaxed list-decimal pl-5">
        <li>
          Vérifier le <strong>logo officiel européen</strong> AOP/DOP (rouge/jaune) ou IGP (bleu/jaune) sur l'emballage.
        </li>
        <li>
          Lire le <strong>numéro de cahier des charges</strong> et l'organisme certificateur (Consorzio di Tutela). En cas de doute,
          on peut vérifier le numéro sur le site officiel de la commission européenne.
        </li>
        <li>
          Se méfier des mentions vagues : <em>"recette italienne"</em>, <em>"à l'italienne"</em>, <em>"goût italien"</em>
          ne signifient strictement <strong>rien</strong> juridiquement. Seul le sigle officiel compte.
        </li>
        <li>
          Sur les <strong>fromages</strong> et <strong>jambons</strong>, l'origine du lait/animal doit être italienne pour les DOP.
          Un Parmigiano fabriqué en France n'existe pas — c'est un grana, pas un Parmigiano.
        </li>
      </ol>
    </section>
  </section>
</Base>
