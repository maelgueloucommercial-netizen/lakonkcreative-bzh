---
/**
 * Page index des rubriques (catégories) — accessible via /categorie/
 * Liste toutes les rubriques avec image hero + 3 derniers articles par cat.
 *
 * Cible le keyword "rubriques" + agit comme hub thématique pour le maillage.
 */
import Base from '../../layouts/Base.astro';
import { SITE_CONFIG } from '../../lib/site-config';
import { getCollection } from 'astro:content';
import { getArticleImage } from '../../lib/article-wiki-images';
import { WIKI_IMAGES } from '../../lib/site-wiki-images';

const articles = await getCollection('articles');
const profile = SITE_CONFIG.profile;

function classifyByKeywords(title: string, profileCategories: any): string | null {
  if (!profileCategories) return null;
  const t = title.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
  for (const cat of profileCategories as any[]) {
    for (const kw of cat.keywords) {
      if (t.includes(kw.toLowerCase().normalize('NFD').replace(/\p{M}/gu, ''))) return cat.slug;
    }
  }
  return null;
}

function hashToIndex(s: string, n: number): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) & 0x7fffffff;
  return h % Math.max(1, n);
}

const allCats = new Map<string, { name: string; description: string; emoji?: string; arts: typeof articles }>();
const matched = new Set<string>();

if (profile) {
  for (const cat of profile.categories) {
    allCats.set(cat.slug, { name: cat.name, description: cat.description, emoji: cat.emoji, arts: [] as typeof articles });
  }
  for (const a of articles) {
    const slug = classifyByKeywords(a.data.title, profile.categories);
    if (slug && allCats.has(slug)) {
      allCats.get(slug)!.arts.push(a);
      matched.add(a.data.slug);
    }
  }
}
for (const a of articles) {
  if (!a.data.category) continue;
  const slug = a.data.category.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  if (!slug || allCats.has(slug)) continue;
  allCats.set(slug, { name: a.data.category, description: '', arts: [] as typeof articles });
}
for (const a of articles) {
  if (!a.data.category) continue;
  const slug = a.data.category.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const entry = allCats.get(slug);
  if (entry && !entry.arts.includes(a)) {
    entry.arts.push(a);
    matched.add(a.data.slug);
  }
}
if (profile && profile.categories.length > 0) {
  const catSlugs = profile.categories.map((c: any) => c.slug);
  for (const a of articles) {
    if (matched.has(a.data.slug)) continue;
    const idx = hashToIndex(a.data.slug, catSlugs.length);
    const targetSlug = catSlugs[idx];
    const entry = allCats.get(targetSlug);
    if (entry && !entry.arts.includes(a)) {
      entry.arts.push(a);
      matched.add(a.data.slug);
    }
  }
}

// Sort articles dans chaque cat par date desc
const categories = [...allCats.entries()]
  .filter(([, e]) => e.arts.length > 0)
  .map(([slug, e]) => {
    const sortedArts = [...e.arts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
    // Image cat = image du 1er article ou fallback profile
    const heroSubject = profile?.wikiImageSubjects?.[0];
    const heroFromArt = getArticleImage(sortedArts[0]?.data.slug ?? '');
    const heroImg = heroFromArt ?? (heroSubject ? WIKI_IMAGES[heroSubject] : null);
    return { slug, ...e, arts: sortedArts.slice(0, 5), totalCount: e.arts.length, heroImg };
  })
  .sort((a, b) => b.totalCount - a.totalCount);

function getArticleUrl(entry: any): string {
  const d = entry.data;
  if (d.dateUrlFormat) return `/${d.urlYear}/${String(d.urlMonth).padStart(2, '0')}/${String(d.urlDay).padStart(2, '0')}/${d.slug}/`;
  return d.urlPath ? `/${d.urlPath}/${d.slug}/` : `/${d.slug}/`;
}

// Schema CollectionPage pour le hub des rubriques
const collectionPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Rubriques de ${SITE_CONFIG.siteName}`,
  description: `Toutes les rubriques de ${SITE_CONFIG.siteName} : ${categories.map((c) => c.name).join(', ')}.`,
  url: `${SITE_CONFIG.siteUrl}/categorie/`,
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: categories.length,
    itemListElement: categories.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_CONFIG.siteUrl}/categorie/${c.slug}/`,
      name: c.name,
    })),
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_CONFIG.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Rubriques' },
  ],
};
---
<Base
  title="Rubriques"
  description={`Explorez les ${categories.length} rubriques de ${SITE_CONFIG.siteName} — ${categories.map((c) => c.name).join(' · ')}.`}
  jsonLd={[collectionPageJsonLd, breadcrumbJsonLd]}
>
  <header style="padding:120px 0 64px;background:var(--color-bg-base)">
    <div class="site-container">
      <nav style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:24px">
        <a href="/" style="color:var(--color-text-muted);text-decoration:none">Accueil</a>
        <span style="margin:0 10px">·</span>
        <span style="color:var(--color-ink)">Rubriques</span>
      </nav>
      <div class="eyebrow" style="margin-bottom:18px">{categories.length} rubrique{categories.length > 1 ? 's' : ''}</div>
      <h1 class="serif" style="font-size:clamp(48px, 6vw, 88px);line-height:1.02;font-weight:400;letter-spacing:-1.5px;margin-bottom:28px">
        Nos <em style="font-style:italic">rubriques</em>
      </h1>
      <p style="font-size:18px;color:var(--color-text-muted);line-height:1.65;max-width:680px">
        Toutes les thématiques traitées sur {SITE_CONFIG.siteName}. Cliquez sur une rubrique pour voir l'ensemble de ses articles.
      </p>
    </div>
  </header>

  <section style="padding:48px 0 120px;background:var(--color-bg-base)">
    <div class="site-container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:48px">
        {categories.map((cat) => (
          <article style="background:var(--color-bg-card);border:1px solid var(--color-border);overflow:hidden">
            <a href={`/categorie/${cat.slug}/`} style="display:block;text-decoration:none;color:inherit">
              {cat.heroImg ? (
                <div style="aspect-ratio:16/10;overflow:hidden;background:var(--color-border)">
                  <img src={cat.heroImg} alt={`${cat.name} — illustration`} loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover" />
                </div>
              ) : (
                <div style="aspect-ratio:16/10;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
              )}
              <div style="padding:32px">
                <div class="eyebrow" style="margin-bottom:14px">{cat.totalCount} article{cat.totalCount > 1 ? 's' : ''}</div>
                <h2 class="serif" style="font-size:32px;line-height:1.1;font-weight:400;letter-spacing:-.5px;margin-bottom:14px">
                  {cat.emoji && <span style="margin-right:8px">{cat.emoji}</span>}
                  {cat.name}
                </h2>
                {cat.description && (
                  <p style="font-size:14px;color:var(--color-text-muted);line-height:1.6;margin-bottom:24px">{cat.description}</p>
                )}
              </div>
            </a>
            {cat.arts.length > 0 && (
              <div style="padding:0 32px 32px">
                <div style="font-size:11px;letter-spacing:2px;color:var(--color-text-subtle);text-transform:uppercase;margin-bottom:12px">Articles récents</div>
                <ul style="list-style:none;padding:0;margin:0">
                  {cat.arts.slice(0, 3).map((a) => (
                    <li style="border-top:1px solid var(--color-border);padding:14px 0">
                      <a href={getArticleUrl(a)} style="text-decoration:none;color:var(--color-ink);font-size:14px;line-height:1.4;display:block">
                        {a.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
                <a href={`/categorie/${cat.slug}/`} style="display:inline-block;margin-top:18px;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-ink);text-decoration:none;border-bottom:1px solid var(--color-ink);padding-bottom:2px">
                  Voir les {cat.totalCount} articles →
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
