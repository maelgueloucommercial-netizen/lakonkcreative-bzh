---
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../lib/site-config';
import { getCollection } from 'astro:content';
import { classifyIntent } from '../lib/intent-classifier';
import { getArticleImage } from '../lib/article-wiki-images';
import { WIKI_IMAGES } from '../lib/site-wiki-images';

const articles = await getCollection('articles');
articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function getArticleUrl(entry: typeof articles[number]): string {
  const d = entry.data;
  if (d.dateUrlFormat) return `/${d.urlYear}/${String(d.urlMonth).padStart(2, '0')}/${String(d.urlDay).padStart(2, '0')}/${d.slug}/`;
  return d.urlPath ? `/${d.urlPath}/${d.slug}/` : `/${d.slug}/`;
}

const archetype = SITE_CONFIG.theme.archetype;
const reviewArticles = articles.filter((a) => {
  const intent = classifyIntent({ title: a.data.title, slug: a.data.slug, sponsored: a.data.sponsored, archetype });
  return intent.primary === 'product_review';
}).slice(0, 60);

const profile = SITE_CONFIG.profile;
const heroSubject = profile?.wikiImageSubjects?.[1] ?? profile?.wikiImageSubjects?.[0];
const heroImg = heroSubject ? WIKI_IMAGES[heroSubject] : null;
const featured = reviewArticles[0];
const restReviews = reviewArticles.slice(1);

const _pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Avis — ${SITE_CONFIG.siteName}`,
  description: `Tests et avis indépendants sur ${SITE_CONFIG.siteName}.`,
  url: `${SITE_CONFIG.siteUrl}/avis/`,
  inLanguage: 'fr-FR',
  isPartOf: { '@type': 'WebSite', name: SITE_CONFIG.siteName, url: SITE_CONFIG.siteUrl },
};
---
<Base
  title="Avis et tests"
  description={`Avis utilisateurs et tests indépendants publiés sur ${SITE_CONFIG.siteName}. ${reviewArticles.length} contenus.`}
  jsonLd={[_pageSchema]}
>

  {/* Hero éditorial */}
  <section style="position:relative;padding:0">
    <div style="display:grid;grid-template-columns:5fr 4fr;align-items:stretch" class="hero-grid">
      <div style="position:relative;min-height:480px;overflow:hidden">
        {heroImg ? (
          <img src={heroImg} alt={SITE_CONFIG.siteName} loading="eager" decoding="async" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.7)" />
        ) : (
          <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
        )}
      </div>
      <div style="padding:96px 64px;display:flex;flex-direction:column;justify-content:center;background:var(--color-bg-card)">
        <div class="eyebrow" style="margin-bottom:18px">Tests &amp; avis indépendants</div>
        <h1 class="serif" style="font-size:clamp(40px, 5vw, 72px);line-height:1.05;font-weight:400;margin-bottom:24px;letter-spacing:-1px">
          Nos <em style="font-style:italic">verdicts</em> argumentés.
        </h1>
        <p style="font-size:17px;color:var(--color-text-muted);line-height:1.65;max-width:520px">
          {reviewArticles.length} tests publiés. Achetés en magasin ou prêtés et restitués. Aucune marque ne sponsorise nos avis.
        </p>
      </div>
    </div>
  </section>

  {/* Featured review */}
  {featured && (() => {
    const wikiImg = getArticleImage(featured.data.slug);
    const img = featured.data.heroImage ?? wikiImg;
    return (
      <section style="padding:120px 0;background:var(--color-bg-base)">
        <div class="site-container">
          <div class="eyebrow" style="margin-bottom:14px;text-align:center">À la une</div>
          <a href={getArticleUrl(featured)} style="display:block;text-decoration:none;color:inherit">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center" class="featured-grid">
              {img ? (
                <img src={img} alt={featured.data.title} style="width:100%;aspect-ratio:5/4;object-fit:cover" />
              ) : (
                <div style="width:100%;aspect-ratio:5/4;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
              )}
              <div>
                <div class="eyebrow" style="margin-bottom:14px;color:var(--color-accent)">★★★★★ Test approfondi</div>
                <h2 class="serif" style="font-size:clamp(34px, 3.5vw, 48px);line-height:1.1;font-weight:400;margin-bottom:24px;letter-spacing:-.5px">
                  {featured.data.title}
                </h2>
                {featured.data.description && (
                  <p style="font-size:16px;color:var(--color-text-muted);line-height:1.7;margin-bottom:24px">
                    {featured.data.description.slice(0, 220)}…
                  </p>
                )}
                <span class="link-underline">Lire le test complet</span>
              </div>
            </div>
          </a>
        </div>
      </section>
    );
  })()}

  {/* All reviews grid */}
  {restReviews.length > 0 && (
    <section style="padding:120px 0;border-top:1px solid var(--color-border)">
      <div class="site-container">
        <div class="eyebrow" style="margin-bottom:48px">Tous les tests · {reviewArticles.length}</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:48px">
          {restReviews.map((a) => {
            const wikiImg = getArticleImage(a.data.slug);
            const img = a.data.heroImage ?? wikiImg;
            return (
              <a href={getArticleUrl(a)} style="text-decoration:none;color:inherit;display:block">
                {img ? (
                  <img src={img} alt={a.data.title} style="width:100%;aspect-ratio:5/4;object-fit:cover;margin-bottom:18px" loading="lazy" />
                ) : (
                  <div style="width:100%;aspect-ratio:5/4;background:linear-gradient(135deg, var(--color-bg-2), var(--color-border));margin-bottom:18px"></div>
                )}
                <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:8px">
                  {a.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                </div>
                <h3 class="serif" style="font-size:22px;line-height:1.2;font-weight:400;margin-bottom:8px;letter-spacing:-.3px">{a.data.title}</h3>
                {a.data.description && (
                  <p style="font-size:14px;color:var(--color-text-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{a.data.description}</p>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</Base>

<style>
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr !important; }
  .hero-grid > div:nth-child(2) { padding: 48px 32px !important; }
  .featured-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
  h1 { font-size: 36px !important; }
  h2 { font-size: 28px !important; }
}
</style>
