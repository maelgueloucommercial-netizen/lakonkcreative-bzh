---
/**
 * /agenda/ — index des événements locaux (articles avec `eventDate`).
 * Groupé par mois, à venir d'abord. noindex tant que < 3 événements (page maigre).
 * Gating naturel : sur un site sans aucun `eventDate`, la page est quasi vide + noindex.
 */
import Base from '../../layouts/Base.astro';
import { articleUrl } from '../../lib/article-url';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../../lib/site-config';

const now = new Date();
const all = (await getCollection('articles'))
  .filter((a) => a.data.eventDate instanceof Date && !Number.isNaN(a.data.eventDate.getTime()))
  .filter((a) => (a.data.eventEndDate ?? a.data.eventDate) >= now)
  .sort((a, b) => a.data.eventDate!.getTime() - b.data.eventDate!.getTime());

// Groupé par « mois année »
const groups = new Map<string, typeof all>();
for (const a of all) {
  const key = a.data.eventDate!.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
  if (!groups.has(key)) groups.set(key, [] as typeof all);
  groups.get(key)!.push(a);
}
const placename = SITE_CONFIG.profile?.geo?.placename ?? SITE_CONFIG.siteName;
const title = `Agenda${placename ? ` — ${placename}` : ''} : événements à venir`;
const description = `Tous les événements à venir${placename ? ` à ${placename}` : ''} : festivals, marchés, concerts, sport et sorties.`;
const noindex = all.length < 3;
const fmtFull = (d: Date) => d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
const jsonLd = all.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: all.slice(0, 50).map((a, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: {
      '@type': 'Event', name: a.data.title,
      startDate: a.data.eventDate!.toISOString().slice(0, 10),
      ...(a.data.eventLocation || placename ? { location: { '@type': 'Place', name: a.data.eventLocation ?? placename } } : {}),
      url: new URL(articleUrl(a.data), SITE_CONFIG.siteUrl).toString(),
    },
  })),
} : undefined;
---
<Base title={title} description={description} noindex={noindex} jsonLd={jsonLd ? [jsonLd] : undefined}>
  <div class="site-container" style="padding:64px 0">
    <span class="hp-pill">Agenda</span>
    <h1 class="serif" style="font-size:clamp(36px,5vw,64px);line-height:1.04;font-weight:400;letter-spacing:-1px;margin:16px 0 8px">
      Événements à venir{placename ? ` à ${placename}` : ''}
    </h1>
    <p style="color:var(--color-text-muted);max-width:640px;margin:0 0 48px">{description}</p>

    {all.length === 0 && (
      <p style="color:var(--color-text-muted)">Aucun événement à venir pour le moment. Revenez bientôt.</p>
    )}

    {[...groups.entries()].map(([month, items]) => (
      <section style="margin-bottom:48px">
        <h2 class="serif" style="font-size:24px;font-weight:400;text-transform:capitalize;border-bottom:1px solid var(--color-border);padding-bottom:12px;margin-bottom:20px">{month}</h2>
        <ul style="list-style:none;padding:0;display:grid;gap:12px">
          {items.map((a) => (
            <li>
              <a href={articleUrl(a.data)} style="display:flex;gap:18px;align-items:baseline;text-decoration:none;color:inherit;padding:8px 0">
                <span class="serif" style="flex:0 0 auto;color:var(--color-accent);font-size:18px;min-width:90px">{a.data.eventDate!.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' })}</span>
                <span>
                  <strong style="font-weight:500;font-size:17px">{a.data.title}</strong>
                  <span style="display:block;font-size:13px;color:var(--color-text-muted)">{fmtFull(a.data.eventDate!)}{a.data.eventLocation ? ` · ${a.data.eventLocation}` : ''}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
