---
/**
 * Page de recherche interne (item #54 roadmap).
 *
 * Pagefind indexe le HTML statique au build (`postbuild` script) et expose
 * un bundle JS + un index segmenté téléchargé à la demande. La recherche
 * s'exécute côté client : pas de serveur requis, fonctionne sur Workers
 * Static Assets.
 *
 * Doc : https://pagefind.app/
 */
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<Base
  title="Recherche dans l'encyclopédie"
  description="Rechercher dans les régions, pâtes, lexique, articles et produits italiens authentiques de DaRocco."
  noindex
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Recherche' }]} />

    <header class="mb-8">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Recherche</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Rechercher dans l'encyclopédie
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Régions, pâtes, lexique culinaire, articles, produits AOP/DOP/IGP : tape un mot-clé,
        Pagefind cherche dans tout le contenu indexé.
      </p>
    </header>

    <div id="search" class="pagefind-host"></div>

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <script src="/pagefind/pagefind-ui.js" defer is:inline></script>
    <script is:inline>
      window.addEventListener('load', () => {
        if (typeof window.PagefindUI === 'undefined') {
          document.getElementById('search').innerHTML =
            '<p class="text-sm text-ink-700/70">L\'index de recherche n\'a pas encore été généré. Relance le build pour activer la recherche.</p>';
          return;
        }
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Rechercher (ex: pesto, Sicile, mantecatura…)',
            clear_search: 'Effacer',
            load_more: 'Charger plus',
            search_label: 'Recherche',
            filters_label: 'Filtres',
            zero_results: 'Aucun résultat pour [SEARCH_TERM]',
            many_results: '[COUNT] résultats pour [SEARCH_TERM]',
            one_result: '1 résultat pour [SEARCH_TERM]',
            alt_search: 'Aucun résultat pour [SEARCH_TERM]. Affichage des résultats pour [DIFFERENT_TERM]',
            search_suggestion: 'Aucun résultat pour [SEARCH_TERM]. Essayez : [DIFFERENT_TERM]',
            searching: 'Recherche…',
          },
        });
      });
    </script>

    <style>
      /* Adaptations Pagefind UI au thème DaRocco */
      .pagefind-ui {
        --pagefind-ui-primary: var(--color-terra-700);
        --pagefind-ui-text: var(--color-ink-900);
        --pagefind-ui-background: var(--color-cream-50);
        --pagefind-ui-border: var(--color-cream-200);
        --pagefind-ui-tag: var(--color-cream-100);
        --pagefind-ui-border-radius: 8px;
        --pagefind-ui-image-border-radius: 6px;
        --pagefind-ui-image-box-ratio: 3 / 2;
        --pagefind-ui-font: var(--font-sans);
      }
    </style>
  </section>
</Base>
