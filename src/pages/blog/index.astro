---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedPicture from '../../components/OptimizedPicture.astro';

const articles = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categoryLabels: Record<string, string> = {
  recette: 'Recettes',
  guide: 'Guides',
  antifraude: 'Antifraude',
  test: 'Tests produits',
  reportage: 'Reportages',
  lexique: 'Lexique',
};
---
<Base
  title="Articles — Recettes, guides, antifraude, tests"
  description="Tous les articles éditoriaux de DaRocco : recettes authentiques, guides techniques, articles antifraude, tests de produits italiens vendus en France."
>
  <section class="mx-auto max-w-7xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Articles' }]} />

    <header class="mb-12 max-w-3xl">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Articles éditoriaux</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Recettes, guides, et antifraude
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Articles écrits par Lorenzo. Recettes authentiques, guides techniques, comparatifs de produits, articles antifraude.
      </p>
    </header>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map((article) => (
        <a href={`/blog/${article.id}`} class="group flex flex-col">
          <div class="aspect-[16/10] bg-cream-200 rounded-lg mb-4 overflow-hidden">
            {article.data.image ? (
              <OptimizedPicture
                src={article.data.image}
                alt={article.data.imageAlt ?? article.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-cream-100/70 italic font-serif text-2xl bg-cream-200">
                {categoryLabels[article.data.category] ?? article.data.category}
              </div>
            )}
          </div>
          <p class="text-xs uppercase tracking-widest text-olive-700 mb-2">
            {categoryLabels[article.data.category] ?? article.data.category}
          </p>
          <h2 class="font-serif text-2xl text-ink-900 group-hover:text-terra-700 transition leading-tight mb-2">
            {article.data.title}
          </h2>
          <p class="text-sm text-ink-700/80 leading-relaxed line-clamp-3">{article.data.description}</p>
          <p class="mt-3 text-xs text-ink-700/60">
            {article.data.publishedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        </a>
      ))}
    </div>
  </section>
</Base>
