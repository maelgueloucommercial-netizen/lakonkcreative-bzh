---
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../lib/site-config';
import { WIKI_IMAGES } from '../lib/site-wiki-images';

const profile = SITE_CONFIG.profile;
const contactEmail = `mael.guelou.commercial@gmail.com`;
const heroSubject = profile?.wikiImageSubjects?.[2] ?? profile?.wikiImageSubjects?.[0];
const heroImg = heroSubject ? WIKI_IMAGES[heroSubject] : null;

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Nous contacter — ${SITE_CONFIG.siteName}`,
  description: `Contactez la rédaction de ${SITE_CONFIG.siteName}.`,
  url: `${SITE_CONFIG.siteUrl}/contact/`,
  mainEntity: {
    '@type': 'Organization',
    name: SITE_CONFIG.siteName,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'editorial',
      email: contactEmail,
      availableLanguage: ['fr'],
    },
  },
};
---
<Base
  title="Nous contacter"
  description={`Contactez la rédaction de ${SITE_CONFIG.siteName}.`}
  jsonLd={[contactPageSchema]}
>

  {/* Hero éditorial */}
  <section style="position:relative;padding:0;background:var(--color-bg-card)">
    <div style="display:grid;grid-template-columns:5fr 4fr;align-items:stretch" class="hero-grid">
      <div style="position:relative;min-height:480px;overflow:hidden">
        {heroImg ? (
          <img src={heroImg} alt={SITE_CONFIG.siteName} loading="eager" decoding="async" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.7)" />
        ) : (
          <div style="position:absolute;inset:0;background:linear-gradient(135deg, var(--color-primary), var(--color-ink))"></div>
        )}
      </div>
      <div style="padding:96px 64px;display:flex;flex-direction:column;justify-content:center">
        <div class="eyebrow" style="margin-bottom:18px">Nous écrire</div>
        <h1 class="serif" style="font-size:clamp(40px, 5vw, 72px);line-height:1.05;font-weight:400;margin-bottom:24px;letter-spacing:-1px">
          Une question ? <em style="font-style:italic">Une remarque</em> ?
        </h1>
        <p style="font-size:17px;color:var(--color-text-muted);line-height:1.65;max-width:520px">
          Nous lisons tous les messages et répondons sous 48&nbsp;h ouvrées.
        </p>
      </div>
    </div>
  </section>

  {/* Contact form + email */}
  <section style="padding:120px 0;background:var(--color-bg-base)">
    <div class="site-container site-container--narrow">

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-bottom:80px" class="contact-cards">
        <div style="border:1px solid var(--color-border);padding:40px">
          <div class="eyebrow" style="margin-bottom:14px">Par email</div>
          <h2 class="serif" style="font-size:32px;line-height:1.1;font-weight:400;margin-bottom:18px;letter-spacing:-.3px">
            Le moyen le plus <em style="font-style:italic">rapide</em>
          </h2>
          <p style="font-size:14px;color:var(--color-text-muted);margin-bottom:24px">Nous lisons chaque mail. Réponse sous 48&nbsp;h ouvrées.</p>
          <a href={`mailto:${contactEmail}`} class="serif" style="font-size:22px;color:var(--color-accent);text-decoration:underline;text-underline-offset:6px">{contactEmail}</a>
        </div>
        <div style="border:1px solid var(--color-border);padding:40px">
          <div class="eyebrow" style="margin-bottom:14px">Annonceurs</div>
          <h2 class="serif" style="font-size:32px;line-height:1.1;font-weight:400;margin-bottom:18px;letter-spacing:-.3px">
            <em style="font-style:italic">Communiquer</em> auprès de notre audience
          </h2>
          <p style="font-size:14px;color:var(--color-text-muted);margin-bottom:24px">Article sponsorisé, mention dans article existant, partenariat éditorial — voir tous les formats.</p>
          <a href="/annoncer-chez-nous/" class="link-underline">Page annonceurs</a>
        </div>
      </div>

      {/* Form */}
      <div style="border-top:1px solid var(--color-border);padding-top:80px">
        <div class="eyebrow" style="margin-bottom:14px">Formulaire</div>
        <h2 class="serif" style="font-size:clamp(36px, 4vw, 56px);line-height:1.05;font-weight:400;letter-spacing:-.5px;margin-bottom:48px">
          Écrivez-nous <em style="font-style:italic">directement</em>
        </h2>
        <form id="contact-form" style="display:grid;gap:24px;max-width:680px">
          <div>
            <label for="name" style="display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-ink);margin-bottom:8px;font-weight:600">Nom</label>
            <input type="text" id="name" name="name" required style="width:100%;padding:14px 0;border:0;border-bottom:1px solid var(--color-border);background:transparent;font-size:16px;font-family:'Cormorant Garamond',serif;color:var(--color-ink);outline:none" />
          </div>
          <div>
            <label for="email" style="display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-ink);margin-bottom:8px;font-weight:600">Email</label>
            <input type="email" id="email" name="email" required style="width:100%;padding:14px 0;border:0;border-bottom:1px solid var(--color-border);background:transparent;font-size:16px;font-family:'Cormorant Garamond',serif;color:var(--color-ink);outline:none" />
          </div>
          <div>
            <label for="subject" style="display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-ink);margin-bottom:8px;font-weight:600">Sujet</label>
            <select id="subject" name="subject" style="width:100%;padding:14px 0;border:0;border-bottom:1px solid var(--color-border);background:transparent;font-size:16px;font-family:'Cormorant Garamond',serif;color:var(--color-ink);outline:none">
              <option value="Une question">Une question</option>
              <option value="Signaler une correction">Signaler une correction</option>
              <option value="Proposer un article">Proposer un article</option>
              <option value="Partenariat ou annonceur">Partenariat ou annonceur</option>
              <option value="Autre">Autre</option>
            </select>
          </div>
          <div>
            <label for="message" style="display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-ink);margin-bottom:8px;font-weight:600">Message</label>
            <textarea id="message" name="message" required rows="6" style="width:100%;padding:14px 0;border:0;border-bottom:1px solid var(--color-border);background:transparent;font-size:16px;font-family:'Cormorant Garamond',serif;color:var(--color-ink);outline:none;resize:vertical"></textarea>
          </div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;height:0;width:0" aria-hidden="true" />
          <div style="margin-top:16px">
            <button type="submit" class="btn-fill">Envoyer le message</button>
          </div>
          <p style="font-size:12px;color:var(--color-text-muted);margin-top:8px">
            Vos données ne sont utilisées que pour vous répondre. Voir notre <a href="/politique-de-confidentialite/" style="color:var(--color-accent);text-decoration:underline">politique de confidentialité</a>.
          </p>
        </form>
      </div>

    </div>
  </section>

  <script define:vars={{ contactEmail }}>
    const form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const honeypot = form.querySelector('input[name=website]');
        if (honeypot && honeypot.value) return;
        const fd = new FormData(form);
        const subject = encodeURIComponent(`[Contact] ${fd.get('subject') || 'Message'}`);
        const body = encodeURIComponent(`Nom : ${fd.get('name')}\nEmail : ${fd.get('email')}\n\n${fd.get('message')}`);
        window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
      });
    }
  </script>
</Base>
<style>
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr !important; }
  .hero-grid > div:nth-child(2) { padding: 48px 32px !important; }
  .contact-cards { grid-template-columns: 1fr !important; gap: 32px !important; }
  h1 { font-size: 36px !important; }
  h2 { font-size: 26px !important; }
}
</style>
