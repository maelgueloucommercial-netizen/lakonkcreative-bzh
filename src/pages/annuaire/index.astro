---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedPicture from '../../components/OptimizedPicture.astro';

const epiciers = (await getCollection('epiciers')).sort((a, b) => a.data.city.localeCompare(b.data.city));
const byCity = epiciers.reduce<Record<string, typeof epiciers>>((acc, e) => {
  (acc[e.data.city] ||= []).push(e);
  return acc;
}, {});
---
<Base
  title="Annuaire des épiciers italiens en France"
  description="L'annuaire des vraies épiceries italiennes en France, sélectionnées pour leur authenticité — produits AOP/DOP, fournisseurs italiens directs, qualité de fraîcheur."
>
  <section class="mx-auto max-w-7xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Annuaire' }]} />

    <header class="mb-12 max-w-3xl">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Annuaire</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Épiciers italiens en France
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Les vraies épiceries italiennes — celles qui se fournissent en direct chez des producteurs identifiés, qui maîtrisent les AOP/DOP, et qui font tourner leur stock assez vite pour que vous trouviez du frais. Sélection éditoriale, sans rétribution des établissements listés.
      </p>
    </header>

    {Object.entries(byCity).map(([city, items]) => (
      <div class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-4 border-b border-cream-200 pb-2">{city}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((e) => (
            <article class="rounded-lg border border-cream-200 bg-white overflow-hidden flex flex-col">
              <div class="overflow-hidden aspect-[16/10] bg-cream-100">
                {e.data.image ? (
                  <OptimizedPicture
                    src={e.data.image}
                    alt={`${e.data.name} — épicerie italienne à ${e.data.city}`}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center font-serif text-3xl bg-gradient-to-br from-terra-100 to-cream-200 text-terra-600">
                    🏪
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <h3 class="font-serif text-xl text-ink-900 mb-1">{e.data.name}</h3>
                <p class="text-xs text-olive-700 mb-3">{e.data.address}, {e.data.postalCode} {e.data.city}</p>
                <p class="text-sm text-ink-700/80 mb-4 flex-1">{e.data.description}</p>
                <ul class="space-y-1 text-xs text-ink-700/70">
                  {e.data.specialties.slice(0, 3).map((s) => <li>· {s}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}

    <p class="text-sm text-ink-700/60 mt-12">
      Vous tenez une épicerie italienne authentique en France et souhaitez être référencé(e) ? Écrivez-nous.
    </p>
  </section>
</Base>
