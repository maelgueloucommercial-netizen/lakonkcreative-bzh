---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import OptimizedPicture from '../../components/OptimizedPicture.astro';
import PastaPairing from '../../components/PastaPairing.tsx';

const pates = (await getCollection('pates')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const pastaForPairing = pates.map((p) => ({
  id: p.id,
  name: p.data.name,
  type: p.data.type,
  region: p.data.region,
  fresh: p.data.fresh,
  cookingTimeMinutes: p.data.cookingTimeMinutes,
  sauces: p.data.sauces,
}));
const byType = pates.reduce<Record<string, typeof pates>>((acc, p) => {
  (acc[p.data.type] ||= []).push(p);
  return acc;
}, {});
const typeOrder = ['longue', 'courte', 'farcie', 'plate', 'à soupe', 'à four', 'irrégulière'] as const;
---
<Base
  title="Base de données des pâtes italiennes — Formats, sauces, cuisson"
  description="Plus de 300 formats de pâtes italiennes documentés. Sauce compatible (règle d'aderenza), temps de cuisson exact, région d'origine, marques artisanales recommandées."
>
  <section class="mx-auto max-w-7xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Base de pâtes' }]} />

    <header class="mb-10 max-w-3xl">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Encyclopédie des formats</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Base de données des pâtes
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Chaque format de pâte a été conçu pour une famille de sauces. C'est la règle de l'<em>aderenza</em> — l'adhérence sauce-pâte. Tagliatelle au ragù, bucatini all'amatriciana, orecchiette aux cime di rapa : ces mariages ne sont pas des conventions arbitraires, ce sont des solutions techniques.
      </p>
    </header>

    <div class="mb-12">
      <PastaPairing pasta={pastaForPairing} client:load />
    </div>

    {typeOrder.map((type) => byType[type]?.length ? (
      <div class="mb-12">
        <h2 class="font-serif text-2xl text-ink-900 mb-4 border-b border-cream-200 pb-2">
          Pâtes {type}{byType[type].length > 1 ? 's' : ''}
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {byType[type].map((pate) => (
            <a href={`/pates/${pate.id}`} class="group rounded-lg border border-cream-200 bg-white overflow-hidden hover:border-terra-300 hover:shadow-md transition flex flex-col">
              <div class="overflow-hidden aspect-[16/10] bg-cream-100">
                {pate.data.image ? (
                  <OptimizedPicture
                    src={pate.data.image}
                    alt={`${pate.data.name} — format de pâtes italiennes`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center font-serif text-3xl text-cream-50/60 italic bg-gradient-to-br from-olive-200 to-cream-200">
                    🍝
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <h3 class="font-serif text-2xl text-ink-900 mb-1 group-hover:text-terra-700 transition">{pate.data.name}</h3>
                <p class="text-xs text-olive-700 mb-3">
                  {pate.data.fresh ? 'Pâte fraîche' : 'Pâte sèche'}
                  {pate.data.region && ` · ${pate.data.region}`}
                </p>
                <p class="text-sm text-ink-700/80 line-clamp-3 flex-1">{pate.data.description}</p>
                <p class="mt-4 text-xs uppercase tracking-widest text-olive-700">
                  {pate.data.cookingTimeMinutes[0]}-{pate.data.cookingTimeMinutes[1]} min · {pate.data.sauces.length} sauces
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    ) : null)}

    <p class="text-sm text-ink-700/60 mt-12">
      Au total : {pates.length} formats documentés. La base sera enrichie progressivement vers les 300 formats recensés.
    </p>
  </section>
</Base>
