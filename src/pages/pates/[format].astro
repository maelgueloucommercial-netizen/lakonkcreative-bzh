---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import RecentlyRead from '../../components/RecentlyRead.astro';
import OptimizedPicture from '../../components/OptimizedPicture.astro';
import { buildPastaFaq } from '../../lib/faq-heuristics';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const pates = await getCollection('pates');
  return pates.map((p) => ({ params: { format: p.id }, props: { pate: p } }));
}

const { pate } = Astro.props;
const { Content, headings } = await render(pate);

const faqItems = pate.data.faq ?? buildPastaFaq(pate.data);
const updatedAtNotPub = pate.data.updatedAt.valueOf() !== pate.data.publishedAt.valueOf();

/**
 * Item #41 — résolution région→slug pour créer un lien entrant vers la fiche
 * région depuis chaque page pâte qui mentionne sa région d'origine.
 */
let regionSlug: string | null = null;
if (pate.data.region) {
  const allRegions = await getCollection('regions');
  const found = allRegions.find((r) => r.data.name === pate.data.region);
  if (found) regionSlug = found.id;
}
---
<Base
  title={`${pate.data.name} — Format, sauces compatibles, cuisson`}
  description={pate.data.description}
  type="article"
  publishedAt={pate.data.publishedAt}
  updatedAt={pate.data.updatedAt}
  preloadImage={pate.data.image}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: `${pate.data.name} — Format, sauces compatibles, cuisson`,
      description: pate.data.description,
      author: { '@type': 'Person', name: 'Lorenzo Da Rocco' },
      datePublished: pate.data.publishedAt.toISOString(),
      dateModified: pate.data.updatedAt.toISOString(),
      about: { '@id': `https://darocco.fr/pates/${pate.id}#pasta` },
      mentions: pate.data.sauces.map((s) => ({ '@type': 'Thing', name: s })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Thing',
      '@id': `https://darocco.fr/pates/${pate.id}#pasta`,
      name: pate.data.name,
      alternateName: pate.data.nameItalian,
      description: pate.data.description,
      ...(pate.data.region ? { locationCreated: { '@type': 'Place', name: pate.data.region } } : {}),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: `Cuisson des ${pate.data.name}`,
      description: `Cuisson al dente des ${pate.data.name}, format ${pate.data.fresh ? 'frais' : 'sec'}.`,
      totalTime: `PT${pate.data.cookingTimeMinutes[1] + 5}M`,
      tool: [
        { '@type': 'HowToTool', name: 'Grande casserole' },
        { '@type': 'HowToTool', name: 'Passoire' },
      ],
      supply: [
        { '@type': 'HowToSupply', name: `${pate.data.name} (100 g par personne)` },
        { '@type': 'HowToSupply', name: 'Eau (1 L par 100 g)' },
        { '@type': 'HowToSupply', name: 'Sel (10 g par L d\'eau)' },
      ],
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Faire bouillir l\'eau salée', text: 'Porter à ébullition une grande quantité d\'eau (1 L pour 100 g de pâtes), puis ajouter le sel (10 g par L). Attendre la reprise de l\'ébullition.' },
        { '@type': 'HowToStep', position: 2, name: 'Plonger les pâtes', text: `Plonger les ${pate.data.name} dans l\'eau bouillante. Remuer immédiatement avec une cuillère pour éviter qu\'elles ne collent au fond.` },
        { '@type': 'HowToStep', position: 3, name: 'Cuire al dente', text: `Cuire ${pate.data.cookingTimeMinutes[0]} à ${pate.data.cookingTimeMinutes[1]} minutes en goûtant à partir de la borne basse. La pâte doit garder une légère résistance au cœur (al dente).` },
        { '@type': 'HowToStep', position: 4, name: 'Réserver de l\'eau de cuisson', text: 'Avant d\'égoutter, prélever une louche d\'eau de cuisson amidonnée pour ajuster la liaison de la sauce.' },
        { '@type': 'HowToStep', position: 5, name: 'Mélanger hors du feu', text: 'Égoutter rapidement, mélanger immédiatement à la sauce dans la poêle hors du feu, en ajoutant un peu d\'eau de cuisson si besoin pour lier (mantecatura).' },
      ],
    },
  ]}
>
  <RecentlyRead logSlug={pate.id} logTitle={`${pate.data.name} — pâtes italiennes`} logUrl={new URL(`/pates/${pate.id}`, SITE.url).toString()} />
  <article class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Pâtes', href: '/pates' }, { label: pate.data.name }]} />

    <header class="mb-10">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">
        Pâte {pate.data.fresh ? 'fraîche' : 'sèche'} · {pate.data.type}
      </p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-3">{pate.data.name}</h1>
      {pate.data.region && (
        <p class="text-lg italic text-ink-700">
          Origine : {regionSlug ? (
            <a href={`/regions/${regionSlug}`} class="text-terra-700 hover:text-terra-900 underline-offset-2 hover:underline">{pate.data.region}</a>
          ) : pate.data.region}
        </p>
      )}
      {updatedAtNotPub && (
        <p class="mt-3 text-xs text-ink-700/60">
          Mis à jour le {pate.data.updatedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      )}
    </header>

    {pate.data.image && (
      <figure class="mb-10 -mx-6 sm:mx-0">
        <OptimizedPicture src={pate.data.image} alt={`${pate.data.name} cuites`} lazy={false} />
      </figure>
    )}

    <div class="grid sm:grid-cols-3 gap-3 mb-10">
      <div class="rounded-lg border border-cream-200 bg-white p-4 text-center">
        <p class="text-xs uppercase tracking-widest text-olive-700 mb-1">Cuisson</p>
        <p class="font-serif text-2xl text-ink-900">{pate.data.cookingTimeMinutes[0]}-{pate.data.cookingTimeMinutes[1]} min</p>
      </div>
      <div class="rounded-lg border border-cream-200 bg-white p-4 text-center">
        <p class="text-xs uppercase tracking-widest text-olive-700 mb-1">Type</p>
        <p class="font-serif text-2xl text-ink-900">{pate.data.fresh ? 'Fraîche' : 'Sèche'}</p>
      </div>
      <div class="rounded-lg border border-cream-200 bg-white p-4 text-center">
        <p class="text-xs uppercase tracking-widest text-olive-700 mb-1">Format</p>
        <p class="font-serif text-2xl text-ink-900">{pate.data.type}</p>
      </div>
    </div>

    <section class="rounded-lg border border-olive-200 bg-olive-50 p-5 mb-6">
      <h2 class="font-serif text-lg text-ink-900 mb-3">Sauces compatibles (règle d'aderenza)</h2>
      <ul class="space-y-1.5 text-sm text-ink-700">
        {pate.data.sauces.map((s) => <li>· {s}</li>)}
      </ul>
    </section>

    <section class="rounded-lg border border-cream-200 bg-cream-100 p-5 mb-10">
      <h2 class="font-serif text-lg text-ink-900 mb-1">Calculateur de portion</h2>
      <p class="text-xs text-ink-700/70 mb-4">
        Règles italiennes : pâtes <strong>{pate.data.fresh ? 'fraîches' : 'sèches'}</strong> = environ <strong>{pate.data.fresh ? '120 g' : '90 g'}</strong> par personne en plat principal · <strong>{pate.data.fresh ? '70 g' : '50 g'}</strong> en entrée · ajustement ±20% selon appétit.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 items-end">
        <label class="block">
          <span class="block text-xs text-ink-700/70 mb-1">Convives</span>
          <input id="portion-people" type="number" min="1" max="50" value="4" class="w-full rounded-md border border-cream-200 px-3 py-2 text-sm focus:outline-none focus:border-terra-500" />
        </label>
        <label class="block">
          <span class="block text-xs text-ink-700/70 mb-1">Service</span>
          <select id="portion-mode" class="w-full rounded-md border border-cream-200 px-3 py-2 text-sm focus:outline-none focus:border-terra-500">
            <option value="main">Plat principal</option>
            <option value="starter">Entrée / primo</option>
          </select>
        </label>
        <label class="block">
          <span class="block text-xs text-ink-700/70 mb-1">Appétit</span>
          <select id="portion-appetit" class="w-full rounded-md border border-cream-200 px-3 py-2 text-sm focus:outline-none focus:border-terra-500">
            <option value="0.8">Léger (-20%)</option>
            <option value="1" selected>Normal</option>
            <option value="1.2">Costaud (+20%)</option>
          </select>
        </label>
        <div class="rounded-md bg-terra-600 text-cream-50 p-3 text-center">
          <div class="text-xs uppercase tracking-widest text-cream-100/80">Quantité</div>
          <div class="font-serif text-2xl"><span id="portion-result">360</span> g</div>
        </div>
      </div>
      <p class="text-xs text-ink-700/60 mt-3">À cela tu ajoutes <strong>1 L d'eau pour 100 g</strong> de pâtes et <strong>10 g de sel par L</strong>. Pour <span id="portion-water">3,6</span> L d'eau salée à <span id="portion-salt">36</span> g.</p>
      <script is:inline define:vars={{fresh: pate.data.fresh}}>
        (function () {
          const baseMain = fresh ? 120 : 90;
          const baseStarter = fresh ? 70 : 50;
          const peopleEl = document.getElementById('portion-people');
          const modeEl = document.getElementById('portion-mode');
          const appetEl = document.getElementById('portion-appetit');
          const resultEl = document.getElementById('portion-result');
          const waterEl = document.getElementById('portion-water');
          const saltEl = document.getElementById('portion-salt');
          function recalc() {
            const p = Math.max(1, parseInt(peopleEl.value, 10) || 1);
            const base = modeEl.value === 'starter' ? baseStarter : baseMain;
            const f = parseFloat(appetEl.value) || 1;
            const total = Math.round(p * base * f);
            resultEl.textContent = total;
            const water = (total / 100).toFixed(1).replace('.', ',');
            const salt = Math.round((total / 100) * 10);
            waterEl.textContent = water;
            saltEl.textContent = salt;
          }
          [peopleEl, modeEl, appetEl].forEach((el) => el.addEventListener('input', recalc));
          recalc();
        })();
      </script>
    </section>

    <TableOfContents headings={headings} />

    <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-ink-900 prose-a:text-terra-700 prose-h2:scroll-mt-24 prose-h3:scroll-mt-24">
      <Content />
    </div>

    <FAQBlock items={faqItems} />

    <ShareButtons title={`${pate.data.name} — format, sauces, cuisson`} />

    <SeeAlso kind="pasta" currentSlug={pate.id} region={pate.data.region} />

    <footer class="mt-16 pt-6 border-t border-cream-200 text-sm text-ink-700/60">
      Publié le {pate.data.publishedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
      {updatedAtNotPub && (
        <> · Mis à jour le {pate.data.updatedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</>
      )}
    </footer>
  </article>
</Base>
