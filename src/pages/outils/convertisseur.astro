---
import Base from '../../layouts/Base.astro';
import { SITE_CONFIG } from '../../lib/site-config';

const archetype = SITE_CONFIG.theme.archetype;

const CONVERTERS: Record<string, Array<{ id: string; label: string; from: string; to: string; factor: number; explain: string }>> = {
  bricolage: [
    { id: 'cv-w', label: 'Watts ↔ Chevaux-vapeur', from: 'W', to: 'CV', factor: 1 / 735.5, explain: '1 cheval-vapeur = 735,5 watts (norme métrique européenne).' },
    { id: 'm3-l', label: 'Mètres cubes ↔ Litres', from: 'm³', to: 'L', factor: 1000, explain: '1 m³ = 1000 litres. Utile pour les calculs de volume béton, eau, peinture.' },
    { id: 'mm-cm', label: 'Millimètres ↔ Centimètres', from: 'mm', to: 'cm', factor: 0.1, explain: '10 mm = 1 cm. Conversion essentielle pour les plans et plaques.' },
    { id: 'kg-t', label: 'Kilogrammes ↔ Tonnes', from: 'kg', to: 't', factor: 0.001, explain: '1 tonne = 1000 kg. Utile pour les charges admissibles et le transport.' },
  ],
  tech: [
    { id: 'lm-cd', label: 'Lumens ↔ Candelas (faisceau 30°)', from: 'lm', to: 'cd', factor: 1 / 0.5, explain: 'Approximation pour un faisceau de 30°. Le rapport varie selon l\'angle. Voir les fiches techniques fabricants.' },
    { id: 'pix-Mp', label: 'Pixels ↔ Mégapixels', from: 'px', to: 'Mp', factor: 0.000001, explain: '1 Mp = 1 million de pixels. Utile pour comparer la résolution d\'appareils photo.' },
    { id: 'go-mo', label: 'Gigaoctets ↔ Mégaoctets', from: 'Go', to: 'Mo', factor: 1024, explain: '1 Go = 1024 Mo (système binaire). Norme stockage informatique.' },
    { id: 'mbps-MB', label: 'Mb/s ↔ Mo/s (téléchargement)', from: 'Mb/s', to: 'Mo/s', factor: 1 / 8, explain: '1 Mo/s = 8 Mb/s. Les opérateurs annoncent en Mégabits, le téléchargement réel se mesure en Mégaoctets.' },
  ],
  village: [
    { id: 'are-m2', label: 'Ares ↔ Mètres carrés', from: 'a', to: 'm²', factor: 100, explain: '1 are = 100 m². Utilisé pour les surfaces de terrains.' },
    { id: 'ha-m2', label: 'Hectares ↔ Mètres carrés', from: 'ha', to: 'm²', factor: 10000, explain: '1 hectare = 10 000 m² = 100 ares.' },
    { id: 'km-mi', label: 'Kilomètres ↔ Miles', from: 'km', to: 'mi', factor: 0.621371, explain: '1 km = 0,621 miles. Utile pour les conversions touristiques.' },
    { id: 'C-F', label: 'Celsius ↔ Fahrenheit', from: '°C', to: '°F', factor: 1.8, explain: 'Formule : °F = °C × 1,8 + 32. Conversion utile pour visiteurs anglo-saxons.' },
  ],
  adulte: [
    { id: 'mm-cm', label: 'Millimètres ↔ Centimètres', from: 'mm', to: 'cm', factor: 0.1, explain: '10 mm = 1 cm.' },
    { id: 'in-cm', label: 'Pouces ↔ Centimètres', from: 'in', to: 'cm', factor: 2.54, explain: '1 pouce = 2,54 cm. Conversion utile pour produits anglo-saxons.' },
    { id: 'ml-fl-oz', label: 'Millilitres ↔ Onces fluides US', from: 'ml', to: 'fl oz', factor: 0.033814, explain: '1 ml = 0,034 fl oz US. Utile pour les contenances de produits.' },
  ],
};

const list = CONVERTERS[archetype] ?? CONVERTERS.village;
---
<Base
  noindex={!(SITE_CONFIG.profile?.tools ?? []).some((t) => t.slug === 'convertisseur')}
  title="Convertisseurs d'unités"
  description={`Convertisseurs d'unités gratuits sur ${SITE_CONFIG.siteName}. Saisissez une valeur, conversion instantanée.`}
>

  {/* Hero éditorial */}
  <section style="padding:80px 0 56px;background:var(--color-bg-card);border-bottom:1px solid var(--color-border)">
    <div class="site-container site-container--narrow">
      <div class="eyebrow" style="margin-bottom:18px">Convertisseurs</div>
      <h1 class="serif" style="font-size:clamp(40px, 5vw, 64px);line-height:1.05;font-weight:400;margin-bottom:20px;letter-spacing:-1px">
        {list.length} unités, conversion <em style="font-style:italic">directe</em>.
      </h1>
      <p style="font-size:16px;color:var(--color-text-muted);line-height:1.7;max-width:620px">
        Saisissez une valeur, le résultat s'affiche en direct dans les deux sens.
      </p>
    </div>
  </section>

  {/* Convertisseurs */}
  <section style="padding:64px 0 96px;background:var(--color-bg-base)">
    <div class="site-container site-container--narrow">
      {list.map((c, i) => (
        <section style={`padding:${i === 0 ? '0' : '48px'} 0 48px;${i > 0 ? 'border-top:1px solid var(--color-border)' : ''}`} data-conv data-factor={c.factor}>
          <h2 class="serif" style="font-size:clamp(22px, 2.4vw, 28px);line-height:1.15;font-weight:400;letter-spacing:-.3px;margin-bottom:8px">{c.label}</h2>
          <p style="font-size:14px;color:var(--color-text-muted);line-height:1.65;margin-bottom:28px;max-width:680px">{c.explain}</p>
          <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:end" class="conv-grid">
            <label style="display:block">
              <span style="display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-ink);margin-bottom:8px;font-weight:600">{c.from}</span>
              <input type="number" step="any" data-side="from" style="width:100%;padding:10px 0;border:0;border-bottom:1px solid var(--color-border);background:transparent;font-family:'Cormorant Garamond',serif;font-size:28px;color:var(--color-ink);outline:none" value="1" />
            </label>
            <span class="serif" style="font-size:24px;color:var(--color-accent);font-style:italic;padding-bottom:14px">↔</span>
            <label style="display:block">
              <span style="display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--color-ink);margin-bottom:8px;font-weight:600">{c.to}</span>
              <input type="number" step="any" data-side="to" style="width:100%;padding:10px 0;border:0;border-bottom:1px solid var(--color-border);background:transparent;font-family:'Cormorant Garamond',serif;font-size:28px;color:var(--color-accent);font-style:italic;outline:none" />
            </label>
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>
<style>
@media (max-width: 700px) {
  .conv-grid { grid-template-columns: 1fr !important; }
  .conv-grid > span { display: none; }
}
</style>

<script>
  document.querySelectorAll('[data-conv]').forEach((card) => {
    const factor = parseFloat(card.dataset.factor);
    const inputs = card.querySelectorAll('input');
    const fromI = card.querySelector('[data-side=from]');
    const toI = card.querySelector('[data-side=to]');
    function update(src) {
      if (src === 'from') {
        const v = parseFloat(fromI.value) || 0;
        toI.value = (v * factor).toString();
      } else {
        const v = parseFloat(toI.value) || 0;
        fromI.value = (v / factor).toString();
      }
    }
    fromI.addEventListener('input', () => update('from'));
    toI.addEventListener('input', () => update('to'));
    update('from');
  });
</script>
