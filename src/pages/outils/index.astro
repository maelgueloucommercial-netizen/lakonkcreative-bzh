---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const tools = [
  {
    href: '/outils/selecteur-huile',
    title: 'Sélecteur d\'huile d\'olive',
    description: 'Identifie l\'huile italienne adaptée à votre usage et intensité préférée.',
    icon: '🫒',
  },
  {
    href: '/outils/timer-mantecatura',
    title: 'Timer mantecatura',
    description: 'Chronomètre interactif pour l\'étape finale du risotto, hors du feu.',
    icon: '⏱',
  },
  {
    href: '/outils/quiz-regions',
    title: 'Quiz régions italiennes',
    description: '10 questions pour tester votre connaissance de la cuisine régionale d\'Italie.',
    icon: '🇮🇹',
  },
  {
    href: '/outils/carte-epiciers',
    title: 'Carte des épiciers italiens',
    description: 'Annuaire géolocalisé des épiceries italiennes authentiques en France.',
    icon: '📍',
  },
  {
    href: '/recherche',
    title: 'Recherche dans l\'encyclopédie',
    description: 'Pagefind sur les régions, pâtes, lexique, articles, produits et épiciers.',
    icon: '🔍',
  },
];
---
<Base
  title="Outils interactifs"
  description="Outils interactifs DaRocco pour choisir, calculer et comprendre la cuisine italienne authentique."
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Outils' }]} />

    <header class="mb-10">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Outils</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Outils interactifs
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        Quelques outils web simples qui complètent l'encyclopédie : sélecteurs, calculateurs, recherche.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 gap-4">
      {tools.map((t) => (
        <a href={t.href} class="block rounded-lg border border-cream-200 bg-white p-6 hover:border-terra-300 hover:bg-cream-50 transition">
          <p class="text-3xl mb-3">{t.icon}</p>
          <p class="font-serif text-xl text-ink-900 mb-1">{t.title}</p>
          <p class="text-sm text-ink-700/70">{t.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
