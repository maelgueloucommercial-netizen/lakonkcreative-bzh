---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RegionsQuiz from '../../components/RegionsQuiz.tsx';
---
<Base
  title="Quiz régions italiennes — connaissez-vous la cuisine d'Italie ?"
  description="Quiz interactif 10 questions sur la cuisine italienne régionale : associations région ↔ plat, AOP/DOP, pâtes, vins. Score + explications pédagogiques."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    name: 'Quiz régions italiennes',
    description: 'Quiz à choix multiple sur la cuisine régionale d\'Italie.',
    educationalLevel: 'beginner',
    isPartOf: { '@id': 'https://darocco.fr#website' },
  }}
>
  <section class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumb items={[{ label: 'Outils', href: '/outils' }, { label: 'Quiz régions' }]} />

    <header class="mb-10">
      <p class="text-xs uppercase tracking-widest text-olive-700 mb-3">Outil interactif</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-ink-900 leading-tight mb-4">
        Connaissez-vous la cuisine italienne régionale ?
      </h1>
      <p class="text-lg text-ink-700 leading-relaxed">
        10 questions à choix multiple sur les associations région ↔ plat, AOP/DOP, pâtes traditionnelles, vins.
        Pas de pénalité au mauvais choix : chaque question donne une explication pédagogique. À la fin, votre score sur 10.
      </p>
    </header>

    <RegionsQuiz client:load />

    <div class="mt-12 prose prose-lg max-w-none">
      <h2>Pourquoi un quiz ?</h2>
      <p>
        L'Italie n'a pas <em>une</em> cuisine, mais vingt — une par région administrative. Confondre l'amatriciana romaine avec la
        carbonara, le risotto milanais avec celui de Vérone, le pesto génois avec une simple sauce au basilic, c'est passer à côté
        de la diversité réelle. Ce quiz est notre manière ludique de vous tester sur les associations clés.
      </p>

      <h2>Pour aller plus loin</h2>
      <p>
        Visitez la <a href="/regions">carte interactive des régions</a>, ou consultez nos <a href="/pates">fiches sur les formats de pâtes</a>
        et notre <a href="/aop-dop-igp-italie">guide complet AOP / DOP / IGP</a>.
      </p>
    </div>
  </section>
</Base>
