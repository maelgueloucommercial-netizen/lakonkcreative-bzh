---
import { getCollection } from 'astro:content';
import Article from '../layouts/Article.astro';

export async function getStaticPaths() {
  // Exclut hub/faq/lexique : ils ont des routes dédiées (/dossier/, /faq/, /glossaire/)
  // → évite le doublon d'URL avec ce catch-all.
  const articles = await getCollection('articles', ({ data }) => data.dateUrlFormat === false && !['hub', 'faq', 'lexique'].includes((data.pageType ?? 'article')));
  return articles.map((entry) => {
    // urlPath = "tourisme" or "ma-ville/restaurants" — slug catch-all les segments
    const segments = entry.data.urlPath ? `${entry.data.urlPath}/${entry.data.slug}` : entry.data.slug;
    return {
      params: { slug: segments },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
---
<Article entry={entry} />
