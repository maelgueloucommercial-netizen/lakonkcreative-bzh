{
  "$ref": "#/definitions/etudesPrix",
  "definitions": {
    "etudesPrix": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "slug": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "modifiedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "author": {
          "type": "string"
        },
        "seoScore": {
          "type": "number"
        },
        "keywordVolume": {
          "type": "number"
        },
        "noindex": {
          "type": "boolean"
        },
        "heroImage": {
          "type": "string"
        },
        "heroImageAlt": {
          "type": "string"
        },
        "priceFrom": {
          "type": "string"
        },
        "priceRange": {
          "type": "string"
        },
        "ctaLabel": {
          "type": "string",
          "default": "Obtenir des devis gratuits"
        },
        "ctaHref": {
          "type": "string",
          "default": "/devis/"
        },
        "phone": {
          "type": "string"
        },
        "priceTables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "titre": {
                "type": "string"
              },
              "cols": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "default": []
              }
            },
            "required": [
              "titre"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "facteurs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "titre": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            },
            "required": [
              "titre",
              "desc"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "slug",
        "pubDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}