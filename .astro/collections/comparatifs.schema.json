{
  "$ref": "#/definitions/comparatifs",
  "definitions": {
    "comparatifs": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "slug": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "modifiedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "author": {
          "type": "string"
        },
        "noindex": {
          "type": "boolean"
        },
        "seoScore": {
          "type": "number"
        },
        "keywordVolume": {
          "type": "number"
        },
        "heroImage": {
          "type": "string"
        },
        "a": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "brand": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "imageAlt": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "scoreMax": {
              "type": "number",
              "default": 10
            },
            "priceLow": {
              "type": "number"
            },
            "priceHigh": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "default": "EUR"
            },
            "pros": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "cons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "bestFor": {
              "type": "string"
            },
            "merchants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "price": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "url"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "ctaUrl": {
              "type": "string"
            },
            "ctaLabel": {
              "type": "string",
              "default": "Voir le prix"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "b": {
          "$ref": "#/definitions/comparatifs/properties/a"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "winner": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "tie"
                ],
                "default": "tie"
              }
            },
            "required": [
              "label",
              "a",
              "b"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "titre": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              },
              "winner": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "tie"
                ]
              }
            },
            "required": [
              "titre",
              "desc"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "verdict": {
          "type": "string"
        },
        "winner": {
          "type": "string",
          "enum": [
            "a",
            "b"
          ]
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "relatedGuides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "slug",
        "pubDate",
        "a",
        "b"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}