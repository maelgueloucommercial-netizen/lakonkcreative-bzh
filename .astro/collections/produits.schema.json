{
  "$ref": "#/definitions/produits",
  "definitions": {
    "produits": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "slug": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "categoryLabel": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "modifiedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "seoScore": {
          "type": "number"
        },
        "keywordVolume": {
          "type": "number"
        },
        "noindex": {
          "type": "boolean"
        },
        "brand": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "priceText": {
          "type": "string"
        },
        "oldPrice": {
          "type": "number"
        },
        "priceLow": {
          "type": "number"
        },
        "priceHigh": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "EUR"
        },
        "availability": {
          "type": "string",
          "default": "https://schema.org/InStock"
        },
        "merchants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "price": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "reviewCount": {
          "type": "number"
        },
        "ratingBars": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": []
        },
        "avis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "auteur": {
                "type": "string"
              },
              "note": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "texte": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            },
            "required": [
              "auteur",
              "note",
              "texte"
            ],
            "additionalProperties": false
          }
        },
        "usps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "verdict": {
          "type": "string"
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "recommande",
            "reserves",
            "eviter"
          ]
        },
        "badge": {
          "type": "string"
        },
        "bestFor": {
          "type": "string"
        },
        "scoreGlobal": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "note": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "note"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "attributes": {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string"
            },
            "techno": {
              "type": "string"
            },
            "lumens": {
              "type": "number"
            },
            "usages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "ctaUrl": {
          "type": "string"
        },
        "ctaLabel": {
          "type": "string",
          "default": "Voir l'offre"
        },
        "relatedSlugs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "slug",
        "category",
        "pubDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}