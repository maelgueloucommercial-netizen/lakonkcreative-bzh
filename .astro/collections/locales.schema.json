{
  "$ref": "#/definitions/locales",
  "definitions": {
    "locales": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "service": {
          "type": "string"
        },
        "serviceSlug": {
          "type": "string"
        },
        "ville": {
          "type": "string"
        },
        "villeSlug": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "departement": {
          "type": "string"
        },
        "codePostal": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "modifiedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "seoScore": {
          "type": "number"
        },
        "keywordVolume": {
          "type": "number"
        },
        "heroImage": {
          "type": "string"
        },
        "heroImageAlt": {
          "type": "string"
        },
        "priceFrom": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "ctaLabel": {
          "type": "string",
          "default": "Demander un devis gratuit"
        },
        "ctaHref": {
          "type": "string",
          "default": "/devis/"
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "noindex": {
          "type": "boolean"
        },
        "usps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "horaires": {
          "type": "string"
        },
        "delaiInter": {
          "type": "string"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nom": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "nom"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "etapes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "titre": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            },
            "required": [
              "titre",
              "desc"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "tarifs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prestation": {
                "type": "string"
              },
              "prix": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "prestation",
              "prix"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "agrements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "avis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "auteur": {
                "type": "string"
              },
              "note": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "texte": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            },
            "required": [
              "auteur",
              "note",
              "texte"
            ],
            "additionalProperties": false
          }
        },
        "note": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "nbAvis": {
          "type": "number"
        },
        "villesProches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ville": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "ville",
              "slug"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "service",
        "serviceSlug",
        "ville",
        "villeSlug",
        "pubDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}