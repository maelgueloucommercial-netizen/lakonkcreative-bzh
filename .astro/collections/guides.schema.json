{
  "$ref": "#/definitions/guides",
  "definitions": {
    "guides": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "slug": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "modifiedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "author": {
          "type": "string"
        },
        "authorBio": {
          "type": "string"
        },
        "seoScore": {
          "type": "number"
        },
        "keywordVolume": {
          "type": "number"
        },
        "noindex": {
          "type": "boolean"
        },
        "heroImage": {
          "type": "string"
        },
        "heroImageAlt": {
          "type": "string"
        },
        "affiliateDisclosure": {
          "type": "boolean",
          "default": true
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rank": {
                "type": "number"
              },
              "name": {
                "type": "string"
              },
              "brand": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "badge": {
                "type": "string"
              },
              "bestFor": {
                "type": "string"
              },
              "note": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "noteMax": {
                "type": "number",
                "default": 10
              },
              "reviewCount": {
                "type": "number"
              },
              "price": {
                "type": "string"
              },
              "specs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "pros": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cons": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "verdict": {
                "type": "string"
              },
              "ctaUrl": {
                "type": "string"
              },
              "ctaLabel": {
                "type": "string",
                "default": "Voir le prix"
              },
              "merchants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "price": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "url"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "priceLow": {
                "type": "number"
              },
              "priceHigh": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "default": "EUR"
              },
              "reviewUrl": {
                "type": "string"
              },
              "imageAlt": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "verdict": {
          "type": "string"
        },
        "usagePicks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "usage": {
                "type": "string"
              },
              "itemRank": {
                "type": "number"
              }
            },
            "required": [
              "usage",
              "itemRank"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "takeaways": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "relatedGuides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "titre": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            },
            "required": [
              "titre",
              "desc"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "methodology": {
          "type": "string"
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "slug",
        "pubDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}