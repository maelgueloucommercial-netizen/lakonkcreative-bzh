{
  "$ref": "#/definitions/avis",
  "definitions": {
    "avis": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "slug": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "modifiedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "author": {
          "type": "string"
        },
        "authorBio": {
          "type": "string"
        },
        "seoScore": {
          "type": "number"
        },
        "keywordVolume": {
          "type": "number"
        },
        "noindex": {
          "type": "boolean"
        },
        "heroImage": {
          "type": "string"
        },
        "heroImageAlt": {
          "type": "string"
        },
        "affiliateDisclosure": {
          "type": "boolean",
          "default": true
        },
        "brand": {
          "type": "string"
        },
        "brandType": {
          "type": "string",
          "enum": [
            "marque",
            "fabricant",
            "boutique",
            "laboratoire",
            "service",
            "logiciel"
          ],
          "default": "marque"
        },
        "logo": {
          "type": "string"
        },
        "officialUrl": {
          "type": "string"
        },
        "founded": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "reviewCount": {
          "type": "number"
        },
        "ratingBars": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": []
        },
        "verdict": {
          "type": "string"
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "recommande",
            "reserves",
            "eviter"
          ]
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "note": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "note"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "trustVerdict": {
          "type": "string"
        },
        "trustSignals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "topProducts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rank": {
                "type": "number"
              },
              "name": {
                "type": "string"
              },
              "brand": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "badge": {
                "type": "string"
              },
              "bestFor": {
                "type": "string"
              },
              "note": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "noteMax": {
                "type": "number",
                "default": 10
              },
              "reviewCount": {
                "type": "number"
              },
              "price": {
                "type": "string"
              },
              "specs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "pros": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cons": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "verdict": {
                "type": "string"
              },
              "ctaUrl": {
                "type": "string"
              },
              "ctaLabel": {
                "type": "string",
                "default": "Voir le prix"
              },
              "merchants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "price": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "url"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "priceLow": {
                "type": "number"
              },
              "priceHigh": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "default": "EUR"
              },
              "reviewUrl": {
                "type": "string"
              },
              "imageAlt": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "reviewSources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "count": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "note"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "customerReviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "auteur": {
                "type": "string"
              },
              "note": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "texte": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "auteur",
              "note",
              "texte"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "slug",
        "pubDate",
        "brand"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}